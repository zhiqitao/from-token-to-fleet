<!-- Start of: navbar-light-solid-top -->
<!-- Light-mode navbar: opaque #e7e8eb (matches body bg) at the very top so the dark
     announcement bar above doesn't bleed through the glassy navbar. The bg is set in
     CSS so it's present on first paint — no flicker of the glassy state on load. Once
     the user scrolls past 4rem, .is-scrolled is added, the override drops, and the
     designer's glassy bg + blur fades back in. Dark mode is untouched. -->
<!-- Paste in Site Settings → Custom Code → Inside <head> tag -->
<style>
  body.body-ltx-off-white .navbar-ltx.is-new,
  body.cc-light .navbar-ltx.is-new {
    transition: background-color 0.3s ease;
  }

  body.body-ltx-off-white .navbar-ltx.is-new:not(.is-scrolled),
  body.cc-light .navbar-ltx.is-new:not(.is-scrolled) {
    background-color: #e7e8eb !important;
  }
</style>

<script>
  (function () {
    var thresholdRem = 4;

    function init() {
      var body = document.body;
      if (!body || !(body.classList.contains('body-ltx-off-white') || body.classList.contains('cc-light'))) return;

      var rootFontPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      var thresholdPx = thresholdRem * rootFontPx;

      function update() {
        var nav = document.querySelector('.navbar-ltx.is-new');
        if (!nav) return;
        nav.classList.toggle('is-scrolled', window.scrollY >= thresholdPx);
      }

      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
<!-- End of: navbar-light-solid-top -->

<!-- Start of: Splide arrow focus ring -->
<!-- Splide arrows are Webflow divs made focusable by the footer a11y shim. -->
<style>
  .splide__arrows .splide__arrow:focus-visible {
    outline: 2px solid var(--_theme---text) !important;
    outline-offset: 2px !important;
    box-shadow: 0 0 0 2px var(--_theme---text);
  }
</style>
<!-- End of: Splide arrow focus ring -->

<!-- Start of: inverted text selection (new Theme pages + opted-in pages) -->
<style>
  :is(.body-ltx-off-white, [data-selection="invert"]) ::selection {
    background-color: color-mix(in srgb, var(--_theme---text, Highlight) 99%, transparent);
    color: var(--_theme---background, HighlightText);
  }
  :is(.body-ltx-off-white, [data-selection="invert"]) :is(.ltx-but-base, .ltx-but-flex.is-with-icon-full, .rsvp-cta, .prefix-picker button, .section-name-new) {
    -webkit-user-select: none;
    user-select: none;
  }
</style>
<!-- End of: inverted text selection --><!-- Start of: Video CDN Connection Hints -->
<link rel="preconnect" href="https://videos.ltx.studio" crossorigin>
<link rel="dns-prefetch" href="https://videos.ltx.studio">
<!-- End of: Video CDN Connection Hints -->


<!-- Start of Flexible Cards (HEAD): Mobile 80vh Lock + Desktop Layering/Fascade Toggle -->
<style>
  /* =========================================================
     MOBILE/TABLET (<= 991px)
     - Lock card height to 80vh to avoid squishing when wrapper
       heights change or sticky/flex recalculations happen.
     ========================================================= */
  @media (max-width: 991px) {
    .cards-wrap > .card {
      height: 80vh !important;
      max-height: 80vh !important;
    }
  }

  /* =========================================================
     ALL BREAKPOINTS (safe everywhere)
     - Facade hide toggle (JS adds .is-hidden)
     - Deterministic layering (facade above video when visible)
     ========================================================= */

  /* Hide poster facade when active (Flexible Cards section) */
  .cards-wrap > .card .video-facade.is-hidden {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Hide poster facade when active (Capability / Feature Card section) */
  .feature-card-wrap .video-facade.is-hidden {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Keep facade above the video (Flexible Cards section) */
  .cards-wrap > .card .video-facade {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* Keep facade above the video (Capability / Feature Card section) */
  .feature-card-wrap .video-facade {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* Keep video below facade (Flexible Cards section) */
  .cards-wrap > .card video.feature-video-src {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Keep video below facade (Capability / Feature Card section) */
  .feature-card-wrap video.feature-video-src {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* =========================================================
     DESKTOP (>= 992px)
     - Make each card the stacking context so z-index works
     - Do not affect mobile stacking/layout
     ========================================================= */
  @media (min-width: 992px) {
    .cards-wrap > .card {
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }

    /* Ensure feature cards also form a stacking context */
    .feature-card-wrap {
      position: relative;
      overflow: hidden;
      isolation: isolate;
    }
  }
</style>
<!-- End of Flexible Cards (HEAD): Mobile 80vh Lock + Desktop Layering/Fascade Toggle -->




<!-- Start of: Banner + Hero Facade Hide (Publish only) -->
<style>
    /* Hide banner poster facade on published site */
  .video-facade.cc-banner {
    display: none;
  }

  /* Show banner facade only inside Webflow Designer */
  html.w-editor .video-facade.cc-banner {
    display: block;
  }

  /* Hero video should never show a facade (publish + designer) */
  .model-hero-asset .video-facade {
    display: none !important;
  }
</style>
<!-- End of: Banner + Hero Facade Hide (Publish only) --></head><body class="body-ltx-off-white cc-light is-dynamic-text-color"><div data-wf--new-navbar--variant="light" class="navbar-ltx is-new w-variant-73f0ce93-32a3-0f1f-8817-28e4700758ef"><div class="blur-overlay w-embed w-script"><!-- Library-safe selectors: every library class is matched as :is(.name, .ltx--name), because
     Shared Library adds an ltx-- prefix on consumer sites. Embed code is never rewritten by Webflow. -->
<!-- ✅ START: Mega menu global blur overlay -->
<style>
  /* Simple page blur layer:
     - Blur overlay z-index = 50
     - Navbar/menu stay above it
     - Does not touch dropdown inner layout */

  @media (min-width: 992px) {
    .mega-menu-page-blur {
      position: fixed;
      inset: 0;
      opacity: 0;
      pointer-events: none;
      z-index: 90;
      background: rgba(0, 0, 0, 0.32);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity;
    }

    .mega-menu-page-blur.is-active {
      opacity: 1;
    }

    /* Raise only the outer navbar component above the blur layer */
    :is(.navbar-new-component, .ltx--navbar-new-component) {
      position: relative;
      z-index: 100;
    }

    .mega-menu-bottom-border {
      z-index: 101;
    }
  }

  @media (max-width: 991px) {
    .mega-menu-page-blur {
      display: none;
    }
  }
</style>

<script>
  (function () {
    const MENU_SELECTOR = ":is(.navbar5_menu-left, .ltx--navbar5_menu-left)";
    const DESKTOP_QUERY = window.matchMedia("(min-width: 992px)");

    let blurLayer = document.querySelector(".mega-menu-page-blur");

    function createBlurLayer() {
      if (blurLayer) return blurLayer;

      blurLayer = document.createElement("div");
      blurLayer.className = "mega-menu-page-blur";

      if (document.body) {
        document.body.appendChild(blurLayer);
      } else {
        document.addEventListener("DOMContentLoaded", function () {
          document.body.appendChild(blurLayer);
        });
      }

      return blurLayer;
    }

    createBlurLayer();

    document.addEventListener("DOMContentLoaded", function () {
      const menu = document.querySelector(MENU_SELECTOR);

      if (!menu || !blurLayer) return;

      function showBlur() {
        if (!DESKTOP_QUERY.matches) return;
        blurLayer.classList.add("is-active");
      }

      function hideBlur() {
        blurLayer.classList.remove("is-active");
      }

      menu.addEventListener("mouseenter", showBlur);
      menu.addEventListener("mouseleave", hideBlur);

      menu.addEventListener("focusin", showBlur);

      menu.addEventListener("focusout", function () {
        setTimeout(function () {
          if (!menu.contains(document.activeElement)) {
            hideBlur();
          }
        }, 50);
      });

      window.addEventListener("resize", hideBlur);
    });
  })();
</script>
<!-- ✅ END: Mega menu global blur overlay --></div><div class="smooth-menu w-embed w-script"><!-- Library-safe selectors: every library class is matched as :is(.name, .ltx--name), because
     Shared Library adds an ltx-- prefix on consumer sites. Embed code is never rewritten by Webflow. -->
<!-- ✅ START: Native mega menu - underline, hover, smooth height, full-bleed bg, aligned content, chevron -->
<style>
  @media (min-width: 992px) {
