        visibility 0ms linear 0ms;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4).is-height-instant {
      transition: none !important;
    }

    /* ______________________________________________________________
       PART 5 — FULL-WIDTH BOTTOM EDGE
    ______________________________________________________________ */

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4)::after {
      content: "";
      position: absolute;
