    :is(.menu-item-base-new, .ltx--menu-item-base-new)::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -2px;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s ease;
      pointer-events: none;
    }

    :is(.new-navbar-toggle, .ltx--new-navbar-toggle):hover :is(.menu-item-base-new, .ltx--menu-item-base-new)::after,
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle):focus-within :is(.menu-item-base-new, .ltx--menu-item-base-new)::after,
    :is(.menu-item-new, .ltx--menu-item-new):hover :is(.menu-item-base-new, .ltx--menu-item-base-new)::after,
    :is(.menu-item-new, .ltx--menu-item-new):focus-within :is(.menu-item-base-new, .ltx--menu-item-base-new)::after {
      transform: scaleX(1);
    }

    /* ______________________________________________________________
       PART 2 — NAVBAR SURFACE ON MEGA MENU HOVER
    ______________________________________________________________ */

    :is(.navbar-ltx, .ltx--navbar-ltx):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left):hover),
    :is(.navbar-ltx, .ltx--navbar-ltx):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left):focus-within),
    :is(.navbar-ltx, .ltx--navbar-ltx):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left).is-mega-open),
    :is(.navbar-new-component, .ltx--navbar-new-component):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left):hover),
    :is(.navbar-new-component, .ltx--navbar-new-component):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left):focus-within),
    :is(.navbar-new-component, .ltx--navbar-new-component):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left).is-mega-open) {
      background-color: var(--_theme---background, var(--ltx_theme---background)) !important;
      background-image: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }

    /* ______________________________________________________________
       PART 3 — CLEAN OLD BORDER / SHADOW STATES
    ______________________________________________________________ */

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) .navbar5_dropdown-list,
    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) {
      border-bottom: 0 !important;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) .navbar5_dropdown-list {
      box-shadow: none !important;
    }

    .mega-menu-bottom-border {
      display: none !important;
    }

    /* ______________________________________________________________
       PART 4 — DROPDOWN PANEL ALIGNMENT + FULL-BLEED BACKGROUND
       Content starts from the first nav item.
       Background and bottom border bleed to both screen edges.
    ______________________________________________________________ */

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) {
      display: block;
      left: var(--mega-menu-align-left, 0px) !important;
      right: auto !important;
      width: var(--mega-menu-panel-width, auto) !important;
      max-width: none !important;
      box-sizing: border-box !important;
      height: 0;
      overflow: visible;
      clip-path: inset(0 -100vmax 0 -100vmax);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      background-color: var(--_theme---background, var(--ltx_theme---background, #000)) !important;
      box-shadow: 0 0 0 100vmax var(--_theme---background, var(--ltx_theme---background, #000)) !important;
      transition:
        height 520ms cubic-bezier(0.16, 1, 0.3, 1),
        opacity 160ms cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0ms linear 180ms;
      will-change: height, opacity;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown).is-dropdown-active :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) {
      opacity: 1;
