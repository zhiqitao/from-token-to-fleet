    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) .navbar5_dropdown-list::before,
    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4)::before {
