        grid-template-rows 520ms cubic-bezier(0.19, 1, 0.22, 1),
        opacity 160ms ease-out,
        transform 360ms cubic-bezier(0.19, 1, 0.22, 1),
        visibility 0ms linear 0ms;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) > * {
