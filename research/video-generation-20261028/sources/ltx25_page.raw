    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4)::after {
      display: none !important;
    }

    /* ______________________________________________________________
       MOBILE / TABLET CLOSE-STATE BACKGROUND CLEANUP
    ______________________________________________________________ */

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown),
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle),
    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) .navbar5_dropdown-list,
    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4),
    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4).w--open {
      background-image: none !important;
