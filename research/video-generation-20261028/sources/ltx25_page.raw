/* ─────────────────────────────────────────
   COLOR INHERITANCE
───────────────────────────────────────── */

/* Forces all children to inherit parent text color */
.inherit-color * {
  color: inherit;
}


/* ─────────────────────────────────────────
   FOCUS STATE (ACCESSIBILITY)
───────────────────────────────────────── */

/* Keyboard navigation focus ring for focusable elements */
*[tabindex]:focus-visible,
input[type="file"]:focus-visible {
  outline: 0.125rem solid #4d65ff;
  outline-offset: 0.125rem;
}


/* ─────────────────────────────────────────
   RICH TEXT SPACING FIXES
───────────────────────────────────────── */

/* Remove top margin from first element in any rich text block */
.w-richtext > :not(div):first-child,
.w-richtext > div:first-child > :first-child {
  margin-top: 0 !important;
}

/* Remove bottom margin from last element in any rich text block */
.w-richtext > :last-child,
.w-richtext ol li:last-child,
.w-richtext ul li:last-child {
  margin-bottom: 0 !important;
}


/* ─────────────────────────────────────────
   POINTER EVENTS
───────────────────────────────────────── */

.pointer-events-off {
  pointer-events: none;
}

.pointer-events-on {
  pointer-events: auto;
}


/* ─────────────────────────────────────────
   LAYOUT UTILITIES
───────────────────────────────────────── */

/* Forces a div to maintain a 1:1 square ratio */
.div-square::after {
  content: "";
  display: block;
  padding-bottom: 100%;
}

/* Keeps containers centered regardless of parent styles */
.container-medium,
.container-small,
.container-large {
  margin-right: auto !important;
  margin-left: auto !important;
}

/* Inline flex shorthand */
.display-inlineflex {
  display: inline-flex;
}


/* ─────────────────────────────────────────
   VISIBILITY / HIDE UTILITIES
───────────────────────────────────────── */

.hide {
  display: none !important;
}

@media screen and (max-width: 991px) {
  .hide,
  .hide-tablet {
    display: none !important;
  }
}

@media screen and (max-width: 767px) {
  .hide-mobile-landscape {
    display: none !important;
  }
}

@media screen and (max-width: 479px) {
  .hide-mobile {
    display: none !important;
  }
}


/* ─────────────────────────────────────────
   TEXT TRUNCATION
───────────────────────────────────────── */

/* Legacy Webflow truncation classes — kept for reference, check usage before deleting */
/*
.text-style-3lines {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.text-style-2lines {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
*/

/* Truncate to N lines with ellipsis */
.text-truncate-4 {
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-truncate-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-truncate-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* truncate-3 reduces to 2 lines on mobile */
@media (max-width: 767px) {
  .text-truncate-3 {
    -webkit-line-clamp: 2;
  }
}

/* Single-line ellipsis at 100% width */
.truncate-width {
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


/* ─────────────────────────────────────────
   SPACING RESET UTILITIES
───────────────────────────────────────── */

.margin-0    { margin: 0rem !important; }
.padding-0   { padding: 0rem !important; }

.spacing-clean {
  padding: 0rem !important;
  margin: 0rem !important;
}

/* Zero out all sides except the named one */
.margin-top        { margin-right: 0rem !important; margin-bottom: 0rem !important; margin-left: 0rem !important; }
.margin-right      { margin-top: 0rem !important;   margin-bottom: 0rem !important; margin-left: 0rem !important; }
.margin-bottom     { margin-top: 0rem !important;   margin-right: 0rem !important;  margin-left: 0rem !important; }
.margin-left       { margin-top: 0rem !important;   margin-right: 0rem !important;  margin-bottom: 0rem !important; }
.margin-horizontal { margin-top: 0rem !important;   margin-bottom: 0rem !important; }
.margin-vertical   { margin-right: 0rem !important; margin-left: 0rem !important; }

.padding-top        { padding-right: 0rem !important; padding-bottom: 0rem !important; padding-left: 0rem !important; }
.padding-right      { padding-top: 0rem !important;   padding-bottom: 0rem !important; padding-left: 0rem !important; }
.padding-bottom     { padding-top: 0rem !important;   padding-right: 0rem !important;  padding-left: 0rem !important; }
.padding-left       { padding-top: 0rem !important;   padding-right: 0rem !important;  padding-bottom: 0rem !important; }
.padding-horizontal { padding-top: 0rem !important;   padding-bottom: 0rem !important; }
.padding-vertical   { padding-right: 0rem !important; padding-left: 0rem !important; }


/* ─────────────────────────────────────────
   SCROLLBAR
───────────────────────────────────────── */

/* Hides scrollbar across browsers while keeping scroll functionality */
.no-scrollbar {
  -ms-overflow-style: none;
  overflow: -moz-scrollbars-none;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}


/* ─────────────────────────────────────────
   FORM ELEMENTS
───────────────────────────────────────── */

/* Removes native browser styling from select dropdowns */
.w-select {
  -webkit-appearance: none !important;
  -moz-appearance: none !important;
}


/* ─────────────────────────────────────────
   FONT SMOOTHING
───────────────────────────────────────── */

body {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}


/* ─────────────────────────────────────────
   ASPECT RATIO UTILITIES
───────────────────────────────────────── */

.ratio-1-1        { aspect-ratio: 1 / 1; }
.ratio-5-4        { aspect-ratio: 5 / 4; }
.ratio-4-5        { aspect-ratio: 4 / 5; }
.ratio-16-9       { aspect-ratio: 16 / 9; }
.ratio-9-16       { aspect-ratio: 1 / 1.78; }
.ratio-device-9-16 { aspect-ratio: 1 / 1.78; }


/* ─────────────────────────────────────────
   INLINE LINK — ANIMATED UNDERLINE
   Underline visible by default, retracts on hover, redraws on mouse-out.
   Color strictly inherits from parent text.
───────────────────────────────────────── */

.inline-draw-underline {
  position: relative;
  color: inherit;
  text-decoration: none;
}

.inline-draw-underline::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2px;
  height: 1px;
  background: currentColor;
  transform: scaleX(1);
  transform-origin: left;
  transition: transform 0.3s ease;
  pointer-events: none;
}

.inline-draw-underline:hover::after,
.inline-draw-underline:focus::after {
  transform: scaleX(0);
  transform-origin: right;
}

</style>
