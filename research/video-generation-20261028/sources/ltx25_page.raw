<style>
  /* Smooth footer accordion for tablet + mobile only. Desktop 992px+ is untouched. */

  @media screen and (max-width: 991px) {
    .footer-section .link-header-wrapper {
      cursor: pointer;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .footer-section .footer-links-list-wrap {
      display: block !important;
      position: static !important;
      height: 0;
      overflow: hidden !important;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: none !important;
      transition:
        height 0.72s cubic-bezier(0.19, 1, 0.22, 1),
        opacity 0.32s ease,
        visibility 0s linear 0.72s;
      will-change: height, opacity;
    }

    .footer-section .footer-links-wrapper.is-footer-open > .footer-links-list-wrap {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition:
        height 0.72s cubic-bezier(0.19, 1, 0.22, 1),
        opacity 0.32s ease 0.06s,
        visibility 0s linear 0s;
    }

    /* Footer-specific chevron animation.
       Targets .chevron-new only inside the footer, so menu chevrons stay untouched. */
    .footer-section .footer-arrow-wrapper .chevron-new {
      transform: rotate(0deg);
      transform-origin: center;
      transition: transform 0.95s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }

    .footer-section .footer-links-wrapper.is-footer-open .footer-arrow-wrapper .chevron-new {
      transform: rotate(180deg);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    /* Accordion applies only on tablet + mobile. Desktop is not touched. */

    const breakpoint = 991;
    const footer = document.querySelector('.footer-section');
    if (!footer) return;

    const wrappers = Array.from(footer.querySelectorAll('.footer-links-wrapper'));

    function isAccordionViewport() {
      return window.innerWidth <= breakpoint;
    }

    function getTrigger(wrapper) {
      return wrapper.querySelector('.link-header-wrapper');
    }

    function getPanel(wrapper) {
      return wrapper.querySelector('.footer-links-list-wrap');
    }

    function closeItem(wrapper) {
      const trigger = getTrigger(wrapper);
      const panel = getPanel(wrapper);
      if (!panel) return;

      wrapper.classList.remove('is-footer-open');

      if (trigger) {
        trigger.setAttribute('aria-expanded', 'false');
      }

      /* Start from current real height, then collapse to 0. */
      const currentHeight = panel.scrollHeight;
      panel.style.height = `${currentHeight}px`;

      requestAnimationFrame(() => {
        panel.style.height = '0px';
      });
    }

    function openItem(wrapper) {
      const trigger = getTrigger(wrapper);
      const panel = getPanel(wrapper);
      if (!panel) return;

      /* Only one item can stay open. */
      wrappers.forEach((item) => {
        if (item !== wrapper) closeItem(item);
      });

      wrapper.classList.add('is-footer-open');

      if (trigger) {
        trigger.setAttribute('aria-expanded', 'true');
      }

      /* Open downward by animating actual layout height. */
      panel.style.height = '0px';

      requestAnimationFrame(() => {
        panel.style.height = `${panel.scrollHeight}px`;
      });

      panel.addEventListener('transitionend', function onEnd(event) {
        if (event.propertyName !== 'height') return;
        panel.removeEventListener('transitionend', onEnd);

        if (wrapper.classList.contains('is-footer-open')) {
          panel.style.height = 'auto';
        }
      });
    }

    function toggleItem(wrapper) {
      if (!isAccordionViewport()) return;

      if (wrapper.classList.contains('is-footer-open')) {
        closeItem(wrapper);
      } else {
        openItem(wrapper);
      }
    }

    function setupAccordion() {
      wrappers.forEach((wrapper) => {
        const trigger = getTrigger(wrapper);
        const panel = getPanel(wrapper);

        if (!trigger || !panel) return;

        wrapper.classList.remove('is-footer-open');
        panel.style.height = '0px';

        trigger.setAttribute('role', 'button');
        trigger.setAttribute('tabindex', '0');
        trigger.setAttribute('aria-expanded', 'false');
      });
    }

    function cleanupDesktop() {
      wrappers.forEach((wrapper) => {
        const trigger = getTrigger(wrapper);
        const panel = getPanel(wrapper);

        wrapper.classList.remove('is-footer-open');

        if (panel) {
          panel.style.height = '';
        }

        if (trigger) {
          trigger.removeAttribute('role');
          trigger.removeAttribute('tabindex');
          trigger.removeAttribute('aria-expanded');
        }
      });
    }

    footer.addEventListener('click', (event) => {
      if (!isAccordionViewport()) return;

      const trigger = event.target.closest('.link-header-wrapper');
      if (!trigger || !footer.contains(trigger)) return;

      const wrapper = trigger.closest('.footer-links-wrapper');
      if (!wrapper) return;

      event.preventDefault();
      toggleItem(wrapper);
    });

    footer.addEventListener('keydown', (event) => {
      if (!isAccordionViewport()) return;
      if (event.key !== 'Enter' && event.key !== ' ') return;

      const trigger = event.target.closest('.link-header-wrapper');
      if (!trigger || !footer.contains(trigger)) return;

      const wrapper = trigger.closest('.footer-links-wrapper');
      if (!wrapper) return;

      event.preventDefault();
      toggleItem(wrapper);
    });

    function handleViewport() {
      if (isAccordionViewport()) {
        setupAccordion();
      } else {
        cleanupDesktop();
      }
    }

    handleViewport();

    window.addEventListener('resize', () => {
      requestAnimationFrame(() => {
        if (!isAccordionViewport()) {
          cleanupDesktop();
          return;
        }

        const openWrapper = footer.querySelector('.footer-links-wrapper.is-footer-open');
        const openPanel = openWrapper ? getPanel(openWrapper) : null;

        if (openPanel && openPanel.style.height !== 'auto') {
          openPanel.style.height = `${openPanel.scrollHeight}px`;
        }
      });
    });
  });
</script>
<!-- ✅ END: Footer mobile/tablet accordion smooth --></div></div></div><div id="w-node-_6cd55500-3e37-4849-ba9f-fbfcb03bfc67-03b795c5" class="footer-copyright"><ul role="list" class="footer-links-list-hor w-list-unstyled"><li class="footer-link-item is-secondary"><a href="https://static.lightricks.com/legal/Privacy%20Policy%20-%20LTX%20Platform.pdf" target="_blank" class="ltx-footer-link is-secondary a-cta">Privacy Policy</a><link rel="prefetch" href="https://static.lightricks.com/legal/Privacy%20Policy%20-%20LTX%20Platform.pdf"/></li><li class="footer-link-item is-secondary"><a id="cookie-banner-btn" href="#" class="ltx-footer-link is-secondary">Cookie Preferences</a></li><li class="footer-link-item is-secondary"><a href="https://trust.ltx.io/" target="_blank" class="ltx-footer-link is-secondary a-cta">Trust Center</a><link rel="prefetch" href="https://trust.ltx.io/"/></li><li class="footer-link-item is-secondary"><a id="accessibility-widget-btn" href="https://static.lightricks.com/legal/CPRA%20Notice%20-%20UPLOADED.pdf" target="_blank" class="ltx-footer-link is-secondary a-cta">Accessibility</a><link rel="prefetch" href="https://static.lightricks.com/legal/CPRA%20Notice%20-%20UPLOADED.pdf"/></li><li class="footer-link-item is-secondary"><a href="https://static.lightricks.com/legal/CPRA%20Notice%20-%20UPLOADED.pdf" target="_blank" class="ltx-footer-link is-secondary a-cta">CCPA Privacy notice</a><link rel="prefetch" href="https://static.lightricks.com/legal/CPRA%20Notice%20-%20UPLOADED.pdf"/></li></ul><div class="copyright">© 2026 All rights reserved</div></div></div></section></div><div class="theme-reference-wrapper"><div data-theme-vars="" class="theme-ref-base"></div><div class="theme-ref-light"></div></div><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=68872d15af29880764eac4aa" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://c