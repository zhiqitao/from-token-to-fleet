    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown).is-dropdown-active :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4)::after {
      opacity: 1;
    }

    /* ______________________________________________________________
       PART 6 — HOVER BRIDGE
       Disabled as CSS layer to avoid hidden blocking areas.
