<script>
// <!-- Start of: Splide arrow a11y -->
// Fixes Lighthouse aria-prohibited-attr. -->
(function () {
  function initArrowA11y() {
    document.querySelectorAll(".splide__arrow").forEach(function (arrow) {
      if (arrow.tagName === "BUTTON") return; // Splide-generated arrows are already valid
      if (arrow.dataset.a11yBound === "true") return;
      arrow.dataset.a11yBound = "true";
      arrow.setAttribute("role", "button");
      if (!arrow.hasAttribute("tabindex")) arrow.setAttribute("tabindex", "0");
      arrow.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " " || e.key === "Spacebar") {
          e.preventDefault(); // stop Space from scrolling the page
          arrow.click();
        }
      });
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initArrowA11y);
  } else {
    initArrowA11y();
  }
  window.Webflow = window.Webflow || [];
  window.Webflow.push(initArrowA11y);
})();
// <!-- End of: Splide arrow a11y -->
</script><!-- ✅✅✅ Start of: Blur-fade-in (blur → sharp) on scroll -->
<script>
document.addEventListener("DOMContentLoaded", () => {
  // Safety check
  if (!window.gsap || !window.ScrollTrigger) return;

  gsap.registerPlugin(ScrollTrigger);

  /* CONFIG */

  const BLUR_FROM_PX = 16;           // Initial blur amount
  const DURATION_S  = 0.5;           // Animation duration
  const EASE        = "power3.out";    // Smooth premium easing
  const START_POINT = "top 80%";     // Start 80% from top of viewport

  // Play + reverse on scroll up
  const TOGGLE_ACTIONS_MODE = "play none none reverse";

  /* =========================
     APPLY TO ALL .blur-fade-in
  ========================== */

  gsap.utils.toArray(".blur-in").forEach((el) => {
    gsap.fromTo(
      el,
      {
        filter: `blur(${BLUR_FROM_PX}px)`
      },
      {
        filter: "blur(0px)",
        duration: DURATION_S,
        ease: EASE,
        scrollTrigger: {
          trigger: el,
          start: START_POINT,
          toggleActions: TOGGLE_ACTIONS_MODE
        }
      }
    );
  });
});
</script>
<!-- ✅✅✅ End of: Blur-fade-in (blur → sharp) on scroll -->



<!-- Start of: Flexible Videos (BODY): Desktop Hover Cards + Global IO Lazy-Load (Banner + Mobile) -->
<script>
;(function(){
  "use strict";

  /* =========================================================
     CONFIG
     ========================================================= */
  const BP_DESKTOP = 992;
  const rootMargin = "300px 0px";
  const threshold  = 0;

  const isDesktopBp = matchMedia(`(min-width:${BP_DESKTOP}px)`).matches;
  const $all = (sel, ctx=document) => Array.from(ctx.querySelectorAll(sel));
  const VIDEO_SEL = "video.feature-video-src";

  /* =========================================================
     HELPERS
     ========================================================= */
  function ensureInlineAutoplay(video){
    if (!video) return;
    video.muted = true;
    video.loop = true;
    video.playsInline = true;
    video.setAttribute("muted","");
    video.setAttribute("playsinline","");
    video.setAttribute("webkit-playsinline","");
  }

  /* Finds the reusable “video module” wrapper that owns facade + video */
  function getModuleWrap(video){
    if (!video) return null;
    return video.closest(".flexible-card-wrap, .feature-card-wrap, .card") || null;
  }

  function getFacade(video){
    const wrap = getModuleWrap(video);
    if (!wrap) return null;
    return wrap.querySelector(".video-facade") || null;
  }

  function showFacade(video){
    const facade = getFacade(video);
    if (facade) facade.classList.remove("is-hidden");
  }

  function hideFacadeOnFrame(video){
    const facade = getFacade(video);
    if (!video || !facade) return;

    // If already has enough data to paint, hide immediately
    if (video.readyState >= 2) {
      facade.classList.add("is-hidden");
      return;
    }

    video.addEventListener("loadeddata", () => {
      facade.classList.add("is-hidden");
    }, { once:true });
  }

  /* Wire <source data-src / data-src-mobile> into real src attributes */
  function wireSources(video, preferMobile){
    if (!video || video.dataset.loaded) return;

    const sources = video.querySelectorAll("source");
    if (!sources.length) return;

    let wiredAny = false;

    sources.forEach(s=>{
      const ms  = s.dataset.srcMobile;
      const ds  = s.dataset.src;
      const url = (preferMobile && ms) ? ms : ds;

      // Skip empty entries (supports MP4-only assets cleanly)
      if (!url) return;

      s.src = url;
      wiredAny = true;
    });

    if (!wiredAny) return;

    video.dataset.loaded = "true";
    try { video.load(); } catch {}
  }

  function stop(video){
    if (!video) return;
    try { video.pause(); } catch {}
    try { video.currentTime = 0; } catch {}
  }

  function unload(video){
    if (!video) return;

    try { video.pause(); video.currentTime = 0; } catch {}

    // Remove wired sources
    video.querySelectorAll("source").forEach(s => s.removeAttribute("src"));
    video.removeAttribute("src");

    try { video.load(); } catch {}

    delete video.dataset.loaded;
  }

  function playSafe(video){
    if (!video) return;
    ensureInlineAutoplay(video);
    try { video.play().catch(()=>{}); } catch {}
  }

  /* =========================================================
     DESKTOP: Hover cards (4 cards inside .cards-wrap)
     - Keeps your “hover-to-activate” behavior
     - Does NOT rely on IntersectionObserver for these
     ========================================================= */
  function initDesktopHoverCards(){
    const wrap = document.querySelector(".cards-wrap");
    if (!wrap) return;

    const cards = $all(":scope > .card", wrap).slice(0,4);
    if (cards.length !== 4) return;

    const getVideo = (card) => card.querySelector(VIDEO_SEL);

    async function activate(index){
      for (let i=0; i<cards.length; i++){
        const card = cards[i];
        const v = getVideo(card);
        const active = i === index;

        if (!v) continue;

        if (active) {
          wireSources(v, false);      // desktop sources
          hideFacadeOnFrame(v);       // hides .video-facade when first frame is ready
          try { v.currentTime = 0; } catch {}
          playSafe(v);
        } else {
          stop(v);
          showFacade(v);
        }
      }
    }

    // Default first
    activate(0);

    // Hover/focus
    cards.forEach((card,i)=>{
      card.addEventListener("mouseenter", ()=>activate(i));
      card.addEventListener("focusin",   ()=>activate(i));
    });

    // Leave => back to first
    wrap.addEventListener("mouseleave", ()=>activate(0));
    wrap.addEventListener("focusout", (e)=>{
      if (!wrap.contains(e.relatedTarget)) activate(0);
    });
  }

  /* =========================================================
     GLOBAL IO: Banner + Mobile/Tablet + Any non-hover videos
     - On mobile/tablet: controls ALL videos
     - On desktop: controls videos NOT inside .cards-wrap
       (so hover cards are not interfered with)
     ========================================================= */
  function initGlobalIO(){
    // On desktop, exclude hover-card videos to avoid conflicts
    const videos = isDesktopBp
      ? $all(VIDEO_SEL).filter(v => !v.closest(".cards-wrap"))
      : $all(VIDEO_SEL);

    if (!videos.length) return;

    const io = new IntersectionObserver((entries)=>{
      entries.forEach(entry=>{
        const v = entry.target;

        if (entry.isIntersecting) {
          // Mobile prefers mobile sources; desktop uses desktop sources
          wireSources(v, !isDesktopBp);

          // If a facade exists (cards), hide on first frame.
          // Banner facade is hidden via CSS on publish anyway; this is safe.
          hideFacadeOnFrame(v);

          playSafe(v);
        } else if (v.dataset.loaded) {
          // Performance-first: unload when out of view
          unload(v);

          // Restore facade if it exists (cards)
          showFacade(v);
        }
      });
    }, { root:null, rootMargin, threshold });

    videos.forEach(v => io.observe(v));
  }

  /* =========================================================
     INIT
     ========================================================= */
  document.addEventListener("DOMContentLoaded", ()=>{
    if (isDesktopBp) initDesktopHoverCards();
    initGlobalIO();
  });

})();
</script>
<!-- End of: Flexible Videos (BODY): Desktop Hover Cards + Global IO Lazy-Load (Banner + Mobile) -->




<!-- /* play-pause and mute-unmute control */ -->
<script>
document.addEventListener("DOMContentLoaded", () => {

  const cards = document.querySelectorAll(".feature-card-wrap.with-video-controls");

  cards.forEach(card => {
    const video = card.querySelector("video.feature-video-src");
    if (!video) return;

    // default: autoplay muted (safe). If you don't want autoplay on some, remove these 2 lines.
    video.muted = true;
    video.playsInline = true;
    video.setAttribute("playsinline", "");
    video.play().catch(()=>{});

    const show = el => el && (el.style.display = "block");
    const hide = el => el && (el.style.display = "none");

    /* ----------------------------
       PLAY / PAUSE (independent)
    ---------------------------- */
    const playWrap = card.querySelector(".play-button_wrapper");
    let playIcon = null;
    let pauseIcon = null;

    if (playWrap) {
      // preferred classes
      playIcon  = playWrap.querySelector(".play");
      pauseIcon = playWrap.querySelector(".pause");

      // fallback if playWrap contains 2 elements but classes are wrong
      if (!playIcon || !pauseIcon) {
        const candidates = playWrap.querySelectorAll("img, svg, div");
        playIcon  = playIcon  || candidates[0];
        pauseIcon = pauseIcon || candidates[1];
      }

      const syncPlayUI = () => {
        if (!playIcon || !pauseIcon) return;
        if (video.paused || video.ended) { show(playIcon); hide(pauseIcon); }
        else { hide(playIcon); show(pauseIcon); }
      };

      syncPlayUI();
      video.addEventListener("play", syncPlayUI);
      video.addEventListener("pause", syncPlayUI);
      video.addEventListener("ended", syncPlayUI);

      playIcon && playIcon.addEventListener("click", (e) => {
        e.preventDefault(); e.stopPropagation();
        video.play().catch(()=>{});
      });

      pauseIcon && pauseIcon.addEventListener("click", (e) => {
        e.preventDefault(); e.stopPropagation();
        video.pause();
      });
    }

    /* ----------------------------
       SOUND (optional)
    ---------------------------- */
    const soundWrap = card.querySelector(".sound-button_wrapper");
    if (soundWrap) {
      const soundOn   = soundWrap.querySelector(".sound-on");
      const soundMute = soundWrap.querySelector(".sound-mute");
      if (!soundOn || !soundMute) return;

      const syncSoundUI = () => {
        if (video.muted) { hide(soundOn); show(soundMute); }
        else { show(soundOn); hide(soundMute); }
      };

      syncSoundUI();
      video.addEventListener("volumechange", syncSoundUI);

      soundMute.addEventListener("click", (e) => {
        e.preventDefault(); e.stopPropagation();
        video.muted = false;
        syncSoundUI();
        video.play().catch(()=>{});
      });

      soundOn.addEventListener("click", (e) => {
        e.preventDefault(); e.stopPropagation();
        video.muted = true;
        syncSoundUI();
      });
    }

  });

});
</script>


<!-- Start Hero Facade JS -->
<!--
<script>
document.addEventListener("DOMContentLoaded", () => {
  const video = document.querySelector(".hero-video");
  const facade = document.querySelector(".hero-video-wrap .video-facade");
  if (!video) return;

  // Pick MP4 for mobile or desktop
  const isMobile = !window.matchMedia("(hover:hover) and (pointer:fine)").matches;
  const src = isMobile ? video.dataset.srcMobile : video.dataset.src;
  if (!src) return;

  video.src = src;
  video.load();
  video.play().catch(()=>{});

  // Once video has enough to show a frame, hide poster
  video.addEventListener("loadeddata", () => {
    facade && facade.classList.add("is-hidden");
  }, { once: true });
});
</script>
<!-- End Hero Facade JS -->




<!-- ────────────────────────────────────────
Updated LTX Hero + Facade Lazy-Load JS
──────────────────────────────────────── -->
<script>
;(function(){
  "use strict";

  const rootMargin = "300px 0px",
        threshold  = 0,
        isDesktop  = matchMedia("(hover:hover) and (pointer:fine)").matches,
        $all       = (sel, ctx=document) => Array.from(ctx.querySelectorAll(sel));

  // Only used if <video> has data-src / data-src-mobile itself
  function chooseSrc(video){
    return (!isDesktop && video.dataset.srcMobile)
      ? video.dataset.srcMobile
      : video.dataset.src;
  }

  function unload(video){
    try { video.pause(); video.currentTime = 0; } catch {}
    video.querySelectorAll("source").forEach(s => s.removeAttribute("src"));
    video.removeAttribute("src");
    try { video.load(); } catch {}
    video.classList.remove("is-ready");
    delete video.dataset.loaded;
  }

  function loadAndPlay(video, facade){
    if (video.dataset.loaded) return;

    // 1) If there are <source> tags, wire them up; otherwise use chooseSrc
    const sources = video.querySelectorAll("source");
    if (sources.length) {
      sources.forEach(s => {
        // pick mobile or desktop per source’s own data attributes
        const ms = s.dataset.srcMobile,
              ds = s.dataset.src;
        s.src = (!isDesktop && ms) ? ms : (ds || "");
      });
      video.load();
    } else {
      // fallback when you didn’t use <source>
      const src = chooseSrc(video);
      if (!src) return;
      video.src = src;
    }

    // 2) Mark as loaded & hide the facade immediately
    video.dataset.loaded = "true";
    facade && facade.classList.add("is-hidden");
    video.classList.add("is-ready");

    // 3) Autoplay
    video.play().catch(()=>{});
  }

  document.addEventListener("DOMContentLoaded",()=>{
    // Hero: immediate load/play (unchanged)
    $all(".hero-video").forEach(v=>{
      // If hero uses <source>, this will skip chooseSrc and use the source branch
      loadAndPlay(v /* facade is not used for hero */);
    });

    // Cards: lazy-load & unload on mobile/tablet
    const io = new IntersectionObserver(entries=>{
      entries.forEach(entry=>{
        const v      = entry.target,
              wrap   = v.closest(".feature-card-wrap"),
              facade = wrap && wrap.querySelector(".video-facade");

        if (entry.isIntersecting) {
          loadAndPlay(v, facade);
        } else if (v.dataset.loaded && !isDesktop) {
          unload(v);
        }
      });
    }, { root:null, rootMargin, threshold });

    $all("video.feature-video-src").forEach(v=> io.observe(v));
  });
})();
</script>
<!-- ────────────────────────────────────────
End Updated LTX Hero + Facade Lazy-Load JS 
──────────────────────────────────────── -->


<!-- ────────────────────────────────────────
Start of: layout grid 
──────────────────────────────────────── -->
<script src="https://cdn.prod.website-files.com/gsap/3.15.0/Flip.min.js"></script>
<script>
  gsap.registerPlugin(Flip);

function initGridLayoutFlip() {
  const groups = document.querySelectorAll("[data-layout-group]");
  const ACTIVE_CLASS = "is--active"; // The classes toggled on your buttons

  groups.forEach((group) => {
    let activeTween = null;

    const buttons = group.querySelectorAll("[data-layout-button]");
    const grid = group.querySelector("[data-layout-grid]");
    const collection = group.querySelector("[data-layout-grid-collection]");
    if (!buttons.length || !grid || !collection) {
      console.warn("Missing required HTML elements. Check the Osmo resoure documentation!");
      return;
    }

    // a11y init
    buttons.forEach((b) =>
      b.setAttribute("aria-pressed", String(b.classList.contains(ACTIVE_CLASS)))
    );

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetLayout = btn.getAttribute("data-layout-button"); // "large" | "small"
        const currentLayout = group.getAttribute("data-layout-status");
        if (currentLayout === targetLayout) return;

        // Kill any in-flight animation
        if (activeTween) { activeTween.kill(); activeTween = null; }

        // Reduced-motion: just toggle and refresh
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          group.setAttribute("data-layout-status", targetLayout);
          buttons.forEach((b) => {
            const isActive = b === btn;
            b.classList.toggle(ACTIVE_CLASS, isActive);
            b.setAttribute("aria-pressed", String(isActive));
          });
          window.ScrollTrigger?.refresh?.();
          if (window.lenis?.resize) window.lenis.resize();
          return;
        }

        // Record state of items
        const items = grid.querySelectorAll("[data-layout-grid-item]");
        const state = Flip.getState(items, { simple: true });

        // Measure current height on the collection (force layout first)
        collection.getBoundingClientRect();
        const prevH = collection.offsetHeight;

        // Switch to target layout
        group.setAttribute("data-layout-status", targetLayout);
        buttons.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle(ACTIVE_CLASS, isActive);
          b.setAttribute("aria-pressed", String(isActive));
        });

        // Measure next height after switching
        collection.getBoundingClientRect();
        const nextH = collection.offsetHeight;

        // Pin collection height so items can go absolute without collapsing
        gsap.set(collection, { height: prevH });

        // Build timeline: Flip + collection height animation
        const tl = gsap.timeline({
          onStart: () => {
            group.setAttribute("data-transitioning", "true");
          },
          onInterrupt: () => {
            group.removeAttribute("data-transitioning");
            gsap.set(collection, { clearProps: "height" });
          },
          onComplete: () => {
            group.removeAttribute("data-transitioning");
            gsap.set(collection, { clearProps: "height" });
            window.ScrollTrigger?.refresh?.();
            if (window.lenis?.resize) window.lenis.resize();
            activeTween = null;
          }
        });

        tl
        .add(Flip.from(state, {
          duration: 0.65,
          ease: "power4.inOut",
          absolute: true,
          nested: true,
          prune: true,
          stagger: targetLayout === "large"
            ? { each: 0.03, from: "end" }
            : { each: 0.03, from: "start" }
        }), 0)
        .to(collection,{ 
          height: nextH,
          duration: 0.65,
          ease: "power4.inOut"
        }, 0);

        activeTween = tl;
      });
    });
  });
}

// Initialize Layout Grid Flip
document.addEventListener('DOMContentLoaded', () => {
  initGridLayoutFlip();
});
</script>


<script>
  function initGridHoverFocus() {
  const mq = window.matchMedia("(min-width: 992px) and (hover: hover)");

  document.querySelectorAll("[data-layout-group]").forEach((group) => {
    const list = group.querySelector("[data-layout-grid-list]");
    if (!list) return;

    // Only videos the lazy-loader has already hydrated
    const liveVideos = () =>
      [...list.querySelectorAll(".video-container video")].filter(
        (v) => v.currentSrc && !v.hasAttribute("data-manual-pause")
      );

    const safePlay = (v) => {
      const p = v.play();
      if (p && p.catch) p.catch(() => {});
    };

    const focusCard = (card) => {
      const item = card.closest("[data-layout-grid-item]");
      if (!item) return;

      list.setAttribute("data-hover-active", "");
      list.querySelectorAll("[data-hover-current]").forEach((el) =>
        el.removeAttribute("data-hover-current")
      );
      item.setAttribute("data-hover-current", "");

      const keep = new Set(card.querySelectorAll(".video-container video"));
      liveVideos().forEach((v) => (keep.has(v) ? safePlay(v) : v.pause()));
    };

    const reset = () => {
      list.removeAttribute("data-hover-active");
      list.querySelectorAll("[data-hover-current]").forEach((el) =>
        el.removeAttribute("data-hover-current")
      );
      liveVideos().forEach(safePlay);
    };

    list.addEventListener("mouseover", (e) => {
      if (!mq.matches || group.hasAttribute("data-transitioning")) return;
      const card = e.target.closest(".layout-grid__card");
      if (!card || !list.contains(card)) return;
      if (card.closest("[data-layout-grid-item]")?.hasAttribute("data-hover-current")) return;
      focusCard(card);
    });

    list.addEventListener("mouseleave", () => mq.matches && reset());
    mq.addEventListener("change", (e) => !e.matches && reset());
  });
}

document.addEventListener("DOMContentLoaded", initGridHoverFocus);
</script></body></html>