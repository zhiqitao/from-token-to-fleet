    :is(.navbar5_menu-left, .ltx--navbar5_menu-left).is-mega-open > :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown).is-dropdown-active :is(.menu-item-main, .ltx--menu-item-main) {
