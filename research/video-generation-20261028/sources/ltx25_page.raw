    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) :is(.chevron-new, .ltx--chevron-new),
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) :is(.chevron-new, .ltx--chevron-new) svg,
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) svg,
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) .w-icon-dropdown-toggle {
