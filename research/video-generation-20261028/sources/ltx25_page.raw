    left: 0;
    right: 0;
    bottom: -4px;              /* distance from text */
    height: 1px;
    background: currentColor;  /* inherit text color */
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
    pointer-events: none;
  }

  /* 🔹 Hover the WHOLE button container */
  .ltx-but-flex:hover .text-link-inside-but::after,
  .ltx-but-flex:focus-within .text-link-inside-but::after {
    transform: scaleX(1);
  }
</style>
