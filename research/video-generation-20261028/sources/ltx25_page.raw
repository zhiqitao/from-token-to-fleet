    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown).w--open :is(.new-navbar-toggle, .ltx--new-navbar-toggle) :is(.chevron-new, .ltx--chevron-new),
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle).w--open :is(.chevron-new, .ltx--chevron-new) {
      transform: rotate(180deg);
    }
  }

  /* Library consumer fix: Shared Library compiles the ltx-but-base > is-small > is-black chain
     as single-class .ltx--is-black rules, so the hard-coded black one wins on dark pages.
     Restores the .io behaviour (theme-variable colours). Only matches prefixed classes,
     so it does nothing on the library source site. */
  .ltx--ltx-but-base.ltx--is-small.ltx--is-black {
    border-color: var(--ltx_theme---full-button--full-but-border);
    background-color: var(--ltx_theme---full-button--full-but-bg);
    color: var(--ltx_theme---background);
  }
</style>

<script>
  (function () {
    /* ______________________________________________________________
       PART 1 — CONFIG
    ______________________________________________________________ */

    const MENU_SELECTOR = ":is(.navbar5_menu-left, .ltx--navbar5_menu-left)";
    const DROPDOWN_SELECTOR = ":is(.navbar5_menu-left, .ltx--navbar5_menu-left) > :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown)";
    const TOGGLE_SELECTOR = ":is(.new-navbar-toggle, .ltx--new-navbar-toggle)";
    const LIST_SELECTOR = ":is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4)";
    const DESKTOP_QUERY = window.matchMedia("(min-width: 992px)");

    document.addEventListener("DOMContentLoaded", function () {
      const menu = document.querySelector(MENU_SELECTOR);
      const dropdowns = Array.from(document.querySelectorAll(DROPDOWN_SELECTOR));

      if (!menu || !dropdowns.length) return;

      document.querySelectorAll(".mega-menu-visual-bg, .mega-menu-panel-bg").forEach(function (el) {
        el.remove();
      });

      let activeDropdown = null;
      let isMenuOpen = false;
      let closeTimer = null;
      let switchTimer = null;
      let resizeTimer = null;
      let currentMenuHeight = 0;
      let isCloseTracking = false;

      const CLOSE_DELAY_FAST = 80;
      const CLOSE_DELAY_BRIDGE = 260;
      const SWITCH_CLASS_CLEAR_DELAY = 180;
      const RESIZE_RESET_DELAY = 90;

      /* ______________________________________________________________
         PART 2 — UTILITIES
      ______________________________________________________________ */

      function isDesktop() {
        return DESKTOP_QUERY.matches;
      }

      function getList(dropdown) {
        return dropdown ? dropdown.querySelector(LIST_SELECTOR) : null;
      }

      function getToggle(dropdown) {
        return dropdown ? dropdown.querySelector(TOGGLE_SELECTOR) : null;
      }

      function getActiveList() {
        return getList(activeDropdown);
      }

      function clearCloseTimer() {
        isCloseTracking = false;

        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = null;
        }
      }

      function clearSwitchTimer() {
        if (switchTimer) {
          window.clearTimeout(switchTimer);
          switchTimer = null;
        }
      }

      function clearResizeTimer() {
        if (resizeTimer) {
          window.clearTimeout(resizeTimer);
          resizeTimer = null;
        }
      }

      function isPointerInsideRect(event, rect, padding = 0) {
        if (!event || !rect) return false;

        return (
          event.clientX >= rect.left - padding &&
          event.clientX <= rect.right + padding &&
          event.clientY >= rect.top - padding &&
          event.clientY <= rect.bottom + padding
        );
      }

      function isPointerInMenuOrDropdown(event) {
        const menuRect = menu.getBoundingClientRect();
        const activeList = getActiveList();
        const listRect = activeList ? activeList.getBoundingClientRect() : null;

        const inMenu = isPointerInsideRect(event, menuRect, 4);
        const inDropdown = listRect ? isPointerInsideRect(event, listRect, 4) : false;

        return inMenu || inDropdown;
      }

      function isPointerInBridge(event) {
        const menuRect = menu.getBoundingClientRect();
        const activeList = getActiveList();

        if (!activeList) return false;

        const listRect = activeList.getBoundingClientRect();

        const bridgeRect = {
          left: Math.min(menuRect.left, listRect.left) - 48,
          right: Math.max(menuRect.right, listRect.right) + 48,
          top: menuRect.bottom - 12,
          bottom: listRect.top + 72
        };

        return isPointerInsideRect(event, bridgeRect, 0);
      }

      function getMenuStartLeft() {
        const firstDropdown = dropdowns[0];
        const rect = firstDropdown ? firstDropdown.getBoundingClientRect() : menu.getBoundingClientRect();

        return Math.max(0, Math.round(rect.left));
      }

      function syncDropdownPanelAlignment(list) {
        if (!list || !isDesktop()) return;

        const offsetParent = list.offsetParent || document.documentElement;
        const parentRect =
          offsetParent === document.documentElement || offsetParent === document.body
            ? { left: 0 }
            : offsetParent.getBoundingClientRect();

        const startLeft = getMenuStartLeft();
        const viewportWidth = document.documentElement.clientWidth;
        const panelWidth = Math.max(0, viewportWidth - startLeft);

        list.style.setProperty("--mega-menu-align-left", Math.round(startLeft - parentRect.left) + "px");
        list.style.setProperty("--mega-menu-panel-width", panelWidth + "px");
      }

      function syncAllDropdownPanelAlignments() {
        dropdowns.forEach(function (dropdown) {
          syncDropdownPanelAlignment(getList(dropdown));
        });
      }

      function removeDesktopWebflowOpenState(dropdown) {
        if (!dropdown || !isDesktop()) return;

        const toggle = getToggle(dropdown);
        const list = getList(dropdown);

        dropdown.classList.remove("w--open");

        if (toggle) {
          toggle.classList.remove("w--open");
          toggle.setAttribute("aria-expanded", "false");
        }

        if (list) {
          list.classList.remove("w--open");
        }
      }

      function getNaturalHeight(list) {
        if (!list) return 0;

        const previousHeight = list.style.height;
        const previousOverflow = list.style.overflow;

        list.classList.add("is-height-instant");
        list.style.height = "auto";
        list.style.overflow = "hidden";

        const height = Math.round(list.scrollHeight);

        list.style.height = previousHeight;
        list.style.overflow = previousOverflow;

        list.offsetHeight;
        list.classList.remove("is-height-instant");

        return height;
      }

      function getVisibleHeight(dropdown) {
        const list = getList(dropdown);
        if (!list) return 0;

        return Math.round(list.getBoundingClientRect().height);
      }

      function setHeightInstant(list, height) {
        if (!list) return;

        list.classList.add("is-height-instant");
        list.style.height = height + "px";
        list.offsetHeight;
        list.classList.remove("is-height-instant");
      }

      /* ______________________________________________________________
         PART 3 — RESET INACTIVE DROPDOWNS
      ______________________________________________________________ */

      function resetInactiveDropdowns(exceptDropdown) {
        dropdowns.forEach(function (dropdown) {
          if (dropdown === exceptDropdown) return;

          const list = getList(dropdown);

          dropdown.classList.remove("is-dropdown-active");
          removeDesktopWebflowOpenState(dropdown);

          if (list) {
            list.style.height = "0px";
          }
        });
      }

      /* ______________________________________________________________
         PART 4 — ACTIVATE DROPDOWN WITH SMOOTH HEIGHT MORPH
      ______________________________________________________________ */

      function activateDropdown(dropdown) {
        if (!isDesktop() || !dropdown) return;

        const list = getList(dropdown);
        const toggle = getToggle(dropdown);

        if (!list) return;

        syncDropdownPanelAlignment(list);
        clearCloseTimer();

        const previousDropdown = activeDropdown;
        const wasMenuOpen = isMenuOpen;
        const isSameDropdown = previousDropdown === dropdown;

        const previousVisibleHeight = wasMenuOpen
          ? getVisibleHeight(previousDropdown) || currentMenuHeight
          : 0;

        const targetHeight = getNaturalHeight(list);

        activeDropdown = dropdown;
        isMenuOpen = true;
        currentMenuHeight = targetHeight;

        menu.classList.add("is-mega-open");

        if (wasMenuOpen && !isSameDropdown) {
          menu.classList.add("is-mega-switching");
        } else {
          menu.classList.remove("is-mega-switching");
        }

        resetInactiveDropdowns(dropdown);

        dropdown.classList.add("is-dropdown-active");
        removeDesktopWebflowOpenState(dropdown);

        if (toggle) {
          toggle.setAttribute("aria-expanded", "true");
        }

        if (isSameDropdown) {
          list.style.height = targetHeight + "px";
          return;
        }

        setHeightInstant(list, previousVisibleHeight);

        window.requestAnimationFrame(function () {
          list.style.height = targetHeight + "px";
        });

        clearSwitchTimer();
        switchTimer = window.setTimeout(function () {
          menu.classList.remove("is-mega-switching");
        }, SWITCH_CLASS_CLEAR_DELAY);
      }

      /* ______________________________________________________________
         PART 5 — CLOSE BEHAVIOR
      ______________________________________________________________ */

      function closeMenu() {
        clearCloseTimer();
        clearSwitchTimer();

        dropdowns.forEach(function (dropdown) {
          const list = getList(dropdown);
          const toggle = getToggle(dropdown);

          dropdown.classList.remove("is-dropdown-active");

          if (isDesktop()) {
            dropdown.classList.remove("w--open");
          }

          if (toggle && isDesktop()) {
            toggle.classList.remove("w--open");
            toggle.setAttribute("aria-expanded", "false");
          }

          if (list) {
            if (isDesktop()) {
              list.classList.remove("w--open");
              list.style.height = "0px";
            } else {
              list.style.height = "";
            }
          }
        });

        menu.classList.remove("is-mega-open", "is-mega-switching");

        activeDropdown = null;
        isMenuOpen = false;
        currentMenuHeight = 0;
        isCloseTracking = false;
      }

      function scheduleClose(event) {
        clearCloseTimer();
        isCloseTracking = true;

        if (!isPointerInMenuOrDropdown(event) && !isPointerInBridge(event)) {
          closeMenu();
          return;
        }

        const delay = isPointerInBridge(event) ? CLOSE_DELAY_BRIDGE : CLOSE_DELAY_FAST;

        closeTimer = window.setTimeout(function () {
          if (!menu.matches(":hover") && !menu.contains(document.activeElement)) {
            closeMenu();
          }
        }, delay);
      }

      function resetAfterResize() {
        clearResizeTimer();

        resizeTimer = window.setTimeout(function () {
          syncAllDropdownPanelAlignments();
          closeMenu();
        }, RESIZE_RESET_DELAY);
      }

      /* ______________________________________________________________
         PART 6 — EVENT BINDING
      ______________________________________________________________ */

      dropdowns.forEach(function (dropdown) {
        const toggle = getToggle(dropdown);
        const list = getList(dropdown);

        if (!toggle || !list) return;

        toggle.addEventListener("mouseenter", function () {
          activateDropdown(dropdown);
        });

        dropdown.addEventListener("mouseenter", function () {
          activateDropdown(dropdown);
        });

        list.addEventListener("mouseenter", function () {
          activateDropdown(dropdown);
        });

        toggle.addEventListener("focusin", function () {
          activateDropdown(dropdown);
        });
      });

      menu.addEventListener("mouseenter", clearCloseTimer);
      menu.addEventListener("mouseleave", scheduleClose);

      document.addEventListener(
        "mousemove",
        function (event) {
          if (!activeDropdown || !isDesktop() || !isCloseTracking) return;

          if (!isPointerInMenuOrDropdown(event) && !isPointerInBridge(event)) {
            closeMenu();
          }
        },
        { passive: true }
      );

      menu.addEventListener("focusout", function () {
        window.setTimeout(function () {
          if (!menu.contains(document.activeElement)) {
            closeMenu();
          }
        }, 50);
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && activeDropdown) {
          closeMenu();
        }
      });

      window.addEventListener("resize", resetAfterResize);
      window.addEventListener("orientationchange", resetAfterResize);
      window.addEventListener("blur", closeMenu);
      window.addEventListener("pagehide", closeMenu);

      document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
          closeMenu();
        }
      });

      if (DESKTOP_QUERY.addEventListener) {
        DESKTOP_QUERY.addEventListener("change", resetAfterResize);
      } else if (DESKTOP_QUERY.addListener) {
        DESKTOP_QUERY.addListener(resetAfterResize);
      }

      window.addEventListener(
        "scroll",
        function () {
          if (!activeDropdown || !isDesktop()) return;

          const list = getList(activeDropdown);
          if (!list) return;

          syncDropdownPanelAlignment(list);

          const targetHeight = getNaturalHeight(list);

          setHeightInstant(list, targetHeight);
          currentMenuHeight = targetHeight;
        },
        { passive: true }
      );

      syncAllDropdownPanelAlignments();
      closeMenu();
    });
  })();
</script>
<!-- ✅ END: Native mega menu - underline, hover, smooth height, full-bleed bg, aligned content, chevron --></div><div fs-scrolldisable-element="smart-nav" data-animation="default" data-collapse="medium" data-duration="250" data-easing="ease" data-easing2="ease-out-cubic" role="banner" class="navbar-new-component w-nav"><div class="container-navbar-new"><a aria-label="LTX Home" href="/" class="menu-logo-wrap is-mobile w-inline-block"><div aria-label="LTX home" class="menu-logo w-embed"><!-- Responsive SVG: scales with wrapper width -->
