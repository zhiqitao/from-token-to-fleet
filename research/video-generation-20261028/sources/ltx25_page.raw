        visibility 0ms linear 0ms;
    }

    :is(.navbar5_menu-left, .ltx--navbar5_menu-left).is-mega-switching :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) {
      transition:
        height 520ms cubic-bezier(0.16, 1, 0.3, 1),
