     type="video/webm"
  />
</video></div></div></div></div></div></div><div class="hover-tabs-code w-embed w-script"><style>
  .hover-tabs-new {
    /* ---------- shared ---------- */
    --ht-dim: 0.4;                   /* opacity of non-active list items — lower = more dimmed */
    --ht-ease: cubic-bezier(0.16, 1, 0.3, 1); /* snappy expo-out — used for the list-item dim */
    --ht-text-dur: 0.4s;             /* list-item dim duration (stays snappy) */
    --ht-desc-dur: 0.6s;             /* description reveal duration — longer, smoother */
    --ht-desc-ease: cubic-bezier(0.22, 1, 0.36, 1); /* softer expo-out for the tab open */

    /* ---------- what-changed-card (desktop only) ---------- */
    --wc-gap: 4px;                   /* space between the video's bottom edge and the card */
    --wc-inset-x: 0px;               /* left/right inset relative to the video's width */

    --wc-dur: 0.42s;                 /* ENTER: slide down out from under the video */
    --wc-ease: cubic-bezier(0.22, 1, 0.36, 1); /* expo-out — fast start, soft landing */
    --wc-in-fade: 0.12s;             /* enter fade — short, finishes while still hidden */

    --wc-out-dur: 0.3s;              /* EXIT: slide back up under the video */
    --wc-out-ease: cubic-bezier(0.4, 0, 1, 1); /* ease-in — accelerates away */
    --wc-out-fade: 0.18s;            /* exit fade — shorter than the slide */

    /* ---------- compact accordion (991 and down / touch) ---------- */
    --ht-inline-gap: 1rem;           /* space between the description and the video */
    --ht-inline-bottom: 0.5rem;      /* space under the video, before the next title */
    --ht-inline-radius: 10px;
    --ht-inline-dur: 0.45s;          /* open/close duration — JS reads this value */
    --ht-inline-ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ============================================================
     SHARED — list-item dim + the description accordion.
     Identical in both modes: only the active item's description is open.
     ============================================================ */
  .hover-tabs-new.is-ht-ready .hover-tab-text__item {
    opacity: var(--ht-dim);
    transition: opacity var(--ht-text-dur) var(--ht-ease);
  }
  .hover-tabs-new.is-ht-ready .hover-tab-text__item.is-active { opacity: 1; }

  /* Hidden by default, opens on activation. JS sets --ht-desc-h to the real height. */
  .hover-tabs-new.is-ht-ready .hover-tab__detail {
    height: auto;                    /* overrides Webflow native-tabs' height:0 so max-height can open it */
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(-10px);
    transition: max-height var(--ht-desc-dur) var(--ht-desc-ease),
                opacity var(--ht-desc-dur) var(--ht-desc-ease),
                transform var(--ht-desc-dur) var(--ht-desc-ease);
  }
  .hover-tabs-new.is-ht-ready .hover-tab-text__item.is-active .hover-tab__detail {
    max-height: var(--ht-desc-h, 10rem);
    opacity: 1;
    transform: translateY(0);
  }

  .hover-tabs-new.is-ht-ready .hover-tabs-asset-wrap img,
  .hover-tabs-new.is-ht-ready .hover-tabs-asset-wrap video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Don't let the rule above hijack media inside the card. */
  .hover-tabs-new.is-ht-ready .what-changed-card img,
  .hover-tabs-new.is-ht-ready .what-changed-card video {
    width: auto;
    height: auto;
    object-fit: initial;
  }

  /* The slot is created by JS in both modes but only ever used in compact. */
  .ht-inline-slot { display: none; }

  /* ============================================================
     DESKTOP MODE
     ============================================================ */
  @media (min-width: 992px) and (hover: hover) {
    /* Panels are stacked; the wrap stays present so the card can animate out of it.
       Position/size are set in Webflow (absolute, bottom:0, right:0, width:60%, 16:9,
       relative to .hover-tabs-new). */
    .hover-tabs-new.is-ht-ready .hover-tabs-asset-wrap {
      display: block !important;     /* beats Webflow native-tabs' inline display:none on non-current panels */
      pointer-events: none;
    }
    .hover-tabs-new.is-ht-ready .hover-tabs-asset-wrap.is-active { pointer-events: auto; }

    /* The media child does the instant swap. :not(.what-changed-card) so the card is
       excluded from both the hide and the height:100% stretch. z-index 2 puts the video
       ABOVE the card, which is what occludes the card while it's tucked. */
    .hover-tabs-new.is-ht-ready .hover-tabs-asset-wrap > *:not(.what-changed-card) {
      position: relative;
      z-index: 2;
      height: 100%;
      opacity: 0;
      visibility: hidden;
    }
    .hover-tabs-new.is-ht-ready .hover-tabs-asset-wrap.is-active > *:not(.what-changed-card) {
      opacity: 1;
      visibility: visible;
    }

    /* --- .what-changed-card, hidden / EXIT state ---
       Rests fully outside the panel at top:100% + gap, but starts translated up by its own
       height + the gap, which parks it flush behind the video's bottom edge. The transition
       here IS the exit: transitions read the after-change style, so leaving .is-active
       animates back up using these durations.
       `visibility 0s linear var(--wc-out-dur)` is load-bearing — without the delay,
       visibility would flip to hidden immediately and the slide-up would be invisible. */
    .hover-tabs-new.is-ht-ready .what-changed-card {
      position: absolute;
      top: calc(100% + var(--wc-gap));
      bottom: auto;
      left: var(--wc-inset-x);
      right: var(--wc-inset-x);
      z-index: 1;                    /* BEHIND the media child (z-index 2) */
      height: auto;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translate3d(0, calc(-100% - var(--wc-gap)), 0);
      will-change: transform, opacity;
      transition: transform var(--wc-out-dur) var(--wc-out-ease),
                  opacity var(--wc-out-fade) linear,
                  visibility 0s linear var(--wc-out-dur);
    }

    /* ENTER: slide down into place, uncovered by the video as it travels. */
    .hover-tabs-new.is-ht-ready .hover-tabs-asset-wrap.is-active .what-changed-card {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translate3d(0, 0, 0);
      transition: transform var(--wc-dur) var(--wc-ease),
                  opacity var(--wc-in-fade) linear,
                  visibility 0s;
    }
  }

  /* ============================================================
     COMPACT MODE — tablet 991 and down, or any touch-primary device.
     ============================================================ */
  @media (max-width: 991px), (hover: none) and (pointer: coarse) {
    .hover-tabs-new.is-ht-ready {
      display: block;                /* single column regardless of the desktop flex/grid */
      /* Run the description on the same clock as the box, so the item's total height
         changes as one motion instead of easing out and then continuing to shrink. */
      --ht-desc-dur: var(--ht-inline-dur);
      --ht-desc-ease: var(--ht-inline-ease);
    }
    .hover-tabs-new.is-ht-ready .hover-tabs-new-column {
      width: 100%;
      max-width: none;
    }
    /* Emptied by the script; collapse it so it leaves no gap at the end of the section. */
    .hover-tabs-new.is-ht-ready .is-ht-media-col {
      display: block;
      height: 0;
      overflow: hidden;
    }

    /* ---- THE SLOT ----
       Does all the clipping, so the panel inside keeps its full height and the video is
       revealed rather than squashed. JS drives max-height in px.
       NO PADDING HERE — border-box means padding would stop max-height:0 from reaching 0.
       The gap is margin-top on the panel below, inside the clipped area. */
    .hover-tabs-new.is-ht-ready .ht-inline-slot {
      overflow: hidden;              /* also makes this a BFC, so the panel's margin can't escape */
      max-height: 0;
      opacity: 0;
      padding: 0;
      transition: max-height var(--ht-inline-dur) var(--ht-inline-ease),
                  opacity var(--ht-inline-dur) linear;
    }
    .hover-tabs-new.is-ht-ready .ht-inline-slot.is-open { display: block; }

    /* Panel sits in normal flow inside the slot, at its natural 16:9 height. */
    .hover-tabs-new.is-ht-ready .ht-inline-slot .hover-tabs-asset-wrap {
      display: block !important;
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      width: 100%;
      height: auto;
      padding: 0;                    /* in case Webflow used a padding-based aspect ratio */
      margin: var(--ht-inline-gap) 0 var(--ht-inline-bottom);
      aspect-ratio: 16 / 9;
      border-radius: var(--ht-inline-radius);
      overflow: hidden;
      contain: layout paint;         /* keeps the video's internal work off the page's layout */
      pointer-events: auto;
    }
    /* Absolute fill, so the card never depends on a percentage height resolving. */
    .hover-tabs-new.is-ht-ready .ht-inline-slot .hover-tabs-asset-wrap > *:not(.what-changed-card) {
      position: absolute;
      inset: 0;
      height: auto;
      opacity: 1;
      visibility: visible;
    }
    /* The page's head CSS only makes .feature-card-wrap a positioned, clipping stacking
       context at >=992px. The absolutely-positioned .video-facade / video need it here too. */
    .hover-tabs-new.is-ht-ready .ht-inline-slot .feature-card-wrap {
      overflow: hidden;
      isolation: isolate;
    }

    .hover-tabs-new.is-ht-ready .what-changed-card { display: none !important; }

    /* Applied for a single frame while the item above is collapsed, so the whole shift
       lands in one layout pass and can be cancelled by one scroll adjustment. */
    .hover-tabs-new.is-ht-ready .hover-tab-text__item.is-ht-instant,
    .hover-tabs-new.is-ht-ready .hover-tab-text__item.is-ht-instant .hover-tab__detail,
    .hover-tabs-new.is-ht-ready .hover-tab-text__item.is-ht-instant .ht-inline-slot {
      transition: none !important;
    }

    .hover-tabs-new.is-ht-ready .hover-tab-text__item {
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .hover-tabs-new.is-ht-ready .hover-tab-text__item:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 6px;
      border-radius: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hover-tabs-new.is-ht-ready .what-changed-card {
      transform: none;
      transition: opacity 0.2s linear, visibility 0s linear 0.2s;
    }
    .hover-tabs-new.is-ht-ready .hover-tabs-asset-wrap.is-active .what-changed-card {
      transform: none;
      transition: opacity 0.2s linear, visibility 0s;
    }
    .hover-tabs-new.is-ht-ready .ht-inline-slot { transition: none; }
  }
</style>

<script>
  (function () {
    /* Width OR input capability: a 900px-wide desktop window can't support the hover layout
       either, and a 1024px iPad has no hover to give. Mirrors the CSS media query exactly. */
    var TAP_QUERY = '(max-width: 991px), (hover: none) and (pointer: coarse)';

    /* Prefetch one item ahead so a first open isn't a cold fetch. Off by default: a frame
       trace on staging showed zero long frames during an open, so video loading was never
       what made this feel rough, and warming spends data on items nobody opened. */
    var WARM_AHEAD = false;

    function ms(value, fallback) {
      var v = String(value || '').trim();
      var num = parseFloat(v);
      if (!num) return fallback;
      return v.indexOf('ms') > -1 ? num : num * 1000;
    }

    function cheapConnection() {
      var c = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      if (!c) return false;
      if (c.saveData) return true;
      return /(^|-)2g$/.test(c.effectiveType || '');
    }

    var idle = window.requestIdleCallback || function (fn) { return setTimeout(fn, 120); };

    /* How the tapped title is kept from moving when the item above it collapses.
         'instant' — collapse it with transitions off, absorb the shift in one scrollBy in the
                     same frame. One scroll adjustment per tap. (default)
         'frames'  — the old behaviour: track the title and scrollBy every frame for ~700ms.
         'off'     — do nothing; let the browser's native scroll anchoring handle it. */
    var ANCHOR_MODE = 'off';

    /* Bringing the opened item into view.
         'ifNeeded' — scroll only when the video would hang below the fold. (default)
         'always'   — always bottom-align the opened item, even if it already fits.
         'off'      — never scroll on open. */
    var REVEAL_ON_OPEN = 'ifNeeded';
    var REVEAL_BOTTOM_GAP = 16;   /* px left between the video's bottom edge and the fold */
    var REVEAL_TOP_GAP = 16;      /* the title is never pushed closer than this to the top */
    var REVEAL_MIN = 8;           /* ignore corrections smaller than this */

    /* Only used by ANCHOR_MODE 'frames'. Lenis runs on this site with smoothTouch off, so on
       touch this is a plain native scroll. If smoothTouch is ever turned on, swap
       window.scrollBy for lenis.scrollTo(lenis.scroll + d, { immediate: true }). */
    function keepAnchored(el, duration) {
      if (!el) return;
      var start = el.getBoundingClientRect().top;
      var t0 = performance.now();
      requestAnimationFrame(function tick(now) {
        var d = el.getBoundingClientRect().top - start;
        if (Math.abs(d) > 0.5) window.scrollBy(0, d);
        if (now - t0 < duration) requestAnimationFrame(tick);
      });
    }

    /* One eased scroll, handed to whichever engine owns scrolling. Lenis runs on this site,
       so use its own scrollTo when present to keep its internal target in sync; otherwise the
       browser's native smooth scroll, which also respects prefers-reduced-motion. */
    function smoothScrollBy(delta, seconds) {
      var top = (window.pageYOffset || document.documentElement.scrollTop || 0) + delta;
      if (window.lenis && typeof window.lenis.scrollTo === 'function') {
        try { window.lenis.scrollTo(top, { duration: seconds, easing: REVEAL_EASE }); return; } catch (e) {}
      }
      try { window.scrollTo({ top: top, behavior: 'smooth' }); }
      catch (e) { window.scrollTo(0, top); }
    }

    function initHoverTabsNew() {
      var tapMQ = window.matchMedia(TAP_QUERY);
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      Array.prototype.forEach.call(document.querySelectorAll('.hover-tabs-new'), function (root) {
        var items = Array.prototype.slice.call(root.querySelectorAll('.hover-tab-text__item'));
        var assets = Array.prototype.slice.call(root.querySelectorAll('.hover-tabs-asset-wrap'));
        if (!items.length || !assets.length) return;
        if (items.length !== assets.length) {
          console.warn('[hover-tabs] item/asset count mismatch:', items.length, 'items vs', assets.length, 'assets — pairing to the min.');
        }
        var n = Math.min(items.length, assets.length);
        root.classList.add('is-ht-ready');

        var mediaCol = assets[0].parentElement;
        if (mediaCol) mediaCol.classList.add('is-ht-media-col');

        /* Read the duration off the CSS var so the two can't drift apart. */
        var DUR = reduced ? 0 : ms(getComputedStyle(root).getPropertyValue('--ht-inline-dur'), 450);

        /* Posters decode off the main thread, so a first open can't stall on them. */
        assets.forEach(function (wrap) {
          Array.prototype.forEach.call(wrap.querySelectorAll('img'), function (img) {
            img.decoding = 'async';
          });
        });

        var warmed = {};
        function warm(i) {
          if (!WARM_AHEAD || warmed[i] || i < 0 || i >= n || cheapConnection()) return;
          warmed[i] = true;
          var wrap = assets[i];
          var url = '';
          Array.prototype.forEach.call(wrap.querySelectorAll('source'), function (s) {
            if (!url) url = s.dataset.srcMobile || s.dataset.src || '';
          });
          if (!url) {
            var v = wrap.querySelector('video');
            url = (v && (v.dataset.srcMobile || v.dataset.src)) || '';
          }
          if (!url) return;
          try {
            fetch(url, { mode: 'no-cors', credentials: 'omit', priority: 'low' }).catch(function () {});
          } catch (e) {}
        }

        /* One slot per item, appended after the description. Empty and display:none on
           desktop; the panels only move in when compact mode is active. */
        var slots = items.map(function (item) {
          var slot = document.createElement('div');
          slot.className = 'ht-inline-slot';
          item.appendChild(slot);
          return slot;
        });

        var roles = items.map(function (item) { return item.getAttribute('role') || ''; });
        var inline = false;
        var active = -1;

        function toInline() {
          if (inline) return;
          for (var i = 0; i < n; i++) slots[i].appendChild(assets[i]);
          items.forEach(function (item) { item.setAttribute('role', 'button'); });
          inline = true;
        }
        function toColumn() {
          if (!inline || !mediaCol) return;
          assets.forEach(function (a) { mediaCol.appendChild(a); });
          slots.forEach(function (s) {
            s.classList.remove('is-open');
            s.style.maxHeight = '';
            s.style.opacity = '';
          });
          items.forEach(function (item, i) {
            if (roles[i]) item.setAttribute('role', roles[i]);
            else item.removeAttribute('role');
            item.removeAttribute('aria-expanded');
          });
          inline = false;
        }

        /* From the panel's own box, not slot.scrollHeight — the gap is a child margin now,
           and scrollHeight's treatment of child margins isn't something to lean on. The slot
           must be display:block first; clipping doesn't affect the panel's own height. */
        function targetHeight(i) {
          var panel = assets[i];
          var pcs = getComputedStyle(panel);
          return Math.round(
            panel.offsetHeight +
            (parseFloat(pcs.marginTop) || 0) +
            (parseFloat(pcs.marginBottom) || 0)
          );
        }

        function openSlot(i, immediate) {
          var slot = slots[i];
          if (!slot) return;
          window.clearTimeout(slot._htTimer);
          slot.classList.add('is-open');

          if (immediate || !DUR) {
            slot.style.maxHeight = 'none';
            slot.style.opacity = '1';
            return;
          }

          var h = targetHeight(i);
          slot.style.maxHeight = '0px';
          void slot.offsetHeight;             /* reflow, so the next value animates */
          slot.style.maxHeight = h + 'px';
          slot.style.opacity = '1';

          slot._htTimer = window.setTimeout(function () {
            slot.style.maxHeight = 'none';    /* release the cap so it stays responsive */
            idle(function () { warm(i + 1); });
          }, DUR + 40);
        }

        function closeSlot(i, immediate) {
          var slot = slots[i];
          if (!slot || !slot.classList.contains('is-open')) return;
          window.clearTimeout(slot._htTimer);

          if (immediate || !DUR) {
            slot.classList.remove('is-open');
            slot.style.maxHeight = '';
            slot.style.opacity = '';
            return;
          }

          slot.style.maxHeight = targetHeight(i) + 'px';
          void slot.offsetHeight;
          slot.style.maxHeight = '0px';       /* reaches a true 0 now — no padding in the way */
          slot.style.opacity = '0';
          slot._htTimer = window.setTimeout(function () {
            slot.classList.remove('is-open'); /* display:none, and nothing left to snap away */
            slot.style.maxHeight = '';
            slot.style.opacity = '';
          }, DUR + 40);
        }

        function videosIn(wrap) {
          return Array.prototype.slice.call(wrap.querySelectorAll('video'));
        }

        /* display:none already stops the page's IO loaders from playing closed panels; this
           makes it deterministic and covers the window while a slot is still collapsing. */
        function syncVideos(i) {
          assets.forEach(function (wrap, j) {
            videosIn(wrap).forEach(function (v) {
              if (v.hasAttribute('data-manual-pause')) return;
              if (j === i) {
                if (!v.currentSrc) return;    /* not hydrated yet — its own IO will start it */
                var p = v.play();
                if (p && p.catch) p.catch(function () {});
              } else if (!v.paused) {
                v.pause();
              }
            });
          });
        }

        function resumeAll() {
          assets.forEach(function (wrap) {
            videosIn(wrap).forEach(function (v) {
              if (!v.currentSrc || v.hasAttribute('data-manual-pause')) return;
              var p = v.play();
              if (p && p.catch) p.catch(function () {});
            });
          });
        }

        /* Collapse an item with every transition suppressed, so its full height change lands
           in one synchronous layout rather than spread over DUR milliseconds. */
        function collapseInstant(k) {
          var it = items[k];
          if (!it) return;
          it.classList.add('is-ht-instant');
          it.classList.remove('is-active');
          closeSlot(k, true);
          void it.offsetHeight;             /* force the layout now, while transitions are off */
          requestAnimationFrame(function () { it.classList.remove('is-ht-instant'); });
        }

        /* Where the item's bottom edge will be once both boxes have finished opening. Both
           start at zero height, so it's the collapsed bottom plus the two target heights.
           Verified exact against the settled layout on staging. */
        function projectedBottom(i, item, rectBefore) {
          var detail = item.querySelector('.hover-tab__detail');
          var descTarget = detail
            ? (parseFloat(detail.style.getPropertyValue('--ht-desc-h')) || detail.scrollHeight || 0)
            : 0;
          return rectBefore.bottom + targetHeight(i) + descTarget;
        }

        /* How much layout will disappear ABOVE the tapped item as the currently open one
           collapses. Zero when that item is below, since its collapse can't move anything
           above it. Must be read before setActive closes it. */
        function closingHeight(a, i) {
          if (a < 0 || a >= i) return 0;
          var d = items[a].querySelector('.hover-tab__detail');
          var descH = d ? (parseFloat(d.style.getPropertyValue('--ht-desc-h')) || 0) : 0;
          return targetHeight(a) + descH;
        }

        function revealOnOpen(i, item, rectBefore, closingH) {
          if (REVEAL_ON_OPEN === 'off' || !DUR) return;
          /* Where the item lands once BOTH animations have finished: it slides up by whatever
             collapses above it, and grows downward by its own two boxes. */
          var settledTop = rectBefore.top - closingH;
          var settledBottom = projectedBottom(i, item, rectBefore) - closingH;
          /* Positive = the item hangs that far below where we want its bottom to sit. */
          var overhang = settledBottom - (window.innerHeight - REVEAL_BOTTOM_GAP);
          /* Scrolling further down than this would push the title off the top — happens when
             the item is taller than the viewport, where seeing the title matters more. */
          var maxDown = Math.max(0, settledTop - REVEAL_TOP_GAP);
          var delta;

          if (overhang > REVEAL_MIN) {
            delta = Math.min(overhang, maxDown);          /* hangs below the fold: bring it up */
          } else if (settledTop < REVEAL_TOP_GAP) {
            delta = settledTop - REVEAL_TOP_GAP;          /* sits above the fold: bring it down */
          } else if (REVEAL_ON_OPEN === 'always') {
            delta = overhang;                             /* already fits, but pin it to the bottom */
          } else {
            return;                                       /* 'ifNeeded' and it already fits */
          }

          if (Math.abs(delta) < REVEAL_MIN) return;
          smoothScrollBy(delta, REVEAL_DURATION);
        }

        function setActive(i, immediate) {
          if (i < 0 || i >= n) return;
          active = i;
          items.forEach(function (item, k) {
            var on = k === i;
            item.classList.toggle('is-active', on);
            if (tapMQ.matches) item.setAttribute('aria-expanded', on ? 'true' : 'false');
            else item.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          assets.forEach(function (asset, j) { asset.classList.toggle('is-active', j === i); });

          if (tapMQ.matches) {
            for (var k = 0; k < n; k++) {
              if (k === i) openSlot(k, immediate);
              else closeSlot(k, immediate);
            }
            syncVideos(i);
          }
        }

        var descs = Array.prototype.slice.call(root.querySelectorAll('.hover-tab__detail'));
        var measureRaf;
        function measureDescs() {
          cancelAnimationFrame(measureRaf);
          measureRaf = requestAnimationFrame(function () {
            descs.forEach(function (d) { d.style.setProperty('--ht-desc-h', d.scrollHeight + 'px'); });
          });
        }

        function activateByTap(i, item) {
          if (!tapMQ.matches || i === active) return;
          var title = item.querySelector('.hover-tab__ttl') || item;

          if (ANCHOR_MODE === 'frames') {
            keepAnchored(title, DUR + 250);
          } else if (ANCHOR_MODE === 'instant' && active > -1 && active < i) {
            /* The open item is above this one, so its collapse would drag the title up.
               Do the whole collapse in one layout pass and cancel it out in the same frame:
               measure, collapse with transitions off, measure again, scroll by the diff.
               Net visual movement of the title: zero. */
            var before = title.getBoundingClientRect().top;
            collapseInstant(active);
            var after = title.getBoundingClientRect().top;
            var shift = after - before;
            if (Math.abs(shift) > 0.5) window.scrollBy(0, shift);
          }
          /* If the open item is BELOW this one, its collapse can't move this title, so it
             animates normally and needs no compensation at all. */

          /* Measured after any compensation and before the open, so it is the settled
             collapsed geometry the projection is built on. */
          var rectBefore = item.getBoundingClientRect();
          /* If 'instant' already collapsed it, that height is gone from rectBefore already. */
          var closingH = (ANCHOR_MODE === 'instant') ? 0 : closingHeight(active, i);
          setActive(i);
          revealOnOpen(i, item, rectBefore, closingH);
        }

        items.forEach(function (item, i) {
          item.setAttribute('tabindex', '0');
          item.addEventListener('mouseenter', function () { if (!tapMQ.matches) setActive(i); });
          item.addEventListener('focus', function () { if (!tapMQ.matches) setActive(i); });
          item.addEventListener('pointerdown', function () {
            if (tapMQ.matches && i !== active) warm(i);
          }, { passive: true });
          item.addEventListener('click', function () { activateByTap(i, item); });
          item.addEventListener('keydown', function (e) {
            if (!tapMQ.matches) return;
            if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
              e.preventDefault();
              activateByTap(i, item);
            }
          });
        });

        var listWrap = root.querySelector('.hover-tabs-new-list-wrap') || root;
        listWrap.addEventListener('mouseleave', function () { if (!tapMQ.matches) setActive(0); });

        function applyMode(immediate) {
          if (tapMQ.matches) {
            toInline();
            setActive(0, immediate);
            idle(function () { warm(1); });
          } else {
            toColumn();
            setActive(0);
            resumeAll();
          }
        }

        function onModeChange() { applyMode(true); }
        if (tapMQ.addEventListener) tapMQ.addEventListener('change', onModeChange);
        else if (tapMQ.addListener) tapMQ.addListener(onModeChange);

        var resizeRaf;
        window.addEventListener('resize', function () {
          cancelAnimationFrame(resizeRaf);
          resizeRaf = requestAnimationFrame(measureDescs);
        });

        /* Only the TEXT column. Watching panel posters meant a first open triggered a
           full re-measure mid-animation. */
        Array.prototype.forEach.call(listWrap.querySelectorAll('img'), function (img) {
          if (!img.complete) img.addEventListener('load', measureDescs);
        });

        /* Fallback-font metrics give the wrong --ht-desc-h. */
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(measureDescs).catch(function () {});
        }

        measureDescs();
        applyMode(true);               /* item 1 open on load, no animation */
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHoverTabsNew);
    } else {
      initHoverTabsNew();
    }
  })();
</script></div></div></div></section><div class="vfx-capabilities-main-wrap"><div class="vfx-intro-section"><div class="padding-global"><div class="big-ttl-wrap-new is-center-desktop-tablet"><div class="spacer-8rem"></div><h2 class="vfx-heading is-center">LTX-2.5 for Post-Production</h2><div class="spacer-1rem"></div><p class="intro-paragraph is-balanced">Outputs you can keep shaping through compositing, color, and delivery.</p><div class="spacer-3rem"></div></div></div></div><div data-vfx-capabilities="root" class="vfx-capabilities-wrap is-stacking-wrap"><div class="vfx-capabilities-stack w-embed w-script"><!-- vfx-capabilities-stack-LIGHT -->
<!-- Paste into Embed on the light LTX page (inside/next to vfx-capabilities-wrap). Designer owns sticky on .vfx-anchor-link-menu.is-white — do not set menu position or top. White pill + depth stack, desktop/tablet only (≥768px). Not with vfx-capabilities-snap. Preview + published only. -->
<!-- Overflow fix: html/body/page-wrapper/wrap use overflow-x: clip (was visible). Clip still lets the sticky stack work,
     but no longer exposes the navbar menu / footer overflow that made the whole page scroll sideways. -->
<style>
  
  @media (min-width: 768px) {
    
    html:has(.vfx-capabilities-wrap),
    body:has(.vfx-capabilities-wrap) {
      overflow-x: clip !important;
    }

    .page-wrapper:has(.vfx-capabilities-wrap),
    .vfx-capabilities-wrap {
      overflow-x: clip !important;
      overflow-y: visible !important;
    }

    .vfx-capabilities-wrap .vfx-capability-section {
      position: sticky !important;
      top: 0 !important;
    }

    .vfx-capabilities-wrap.is-cap-stack {
      position: relative;
      isolation: isolate;
    }

    .vfx-capabilities-wrap.is-cap-stack .vfx-capability-section {
      top: 0 !important;
    }

    .vfx-capabilities-wrap.is-cap-stack .vfx-capability-section > .vfx-grid,
    .vfx-capabilities-wrap.is-cap-stack .vfx-capability-section > :first-child {
      transform-origin: 50% 50%;
      will-change: transform, opacity;
    }

    
    .vfx-capabilities-wrap.is-cap-stack .big-menu-wrap.is-center,
    .vfx-capabilities-wrap.is-cap-stack .big-menu-wrap {
      z-index: 99;
      pointer-events: auto;
    }

    .vfx-capabilities-wrap.is-cap-stack .vfx-anchor-link-menu.is-white,
    .vfx-capabilities-wrap.is-cap-stack .vfx-anchor-link-menu {
      z-index: 99;
      pointer-events: auto;
    }

    
    .vfx-anchor-link-menu.is-white .vfx-anchor-pill-indicator,
    .vfx-anchor-pill-indicator {
      display: block !important;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 0;
      border-radius: 30px;
      background-color: #ffffff;
      pointer-events: none !important;
      will-change: transform, width, height;
    }

    .vfx-anchor-link-menu--has-indicator .vfx-anchor-link {
      position: relative;
      z-index: 2;
      background-color: transparent !important;
      cursor: pointer !important;
      pointer-events: auto !important;
    }

    
    .vfx-anchor-link-menu--has-indicator .vfx-anchor-link * {
      pointer-events: none;
    }

    .vfx-anchor-link-menu--has-indicator .vfx-anchor-link.w--current:not(.is-active) {
      background-color: transparent !important;
      color: inherit !important;
    }

    .vfx-anchor-link-menu.is-white.vfx-anchor-link-menu--has-indicator .vfx-anchor-link.is-active,
    .vfx-anchor-link-menu--has-indicator .vfx-anchor-link.is-active {
      color: #000000 !important;
      background-color: transparent !important;
    }

    @media (prefers-reduced-motion: reduce) {
      .vfx-capabilities-wrap.is-cap-stack .vfx-capability-section > .vfx-grid,
      .vfx-capabilities-wrap.is-cap-stack .vfx-capability-section > :first-child {
        transform: none !important;
        opacity: 1 !important;
      }
    }
  }
</style>

<script>
(function () {
  "use strict";

  
  var SCALE_END = 0.5; 
  var OPACITY_END = 0; 
  var SCRUB = 0.85; 
  var CARD_EASE = "none"; 
  var MENU_DUR_BASE = 0.85; 
  var MENU_DUR_STEP = 0.45; 
  var MENU_EASE = "power2.inOut";
  var PILL_EASE = "power2.out";
  var PILL_DUR = 0.4; 
  var WRAP_SEL = ".vfx-capabilities-wrap";
  var SECTION_SEL = ".vfx-capability-section";
  var DESKTOP_MQ = "(min-width: 768px)"; 

  function isDesktopStack() {
    try {
      return window.matchMedia(DESKTOP_MQ).matches;
    } catch (e) {
      return true;
    }
  }

  function isDesignCanvas() {
    try {
      if (window.Webflow && typeof window.Webflow.env === "function") {
        if (window.Webflow.env("preview")) return false;
        if (window.Webflow.env("design")) return true;
      }
    } catch (e) {}
    return false;
  }

  function loadScript(url, cb) {
    var s = document.createElement("script");
    s.src = url;
    s.async = false;
    s.onload = function () {
      cb();
    };
    s.onerror = function () {
      cb();
    };
    document.head.appendChild(s);
  }

  function ensureScrollTrigger(cb) {
    function finish() {
      if (!window.gsap || !window.ScrollTrigger) return;
      try {
        gsap.registerPlugin(ScrollTrigger);
      } catch (e) {}
      cb();
    }
    if (window.gsap && window.ScrollTrigger) return finish();
    if (!window.gsap) return;
    var ver = window.gsap.version || "3.15.0";
    var urls = [
      "https://cdn.jsdelivr.net/npm/gsap@" + ver + "/dist/ScrollTrigger.min.js",
      "https://cdn.prod.website-files.com/gsap/" + ver + "/ScrollTrigger.min.js",
    ];
    function next() {
      if (!urls.length) return finish();
      loadScript(urls.shift(), function () {
        if (window.ScrollTrigger) finish();
        else next();
      });
    }
    next();
  }

  function animTarget(section) {
    return (
      section.querySelector(":scope > .vfx-grid") ||
      section.querySelector(".vfx-grid") ||
      section.firstElementChild ||
      section
    );
  }

  function init() {
    if (isDesignCanvas()) return;
    if (!isDesktopStack()) return;

    var wrap = document.querySelector(WRAP_SEL);
    if (!wrap) return;
    if (wrap.classList.contains("is-cap-snap")) return;
    if (wrap.dataset.vfxStackInit === "1") return;
    if (!window.gsap || !window.ScrollTrigger) return;

    var reduced = false;
    try {
      reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    } catch (e) {}

    var sections = Array.prototype.slice.call(wrap.querySelectorAll(SECTION_SEL));
    if (sections.length < 2) return;

    wrap.dataset.vfxStackInit = "1";
    wrap.classList.add("is-cap-stack");
    wrap.setAttribute("data-vfx-capabilities", "root");

    
    var pillMenu =
      wrap.querySelector(".vfx-anchor-link-menu.is-white") ||
      wrap.querySelector(".vfx-anchor-link-menu");
    var pillLinks = [];
    var pillIndicator = null;
    var activeIndex = 0;
    var navigating = false;
    var menuTween = null;

    function refreshPillLinks() {
      if (!pillMenu) {
        pillMenu =
          wrap.querySelector(".vfx-anchor-link-menu.is-white") ||
          wrap.querySelector(".vfx-anchor-link-menu");
      }
      if (!pillMenu) return;
      pillLinks = Array.prototype.slice.call(pillMenu.querySelectorAll(".vfx-anchor-link"));
    }

    function setupPillIndicator() {
      refreshPillLinks();
      if (!pillMenu || !pillLinks.length) return;
      pillMenu.classList.add("vfx-anchor-link-menu--has-indicator");
      pillIndicator = pillMenu.querySelector(".vfx-anchor-pill-indicator");
      if (!pillIndicator) {
        pillIndicator = document.createElement("span");
        pillIndicator.className = "vfx-anchor-pill-indicator";
        pillIndicator.setAttribute("aria-hidden", "true");
        pillMenu.insertBefore(pillIndicator, pillMenu.firstChild);
      }
    }

    function pillMetricsForLink(link) {
      if (!pillMenu || !link) return null;
      var navRect = pillMenu.getBoundingClientRect();
      var r = link.getBoundingClientRect();
      return {
        x: r.left - navRect.left,
        y: r.top - navRect.top,
        width: r.width,
        height: r.height,
      };
    }

    function applyPillMetrics(m, animate) {
      if (!pillIndicator || !m) return;
      if (reduced || !animate) {
        gsap.set(pillIndicator, { x: m.x, y: m.y, width: m.width, height: m.height });
        return;
      }
      gsap.to(pillIndicator, {
        x: m.x,
        y: m.y,
        width: m.width,
        height: m.height,
        duration: PILL_DUR,
        ease: PILL_EASE,
        overwrite: "auto",
      });
    }

    function setPillActive(index, animate) {
      if (!pillLinks.length) refreshPillLinks();
      if (!pillLinks.length) return;
      activeIndex = index;
      pillLinks.forEach(function (link, i) {
        var on = i === index;
        link.classList.toggle("is-active", on);
        link.classList.toggle("w--current", on);
        link.setAttribute("aria-current", on ? "true" : "false");
      });
      applyPillMetrics(pillMetricsForLink(pillLinks[index]), animate);
    }

    
    var PILL_FLIP = 0.9;

    function activeIndexFromScroll() {
      var vh = window.innerHeight || document.documentElement.clientHeight || 1;
      var idx = 0;
      for (var i = 0; i < sections.length - 1; i++) {
        var top = sections[i + 1].getBoundingClientRect().top;
        var t = (vh - top) / vh;
        if (t >= PILL_FLIP) idx = i + 1;
        else break;
      }
      return Math.max(0, Math.min(pillLinks.length - 1, idx));
    }

    function syncPillToCards() {
      if (navigating) return;
      if (!pillIndicator) return;
      if (!pillLinks.length) refreshPillLinks();
      if (!pillLinks.length) return;

      var idx = activeIndexFromScroll();
      if (idx === activeIndex) return;
      setPillActive(idx, !reduced);
    }

    setupPillIndicator();

    
    
    if (
      pillMenu &&
      pillMenu.closest(SECTION_SEL) &&
      pillMenu.parentElement !== wrap &&
      !(pillMenu.parentElement && pillMenu.parentElement.classList.contains("big-menu-wrap"))
    ) {
      wrap.insertBefore(pillMenu, wrap.firstChild);
    }

    
    var depthSTs = [];

    sections.forEach(function (section, i) {
      section.style.zIndex = String(i + 1);

      if (reduced) return;
      if (i === sections.length - 1) return;

      var next = sections[i + 1];
      var target = animTarget(section);
      var tween = gsap.fromTo(
        target,
        { scale: 1, opacity: 1 },
        {
          scale: SCALE_END,
          opacity: OPACITY_END,
          ease: CARD_EASE,
          paused: true,
        }
      );

      depthSTs.push(
        ScrollTrigger.create({
          trigger: next,
          start: "top bottom",
          end: "top top", 
          scrub: SCRUB,
          animation: tween,
          invalidateOnRefresh: true,
        })
      );
    });

    
    var sectionScrollY = [];

    function measureSectionScrollYs() {
      
      sections.forEach(function (s) {
        s.style.setProperty("position", "relative", "important");
        s.style.setProperty("top", "auto", "important");
      });
      void wrap.offsetHeight;
      var y = window.pageYOffset || document.documentElement.scrollTop || 0;

      sectionScrollY = sections.map(function (s) {
        return Math.max(0, Math.ceil(s.getBoundingClientRect().top + y));
      });

      sections.forEach(function (s) {
        s.style.removeProperty("position");
        s.style.removeProperty("top");
      });
      void wrap.offsetHeight;
    }

    function scrollYForIndex(i) {
      if (!sectionScrollY.length) measureSectionScrollYs();
      var y = sectionScrollY[i];
      if (typeof y !== "number" || isNaN(y)) return window.pageYOffset || 0;
      return y;
    }

    function stickySeatPx(section) {
      try {
        var n = parseFloat(window.getComputedStyle(section).top);
        return isNaN(n) ? 0 : n;
      } catch (e) {
        return 0;
      }
    }

    
    function snapStackToScroll() {
      ScrollTrigger.update();
      depthSTs.forEach(function (st) {
        if (!st || !st.animation) return;
        try {
          st.animation.progress(st.progress);
        } catch (e) {}
      });
    }

    
    
    function pageScroller() {
      var L = window.lenis;
      if (L && typeof L.scrollTo === "function") return L;
      return null;
    }

    function scrollToY(y, immediate) {
      var L = pageScroller();
      if (L) {
        L.scrollTo(y, { immediate: !!immediate, force: true, lock: true, programmatic: true });
        return;
      }
      window.scrollTo(0, y);
    }

    function settleAtIndex(i) {
      var section = sections[i];
      var seat = stickySeatPx(section);
      var guard = 0;
      
      while (guard < 8) {
        var top = section.getBoundingClientRect().top;
        var delta = top - seat;
        if (Math.abs(delta) <= 1) break;
        scrollToY(
          (window.pageYOffset || document.documentElement.scrollTop || 0) + delta,
          true
        );
        guard += 1;
      }
      sectionScrollY[i] = window.pageYOffset || document.documentElement.scrollTop || 0;
      snapStackToScroll();
    }

    
    function browseToIndex(i) {
      i = Math.max(0, Math.min(sections.length - 1, i));
      var from = activeIndex;

      measureSectionScrollYs();

      var startY = window.pageYOffset || document.documentElement.scrollTop || 0;
      var endY = scrollYForIndex(i);

      if (menuTween) {
        menuTween.kill();
        menuTween = null;
      }

      navigating = true;
      setPillActive(i, !reduced);

      function finish() {
        settleAtIndex(i);
        navigating = false;
        menuTween = null;
        syncPillToCards();
      }

      if (reduced) {
        finish();
        return;
      }

      if (Math.abs(endY - startY) < 2) {
        finish();
        return;
      }

      var steps = Math.max(1, Math.abs(i - from));
      
      var dur = Math.min(
        3.6,
        Math.max(MENU_DUR_BASE + steps * MENU_DUR_STEP, SCRUB + steps * 0.35)
      );

      var L = pageScroller();
      if (L) {
        var ease = gsap.parseEase ? gsap.parseEase(MENU_EASE) : function (t) { return t; };
        L.scrollTo(endY, {
          duration: dur,
          force: true,
          lock: true,
          programmatic: true,
          easing: ease,
          onComplete: finish,
        });
        return;
      }

      menuTween = gsap.to(
        { y: startY },
        {
          y: endY,
          duration: dur,
          ease: MENU_EASE,
          overwrite: true,
          onUpdate: function () {
            window.scrollTo(0, this.targets()[0].y);
          },
          onComplete: finish,
        }
      );
    }

    
    ScrollTrigger.create({
      trigger: sections[0],
      start: "top bottom",
      endTrigger: sections[sections.length - 1],
      end: "bottom top",
      onUpdate: syncPillToCards,
      onRefresh: syncPillToCards,
    });

    refreshPillLinks();
    pillLinks.forEach(function (link, i) {
      link.addEventListener(
        "click",
        function (e) {
          e.preventDefault();
          e.stopPropagation();
          browseToIndex(i);
        },
        true
      );
    });

    setPillActive(0, false);

    window.addEventListener(
      "resize",
      function () {
        measureSectionScrollYs();
        syncPillToCards();
        ScrollTrigger.refresh();
      },
      { passive: true }
    );

    measureSectionScrollYs();
    ScrollTrigger.refresh();
  }

  function boot() {
    if (isDesignCanvas()) return;
    if (!isDesktopStack()) return;
    ensureScrollTrigger(function () {
      init();
      if (!document.querySelector(WRAP_SEL + "[data-vfx-stack-init='1']")) {
        setTimeout(init, 400);
      }
    });
  }

  if (document.readyState === "complete") {
    setTimeout(boot, 0);
  } else {
    window.addEventListener("load", boot, { once: true });
  }
})();
</script>
</div><div class="vfx-compare-slider w-embed w-script"><!-- vfx-compare-slider-LIGHT -->
<!-- Paste into Embed classed vfx-compare-slider (once per page). Frost-white BA handle + pills; poster→shot on 3videos sections. -->
<style>
  
  .vfx-video-slider-wrap {
    --vfx-ba-pos: 50%; 
    position: relative; 
    overflow: hidden;
    touch-action: none; 
    user-select: none;
    -webkit-user-select: none;
  }

  
  .vfx-3videos-wrap > .vfx-video-slider-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    display: none;
    z-index: 0;
  }

  
  .vfx-3videos-wrap:not(.is-vfx-shots) > .vfx-video-slider-wrap.is-1,
  .vfx-3videos-wrap.is-vfx-shots > .vfx-video-slider-wrap.is-active {
    display: block;
    z-index: 1;
  }

  
  .vfx-video-slider-wrap.is-vfx-ba .vfx-after-video,
  .vfx-video-slider-wrap.is-vfx-ba .vfx-before-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    margin: 0;
  }

  .vfx-video-slider-wrap.is-vfx-ba .vfx-after-video {
    z-index: 1; 
  }

  .vfx-video-slider-wrap.is-vfx-ba .vfx-before-video {
    z-index: 2;
    
    clip-path: inset(0 calc(100% - var(--vfx-ba-pos)) 0 0);
  }

  
  .vfx-video-slider-wrap.is-vfx-ba .feature-card-wrap,
  .vfx-video-slider-wrap.is-vfx-ba .video-container,
  .vfx-video-slider-wrap.is-vfx-ba .video-facade,
  .vfx-video-slider-wrap.is-vfx-ba .feature-card-video,
  .vfx-video-slider-wrap.is-vfx-ba video,
  .vfx-video-slider-wrap.is-vfx-ba img.feature-poster-img,
  .vfx-video-slider-wrap.is-vfx-ba [class*="feature-poster-img"] {
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    object-fit: cover;
  }

  
  .vfx-ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--vfx-ba-pos);
    z-index: 5;
    width: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none; 
  }

  .vfx-ba-line {
    position: absolute;
    inset: 0 auto;
    left: 50%;
    width: 2px; 
    transform: translateX(-50%);
    background: #fff;
  }

  .vfx-ba-knob {
    position: relative;
    z-index: 1;
    width: 44px; 
    height: 44px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.4); 
    backdrop-filter: blur(12px); 
    -webkit-backdrop-filter: blur(12px);
    box-shadow: none;
    display: grid;
    place-items: center;
    pointer-events: auto;
    cursor: ew-resize;
    color: #fff; 
  }

  .vfx-ba-knob svg {
    width: 18px; 
    height: 18px;
    display: block;
  }

  
  .vfx-ba-hit {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--vfx-ba-pos);
    z-index: 4;
    width: 48px; 
    transform: translateX(-50%);
    cursor: ew-resize;
    touch-action: none;
  }

  
  .vfx-ba-label {
    position: absolute;
    top: 1rem; 
    z-index: 3;
    transform: none;
    margin: 0;
    padding: 0.3rem 0.6rem; 
    border-radius: 999px;
	background: rgba(0, 0, 0, 0.4);
	    
    color: rgba(255, 255, 255, 0.9); 
    font-size: 0.625rem; 
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    pointer-events: none;
    backdrop-filter: blur(12px) saturate(1.8); 
    -webkit-backdrop-filter: blur(12px) saturate(1.8);
  }

  .vfx-ba-label.is-before {
    left: 1rem; 
  }

  .vfx-ba-label.is-after {
    right: 1rem; 
  }

  
  @media (max-width: 991px) {
    .vfx-ba-label {
      display: none !important;
    }
  }

  .vfx-video-slider-wrap.is-dragging {
    cursor: ew-resize;
  }

  
  .vfx-posters-wrap.is-vfx-shots .vfx-shot {
    cursor: pointer;
  }

  .vfx-posters-wrap.is-vfx-shots .vfx-shot.is-active {
    outline: none;
    border: 1px solid rgba(255, 255, 255, 0.85); 
    border-radius: 0.3rem; 
  }

  @media (prefers-reduced-motion: reduce) {
    .vfx-video-slider-wrap.is-vfx-ba .vfx-before-video {
      transition: none;
    }
  }
</style>

<script>
(function () {
  "use strict";

  var START = 50; 

  function clamp(n, min, max) {
    return Math.min(max, Math.max(min, n));
  }

  function findVideos(root) {
    return Array.prototype.slice.call(root.querySelectorAll("video"));
  }

  
  function syncVideos(wrap) {
    var videos = findVideos(wrap);
    if (videos.length < 2) return;
    var lead = videos[0];
    videos.slice(1).forEach(function (v) {
      try {
        if (Math.abs((v.currentTime || 0) - (lead.currentTime || 0)) > 0.12) {
          v.currentTime = lead.currentTime || 0;
        }
      } catch (e) {}
    });
  }

  function setPos(wrap, pct) {
    var p = clamp(pct, 0, 100);
    wrap.style.setProperty("--vfx-ba-pos", p + "%");
    var hit = wrap.querySelector(".vfx-ba-hit");
    var handle = wrap.querySelector(".vfx-ba-handle");
    if (hit) hit.setAttribute("aria-valuenow", String(Math.round(p)));
    if (handle) handle.setAttribute("aria-valuenow", String(Math.round(p)));
  }

  function pctFromEvent(wrap, clientX) {
    var r = wrap.getBoundingClientRect();
    if (!r.width) return START;
    return ((clientX - r.left) / r.width) * 100;
  }

  function pauseVideos(root) {
    findVideos(root).forEach(function (v) {
      try {
        v.pause();
      } catch (e) {}
    });
  }

  
  function unloadVideos(root) {
    findVideos(root).forEach(function (v) {
      if (!v) return;
      try {
        v.pause();
      } catch (e) {}
      try {
        v.currentTime = 0;
      } catch (e2) {}
      try {
        var sources = v.querySelectorAll("source");
        Array.prototype.forEach.call(sources, function (s) {
          s.removeAttribute("src");
        });
        v.removeAttribute("src");
        v.load();
      } catch (e3) {}
      try {
        delete v.dataset.loaded;
      } catch (e4) {}
    });
  }

  function tryPlay(v) {
    if (!v) return;
    v.muted = true;
    v.loop = true;
    v.playsInline = true;
    try {
      v.setAttribute("muted", "");
      v.setAttribute("playsinline", "");
    } catch (err) {}
    try {
      var p = v.play();
      if (p && typeof p.catch === "function") p.catch(function () {});
    } catch (err) {}
  }

  
  function playVideos(root) {
    var preferMobile = false;
    try {
      preferMobile = !window.matchMedia("(min-width: 992px)").matches;
    } catch (e) {}

    findVideos(root).forEach(function (v) {
      if (!v) return;

      if (!v.dataset.loaded) {
        var sources = v.querySelectorAll("source");
        var wired = false;
        Array.prototype.forEach.call(sources, function (s) {
          var ms = s.getAttribute("data-src-mobile") || s.dataset.srcMobile;
          var ds = s.getAttribute("data-src") || s.dataset.src;
          var url = preferMobile && ms ? ms : ds;
          if (!url) return;
          s.src = url;
          wired = true;
        });
        if (wired) {
          v.dataset.loaded = "true";
          try {
            v.load();
          } catch (err) {}
          
          var onReady = function () {
            v.removeEventListener("loadeddata", onReady);
            v.removeEventListener("canplay", onReady);
            tryPlay(v);
          };
          v.addEventListener("loadeddata", onReady);
          v.addEventListener("canplay", onReady);
        }
      }

      tryPlay(v);
    });
  }

  function sectionInView(el) {
    if (!el) return false;
    var r = el.getBoundingClientRect();
    var vh = window.innerHeight || document.documentElement.clientHeight || 0;
    var pad = 50;
    return r.bottom > -pad && r.top < vh + pad;
  }

  
  function ensureChrome(wrap) {
    if (wrap.querySelector(".vfx-ba-handle")) return;

    var labelBefore = document.createElement("p");
    labelBefore.className = "vfx-ba-label is-before";
    labelBefore.textContent = "Before"; 

    var labelAfter = document.createElement("p");
    labelAfter.className = "vfx-ba-label is-after";
    labelAfter.textContent = "After"; 

    var hit = document.createElement("div");
    hit.className = "vfx-ba-hit";
    hit.setAttribute("role", "slider");
    hit.setAttribute("tabindex", "0");
    hit.setAttribute("aria-label", "Before and after comparison");
    hit.setAttribute("aria-valuemin", "0");
    hit.setAttribute("aria-valuemax", "100");
    hit.setAttribute("aria-valuenow", String(START));
    hit.setAttribute("aria-orientation", "horizontal");

    var handle = document.createElement("div");
    handle.className = "vfx-ba-handle";
    handle.setAttribute("aria-hidden", "true");
    handle.innerHTML =
      '<span class="vfx-ba-line"></span>' +
      '<button type="button" class="vfx-ba-knob" tabindex="-1" aria-hidden="true">' +
      '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">' +
      '<path d="M8 7L3 12L8 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>' +
      '<path d="M16 7L21 12L16 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>' +
      "</svg></button>";

    wrap.appendChild(labelBefore);
    wrap.appendChild(labelAfter);
    wrap.appendChild(hit);
    wrap.appendChild(handle);
  }

  function initWrap(wrap) {
    if (wrap.dataset.vfxBaInit === "1") return;
    if (!wrap.querySelector(".vfx-before-video") || !wrap.querySelector(".vfx-after-video")) {
      return;
    }

    wrap.dataset.vfxBaInit = "1";
    wrap.classList.add("is-vfx-ba");
    ensureChrome(wrap);
    setPos(wrap, START);

    var dragging = false;

    function onPointerDown(e) {
      if (e.button != null && e.button !== 0) return;
      dragging = true;
      wrap.classList.add("is-dragging");
      try {
        wrap.setPointerCapture(e.pointerId);
      } catch (err) {}
      setPos(wrap, pctFromEvent(wrap, e.clientX));
      e.preventDefault();
      e.stopPropagation(); 
    }

    function onPointerMove(e) {
      if (!dragging) return;
      setPos(wrap, pctFromEvent(wrap, e.clientX));
      e.preventDefault();
      e.stopPropagation();
    }

    function onPointerUp(e) {
      if (!dragging) return;
      dragging = false;
      wrap.classList.remove("is-dragging");
      try {
        wrap.releasePointerCapture(e.pointerId);
      } catch (err) {}
    }

    var hit = wrap.querySelector(".vfx-ba-hit");
    var knob = wrap.querySelector(".vfx-ba-knob");

    [hit, knob, wrap].forEach(function (el) {
      if (!el) return;
      el.addEventListener("pointerdown", onPointerDown);
    });
    wrap.addEventListener("pointermove", onPointerMove);
    wrap.addEventListener("pointerup", onPointerUp);
    wrap.addEventListener("pointercancel", onPointerUp);

    
    hit.addEventListener("keydown", function (e) {
      var cur = parseFloat(wrap.style.getPropertyValue("--vfx-ba-pos")) || START;
      var step = e.shiftKey ? 10 : 2;
      if (e.key === "ArrowLeft" || e.key === "ArrowDown") {
        setPos(wrap, cur - step);
        e.preventDefault();
      } else if (e.key === "ArrowRight" || e.key === "ArrowUp") {
        setPos(wrap, cur + step);
        e.preventDefault();
      } else if (e.key === "Home") {
        setPos(wrap, 0);
        e.preventDefault();
      } else if (e.key === "End") {
        setPos(wrap, 100);
        e.preventDefault();
      }
    });

    var videos = findVideos(wrap);
    videos.forEach(function (v) {
      v.addEventListener("play", function () {
        videos.forEach(function (other) {
          if (other !== v && other.paused) {
            try {
              other.currentTime = v.currentTime || 0;
              other.play().catch(function () {});
            } catch (err) {}
          }
        });
      });
      v.addEventListener("timeupdate", function () {
        syncVideos(wrap);
      });
    });
  }

  
  function initShotSwitcher(section) {
    if (!section || section.dataset.vfxShotsInit === "1") return;

    var videosWrap = section.querySelector(".vfx-3videos-wrap");
    var postersWrap = section.querySelector(".vfx-posters-wrap");
    if (!videosWrap || !postersWrap) return;

    var shots = Array.prototype.slice.call(
      videosWrap.querySelectorAll(":scope > .vfx-video-slider-wrap")
    );
    var posters = Array.prototype.slice.call(
      postersWrap.querySelectorAll(":scope > .vfx-shot")
    );
    if (!shots.length || !posters.length) return;

    section.dataset.vfxShotsInit = "1";
    videosWrap.classList.add("is-vfx-shots");
    postersWrap.classList.add("is-vfx-shots");

    var shotIndex = 0;
    var inView = false;

    function activate(index) {
      var i = clamp(index, 0, Math.min(shots.length, posters.length) - 1);
      shotIndex = i;
      var activeWrap = null;

      shots.forEach(function (wrap, n) {
        var on = n === i;
        wrap.classList.toggle("is-active", on);
        wrap.setAttribute("aria-hidden", on ? "false" : "true");
        if (on) activeWrap = wrap;
        else unloadVideos(wrap);
      });

      posters.forEach(function (poster, n) {
        var on = n === i;
        poster.classList.toggle("is-active", on);
        poster.setAttribute("aria-pressed", on ? "true" : "false");
      });

      
      if (!inView || !activeWrap) return;

      requestAnimationFrame(function () {
        if (!inView || shotIndex !== i) return;
        playVideos(activeWrap);
        shots.forEach(function (wrap, n) {
          if (n !== i) unloadVideos(wrap);
        });
        setTimeout(function () {
          if (!inView || shotIndex !== i) return;
          playVideos(activeWrap);
          shots.forEach(function (wrap, n) {
            if (n !== i) unloadVideos(wrap);
          });
        }, 120);
      });
    }

    function setSectionVisible(on) {
      inView = !!on;
      if (inView) {
        activate(shotIndex);
      } else {
        shots.forEach(function (wrap) {
          unloadVideos(wrap);
        });
      }
    }

    posters.forEach(function (poster, i) {
      if (!poster.hasAttribute("tabindex")) poster.setAttribute("tabindex", "0");
      if (!poster.getAttribute("role")) poster.setAttribute("role", "button");
      if (!poster.getAttribute("aria-label")) {
        poster.setAttribute("aria-label", "Show shot " + (i + 1));
      }

      poster.addEventListener("click", function (e) {
        e.preventDefault();
        e.stopPropagation();
        activate(i);
      });

      poster.addEventListener("keydown", function (e) {
        if (e.key !== "Enter" && e.key !== " ") return;
        e.preventDefault();
        activate(i);
      });
    });

    var start = 0;
    for (var s = 0; s < shots.length; s++) {
      if (shots[s].classList.contains("is-active")) {
        start = s;
        break;
      }
    }
    shotIndex = start;
    
    activate(start);
    setSectionVisible(sectionInView(section));

    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(
        function (entries) {
          var e0 = entries[0];
          if (!e0) return;
          setSectionVisible(e0.isIntersecting);
        },
        { root: null, rootMargin: "50px 0px", threshold: 0 }
      );
      io.observe(section);
    }
  }

  
  function initBaViewport(section) {
    if (!section || section.dataset.vfxBaViewInit === "1") return;
    if (section.querySelector(".vfx-3videos-wrap.is-vfx-shots")) return;

    var wraps = Array.prototype.slice.call(
      section.querySelectorAll(".vfx-video-slider-wrap.is-vfx-ba")
    );
    if (!wraps.length) return;

    section.dataset.vfxBaViewInit = "1";

    function apply(on) {
      wraps.forEach(function (wrap) {
        if (on) playVideos(wrap);
        else unloadVideos(wrap);
      });
    }

    apply(sectionInView(section));

    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(
        function (entries) {
          var e0 = entries[0];
          if (!e0) return;
          apply(e0.isIntersecting);
        },
        { root: null, rootMargin: "50px 0px", threshold: 0 }
      );
      io.observe(section);
    }
  }

  function boot() {
    
    try {
      if (window.Webflow && typeof window.Webflow.env === "function" && window.Webflow.env("design")) {
        if (!window.Webflow.env("preview")) return;
      }
    } catch (e) {}

    var wraps = document.querySelectorAll(".vfx-video-slider-wrap");
    Array.prototype.forEach.call(wraps, initWrap);

    
    var sections = document.querySelectorAll(".vfx-capability-section");
    Array.prototype.forEach.call(sections, function (section) {
      if (
        section.querySelector(".vfx-3videos-wrap") &&
        section.querySelector(".vfx-posters-wrap")
      ) {
        initShotSwitcher(section);
      } else {
        initBaViewport(section);
      }
    });
  }

  if (document.readyState === "complete") {
    setTimeout(boot, 0);
  } else {
    window.addEventListener("load", boot, { once: true });
  }
})();
</script>
</div><div class="big-menu-wrap is-center"><div class="vfx-anchor-link-menu is-white"><a href="#" class="vfx-anchor-link is-light w-inline-block"><div>Native Resolution</div></a><a href="#" class="vfx-anchor-link is-light w-inline-block"><div>Refine</div></a><a href="#" class="vfx-anchor-link is-light w-inline-block"><div>Restore</div></a><a href="#" class="vfx-anchor-link is-light w-inline-block"><div>SDR to HDR</div></a><a href="#" class="vfx-anchor-link is-light w-inline-block"><div>HDR Native</div></a><a href="#" class="vfx-anchor-link is-light w-inline-block"><div>Layout to Render</div></a><a href="#" class="vfx-anchor-link is-light w-inline-block"><div>AlphaGen</div></a></div></div><section id="vfx-cap-05" data-vfx-cap-index="4" data-vfx-cap="tiled-8k-workflow" class="vfx-capability-section is-sticky-1"><div class="vfx-grid"><div class="vfx-grid-left-col"><p class="vfx-index-number">01</p><div class="vfx-capability-copy"><h2 class="vfx-heading max-width-10ch">Native Resolution</h2><div class="spacer-1rem"></div><h3 class="text-size-xlarge text-weight-light text-balanced">Work at full delivery resolution on one GPU. No downscaling, no proxy round-trip, and barely any increase in VRAM consumption.</h3><div class="spacer-3rem cc-1-5-on-mobile"></div><div class="buttons-wrap is-mobile-100"><a href="https://github.com/Lightricks/ComfyUI-LTXVideo/blob/master/example_workflows/2.5/LTX-2.5_V2V_TiledFusion_Native_4K_8K.json" target="_blank" class="rsvp-cta is-black is-smaller">Get Workflow ↗</a><a href="https://docs.ltx.io/open-source-model/vfx-post-production/native-resolution" target="_blank" class="rsvp-cta is-stroke is-smaller">Documentation ↗</a></div></div></div><div class="vfx-grid-right-col"><div class="vfx-grid-right-inner-wrap vfx-capability-asset"><div class="vfx-3videos-wrap is-1x1"><div data-ba-after="4K Output" data-ba-before="4K Input" class="vfx-video-slider-wrap is-1"><div class="vfx-after-video is-1x1"><div class="feature-card-wrap with-video-controls is-1x1"><div class="video-facade"><img sizes="(max-width: 1919px) 100vw, 1920px" srcset="https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db53d0c3d24bb6d52e7_native-resolution-new-after-p-500.webp 500w, https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db53d0c3d24bb6d52e7_native-resolution-new-after-p-800.webp 800w, https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db53d0c3d24bb6d52e7_native-resolution-new-after-p-1080.webp 1080w, https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db53d0c3d24bb6d52e7_native-resolution-new-after-p-1600.webp 1600w, https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db53d0c3d24bb6d52e7_native-resolution-new-after.webp 1920w" alt="Vintage car driving on a desert road toward red mesas — native resolution example" src="https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db53d0c3d24bb6d52e7_native-resolution-new-after.webp" loading="lazy" class="feature-poster-img cc-1x1"/></div><div class="video-container"><div class="feature-card-video cc-1x1 w-embed"><video
  class="lazy-load feature-video-src"
  preload="none"
  muted
  playsinline
  loop
  autoplay
  style="width:100%; height:100%; object-fit:cover;"
>
  <!-- after video -->
  <source
    data-src="https://videos.ltx.io/LTX-2/vfx/05-native-resolution/native-resolution-new-after.mp4"
        type="video/mp4"
  />
  </video></div></div></div></div><div class="vfx-before-video is-1x1"><div class="feature-card-wrap is-1x1"><div class="video-facade"><img sizes="(max-width: 1919px) 100vw, 1920px" srcset="https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db54c013ea3cabdc01a_native-resolution-new-before-p-500.webp 500w, https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db54c013ea3cabdc01a_native-resolution-new-before-p-800.webp 800w, https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db54c013ea3cabdc01a_native-resolution-new-before-p-1080.webp 1080w, https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db54c013ea3cabdc01a_native-resolution-new-before-p-1600.webp 1600w, https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db54c013ea3cabdc01a_native-resolution-new-before.webp 1920w" alt="LTX-2.3 Better Prompt Adherence" src="https://cdn.prod.website-files.com/68872d15af29880764eac4aa/6aba7db54c013ea3cabdc01a_native-resolution-new-before.webp" loading="lazy" class="feature-poster-img cc-1x1"/></div><div class="video-container"><div class="feature-card-video cc-1x1 w-embed"><video
  class="lazy-load feature-video-src"
