<h2 id="rate-limits">Rate limits <span id="h-07a1b2c3d5"></span></h2>
<section data-tag="tabbed-content-box" outputclass="tabbed-content-box" id="sec-tabs-2" class="tabbed-content-box section"><section id="china-beijing-2" class="section"><h4 id="china-beijing-2-h4">China (Beijing)</h4><table style="display:table;table-layout:fixed;width:100%"><colgroup><col style="width:50%"/><col style="width:50%"/></colgroup><thead><tr><th><p>Parameter</p></th><th><p>Value</p></th></tr></thead><tbody><tr><td><p>RPM (Requests per minute)</p></td><td><p>300</p></td></tr></tbody></table></section><section id="singapore-2" class="section"><h4 id="singapore-2-h4">Singapore</h4><p>Deployment scope: International</p><table style="display:table;table-layout:fixed;width:100%"><colgroup><col style="width:50%"/><col style="width:50%"/></colgroup><thead><tr><th><p>Parameter</p></th><th><p>Value</p></th></tr></thead><tbody><tr><td><p>RPM (Requests per minute)</p></td><td><p>300</p></td></tr></tbody></table></section><section id="japan-tokyo-2" class="section"><h4 id="japan-tokyo-2-h4">Japan (Tokyo)</h4><p>Deployment scope: Global</p><table style="display:table;table-layout:fixed;width:100%"><colgroup><col style="width:50%"/><col style="width:50%"/></colgroup><thead><tr><th><p>Parameter</p></th><th><p>Value</p></th></tr></thead><tbody><tr><td><p>RPM (Requests per minute)</p></td><td><p>300</p></td></tr></tbody></table></section><section id="germany-frankfurt-2" class="section"><h4 id="germany-frankfurt-2-h4">Germany (Frankfurt)</h4><p>Deployment scope: Global</p><table style="display:table;table-layout:fixed;width:100%"><colgroup><col style="width:50%"/><col style="width:50%"/></colgroup><thead><tr><th><p>Parameter</p></th><th><p>Value</p></th></tr></thead><tbody><tr><td><p>RPM (Requests per minute)</p></td><td><p>300</p></td></tr></tbody></table></section><section id="us-virginia-2" class="section"><h4 id="us-virginia-2-h4">US (Virginia)</h4><p>Service scope: Global</p><table style="display:table;table-layout:fixed;width:100%"><colgroup><col style="width:50%"/>