                 <math id="alg1.l7.m1" class="ltx_Math" alttext="\mathrm{Score}_{r}=\frac{1}{N-1}\sum_{\begin{subarray}{c}i=1\\
j\neq i\end{subarray}}^{N}[\bar{K}_{b}\bar{K}_{b}^{\top}]_{ij}\in\mathbb{R}^{h\times 1\times B}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Score</mi><mi>r</mi></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd><mrow><mi>j</mi><mo>≠</mo><mi>i</mi></mrow></mtd></mtr></mtable><mi>N</mi></msubsup><msub><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>K</mi><mo>¯</mo></mover><mi>b</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>K</mi><mo>¯</mo></mover><mi>b</mi><mo>⊤</mo></msubsup></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>h</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mi>B</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathrm{Score}_{r}=\frac{1}{N-1}\sum_{\begin{subarray}{c}i=1\\
j\neq i\end{subarray}}^{N}[\bar{K}_{b}\bar{K}_{b}^{\top}]_{ij}\in\mathbb{R}^{h\times 1\times B}</annotation></semantics></math> {K-K block-wise redundancy}

</div>
<div id="alg1.l8" class="ltx_listingline">
