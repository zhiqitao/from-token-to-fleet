<td id="S6.T8.5.1.1.6" class="ltx_td ltx_align_center ltx_border_tt">Avg Time/Step</td></tr>
<tr id="S6.T8.5.1.2" class="ltx_tr">
<td id="S6.T8.5.1.2.1" class="ltx_td ltx_align_center ltx_border_t">T2V</td>
<td id="S6.T8.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">480p (480 <math id="S6.T8.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> 848)</td>
<td id="S6.T8.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">121</td>
<td id="S6.T8.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">✗</td>
<td id="S6.T8.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t">13.90</td>
<td id="S6.T8.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t">0.2781</td></tr>
