<div id="S4.T2.7.2.6.1.1" class="ltx_block ltx_minipage ltx_align_middle" style="width:51.2pt;"><span class="ltx_inline-block"><svg id="S4.T2.pic4" class="ltx_picture" height="4.77" overflow="visible" version="1.1" viewBox="0 0 4.77 4.77" width="4.77"><g style="--ltx-stroke-color:#F0D695;--ltx-fill-color:#F0D695;--ltx-fg-color:#F0D695;" color="#F0D695" fill="#F0D695" stroke="#F0D695" stroke-width="0.4pt" transform="translate(0,4.77) matrix(1 0 0 -1 0 0) translate(2.38,0) translate(0,2.38)"><path style="stroke:none" d="M 0 0 M 2.38 0 C 2.38 1.32 1.32 2.38 0 2.38 C -1.32 2.38 -2.38 1.32 -2.38 0 C -2.38 -1.32 -1.32 -2.38 0 -2.38 C 1.32 -2.38 2.38 -1.32 2.38 0 Z M 0 0"></path></g></svg></span>
<p id="S4.T2.7.2.6.1.1.1" class="ltx_p ltx_align_center"><span id="S4.T2.7.2.6.1.1.1.1" class="ltx_text" style="font-size:80%;">Imaging Quality</span></p>
</div>
</span></div></td>
