    background: currentColor;
  }
</style>
<!-- ✅ END: Footer link underline --></div><div class="footer-theme-exclude w-embed w-script"><!-- ✅ START: Footer-only theme exclude -->
<script>
  /* Adds data-theme-exclude="true" only inside the footer component where this embed is placed.
     document.currentScript is captured before DOMContentLoaded (it is null inside the listener),
     and the footer is matched with or without the Shared Library ltx-- prefix. */
  (function () {
    const currentScript = document.currentScript;
    const FOOTER_SELECTOR = '.footer-section, .ltx--footer-section';

    function markFooter() {
      const footer =
        (currentScript && (currentScript.closest(FOOTER_SELECTOR) || currentScript.closest('footer'))) ||
        document.querySelector(FOOTER_SELECTOR);

      if (!footer) return;

      footer.setAttribute('data-theme-exclude', 'true');
      footer.querySelectorAll('*').forEach((element) => {
        element.setAttribute('data-theme-exclude', 'true');
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', markFooter);
    } else {
      markFooter();
    }
  })();
</script>
<!-- ✅ END: Footer-only theme exclude -->
