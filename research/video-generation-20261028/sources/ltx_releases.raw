le.ltx.io" data-theme-exclude="" data-cta-navigation="https://console.ltx.io" data-analytics-prop-location="navbar" data-wf--ltx-but-stroke-small--variant="base" target="_blank" class="ltx-but-base is-small a-cta w-button">Get API Key</a><link rel="prefetch" href="https://console.ltx.io"/><a href="/forms/ltx-contact-sales?kpi=licensing&amp;placement=topmenu" data-theme-exclude="" data-cta-navigation="/forms/ltx-contact-sales?kpi=licensing&amp;placement=topmenu" data-analytics-prop-location="contact_sales" data-wf--ltx-but-white-small--variant="base" target="_blank" class="ltx-but-base is-small is-black a-cta w-button">Talk to Sales</a><link rel="prefetch" href="/forms/ltx-contact-sales?kpi=licensing&amp;placement=topmenu"/></div><div data-w-id="ae937c43-41ce-2f8e-ff36-d9115e5d22f2" class="navbar1_menu-button-2 w-nav-button"><div class="menu-parent"><div class="menu-icon1_line-top is-dark"></div><div class="menu-icon1_line-middle is-dark"><div class="menu-icon1_line-middle-inner"></div></div><div class="menu-icon1_line-bottom is-dark-mode"></div></div></div></div></div></div></div><div class="main-wrapper _2-z-index"><header class="ltx-section _2-z-index"><div class="padding-global"><div class="padding-section-6rem _2-on-mobile"><div id="download-ltx-desk" class="model-hero-text-wrapper"><div class="h1-parent"><h1 class="io-hero-h1 is-balanced max-width-16ch">LTX release notes</h1></div><div class="spacer-1rem"></div><div class="max-width-54rem"><p class="io-hero-sub is-capability-title text-balanced text-align-center">Stay up-to-date with the latest features, updates, and fixes—designed to keep your creative workflow seamless.</p></div></div></div></div></header><div animate-theme-to="" class="theme-trigger"></div><div id="release-notes-list" class="ltx-section cc-light"><div class="padding-global"><div class="container-60rem"><div class="padding-section-6rem custom-release-notes"><div class="release-notes_content"><div class="pricing-code-toggle w-embed"><style>
  .pricing-toggle-animation {
    position: absolute;
    left: 0;
    transition: transform 0.2s ease-in;
  }

  .pricing-filter-wrapper:has(.pricing-radio-button-field:nth-last-child(1) input[type="radio"]:checked) .pricing-toggle-animation {
    transform: translateX(100%);
  }
</style></div><div class="release-notes_form-block w-form"><form id="email-form" name="email-form" data-name="Email Form" method="get" data-wf-page-id="6a158e0da302659c0f75578a" data-wf-element-id="bdb5b0aa-6a0d-e2be-617e-7346e310448f"><div class="pricing-filters cc-release-notes"><div class="pricing-filter-content"><div r-filter="type" class="release-notes_filter-wrapper"><div class="pricing-toggle-animation cc-release-notes cc-v2"></div><label class="pricing-radio-button-field cc-release-notes w-radio"><div class="w-form-formradioinput w-form-formradioinput--inputType-custom pricing-radio-button cc-release-notes w-radio-input"></div><input type="radio" data-name="product-type" id="open-source" name="product-type" data-filter="Open source" style="opacity:0;position:absolute;z-index:-1" value="open-source"/><span class="pricing-filter-name cc-release-notes w-form-label" for="open-source">Open Source</span></label><label class="pricing-radio-button-field cc-release-notes w-radio"><div class="w-form-formradioinput w-form-formradioinput--inputType-custom pricing-radio-button cc-release-notes w-radio-input"></div><input type="radio" data-name="product-type" id="api" name="product-type" data-filter="API" style="opacity:0;position:absolute;z-index:-1" value="api"/><span class="pricing-filter-name cc-release-notes w-form-label" for="api">API</span></label><label class="pricing-radio-button-field cc-release-notes w-radio"><div class="w-form-formradioinput w-form-formradioinput--inputType-custom pricing-radio-button cc-release-notes w-radio-input"></div><input type="radio" data-name="product-type" id="studio" name="product-type" data-filter="Studio" style="opacity:0;position:absolute;z-index:-1" value="studio"/><span class="pricing-filter-name cc-release-notes w-form-label" for="studio">Studio</span></label></div></div></div></form><div class="w-form-done"><div>Thank you! Your submission has been received!</div></div><div class="w-form-fail"><div>Oops! Something went wrong while submitting the form.</div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="draw-underline-blog-links w-embed"><!-- INLINE LINK: Draw Underline (Desktop Only, No Double Underline) -->
<style>
  /*
    Goal:
    - Desktop only: animated underline via ::after
    - Tablet/mobile: keep Webflow default underline
    - Prevent double underline on desktop by overriding text-decoration
  */

  /* Tablet/mobile: keep native underline, remove pseudo underline */
  @media (max-width: 991px) {
    :where(.inline-draw-underline, .release-notes_rich-text a) {
      text-decoration: underline !important;
    }
    :where(.inline-draw-underline, .release-notes_rich-text a)::after {
      content: none !important;
    }
  }

  /* Desktop only: animated underline */
  @media (min-width: 992px) and (hover: hover) and (pointer: fine) {
    :where(.inline-draw-underline, .release-notes_rich-text a) {
      position: relative;
      color: inherit;
      text-decoration: none !important; /* critical: prevent double underline */
    }

    :where(.inline-draw-underline, .release-notes_rich-text a)::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -2px;
      height: 1px;
      background: currentColor;
      transform: scaleX(1);
      transform-origin: left;
      transition: transform 0.3s ease;
      pointer-events: none;
    }

    :where(.inline-draw-underline, .release-notes_rich-text a):is(:hover, :focus)::after {
      transform: scaleX(0);
      transform-origin: right;
    }
  }
</style>
<!-- End INLINE LINK: Draw Underline (Desktop Only, No Double Underline) --></div><div class="release-notes_collection-list-wrapper w-dyn-list"><div r-filter-wrapper="1" role="list" class="release-notes_collection-list w-dyn-items"><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">October 13, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">LTX Trainer in LTX Explore</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>LTX Trainer now has a new, easier way to get started. Train a custom Character or Style LoRA directly in LTX Explore, with no GPU setup or development work required.</p><ul role="list"><li>Choose whether to train a Character or Style LoRA, then upload your assets.</li><li>Review clips flagged by automatic quality checks before training.</li><li>Let training run in the background and get an email when your LoRA is ready.</li><li>Test your LoRA in Explore or download it for use in your own workflow.</li></ul><p>The open-source LTX Trainer workflow is still available for those who prefer to run it themselves.</p><p>‍</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">October 9, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">LTX Desktop</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>A major update to LTX Desktop makes it easier to create, refine, and manage video projects locally, with new creative capabilities, more flexible generation workflows, and a redesigned experience.Key details:</p><ul role="list"><li><strong>New creative capabilities:</strong> 13 built-in LoRAs, plus IC-LoRAs for AlphaGen, Deblur, Colorization, Clean Plate, Decompression, Water Simulation, Day to Night, Restore and Layout to Render. The update also adds Retake, Extend, and improved prompt enhancement.</li><li><strong>More control:</strong> Choose fast-preview resolutions and use seed control for consistent results across generations</li><li><strong>Remote generation:</strong> Generate on your desktop and monitor sessions from a mobile device or another browser on the same Wi-Fi network</li><li><strong>Batch generation:</strong> Queue multiple generations to run in the background, then reorder or cancel jobs at any time</li><li><strong>Redesigned experience:</strong> A new homepage, quick search, an updated Explore form with gallery cards, an asset library, and a batch-generation queue</li><li><strong>Simpler setup:</strong> An improved installation process, better first-run onboarding, clearer system requirements, and new settings pages with model management</li></ul><p>‍</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">October 2, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">LTX for Post-Production</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Six new and upgraded capabilities give post-production teams more control over compositing, color, detail, and resolution, with outputs they can keep shaping throughout the pipeline.</p><p><strong>Built for Compositing</strong></p><ul role="list"><li><strong>Alpha Gen:</strong> Generates alpha mattes with soft edges and fine detail, preserving hair, smoke, and partial transparency for compositing.</li><li><strong>Layout to Render:</strong> Generates a polished render from 3D blocking with a prompt or reference image, maintaining camera, composition, and frame alignment.</li></ul><p><strong>Built for Color and Dynamic Range</strong></p><ul role="list"><li><strong>HDR Native:</strong> Takes 16-bit EXR in and returns 16-bit EXR out through an ACES workflow, preserving the color and dynamic range of the input footage so output arrives ready to grade rather than flattened.</li><li><strong>SDR to HDR (Upgraded):</strong> Expands 8-bit SDR footage into 16-bit EXR in scene-linear ACEScg, ready to grade in a color-managed pipeline or encode for HDR displays.</li></ul><p><strong>Built for Detail and Resolution</strong></p><ul role="list"><li><strong>Native Resolution:</strong> Processes footage at full delivery resolution on a single GPU. VRAM consumption increases only slightly as resolution climbs.</li><li><strong>Refine &amp; Restore:</strong> Improves clarity and detail in archival or low-quality footage. Combine with the Native Resolution workflow to reach 8K and beyond.</li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">October 1, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Built for Compositing</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><ul role="list"><li><strong>Layout to Render:</strong> Generates a polished render from 3D blocking with a prompt or reference image, maintaining camera, composition, and frame alignment.</li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">September 30, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Built for Color and Dynamic Range</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><ul role="list"><li><strong>HDR Native:</strong> Takes 16-bit EXR in and returns 16-bit EXR out through an ACES workflow, preserving the color and dynamic range of the input footage so output arrives ready to grade rather than flattened.</li><li><strong>SDR to HDR (Upgraded):</strong> Expands 8-bit SDR footage into 16-bit EXR in scene-linear ACEScg, ready to grade in a color-managed pipeline or encode for HDR displays.</li></ul><p>‍</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">September 29, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Built for Detail and Resolution</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><ul role="list"><li><strong>Native Resolution:</strong> Processes footage at full delivery resolution on a single GPU. VRAM consumption increases only slightly as resolution climbs.</li><li><strong>Refine: </strong>An IC-LoRA that improves sharpness in blurry or pixelated footage. Combine with the 8K workflow to upscale to 8K and beyond.</li><li><strong>Restore: </strong>An IC-LoRA that adds vibrant color and modernizes archival or faded video. Combine with the 8K workflow to reach 8K and beyond.</li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">August 11, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">LTX-2.5 API</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p><strong>Native Multishot · Diffusion Fidelity Rendering · Pretrained Checkpoint</strong></p><p><strong>Built for Real Production</strong></p><ul role="list"><li><strong>Diffusion Fidelity Rendering </strong>—<strong> </strong>allocates compute by scene complexity and budget instead of locking every scene to one compression rate, rendering flawless detail where it matters and staying efficient everywhere else. </li><li><strong>Native EXR Workflow </strong>—<strong> </strong>reads and writes cinema-grade EXR in ACES and DaVinci Wide Gamut while preserving dynamic range, metadata, and color.</li><li><strong>Diffusion Video Decoder </strong>— diffusion-based reconstruction for sharper faces, legible text and signage, and fewer motion artifacts.</li><li><strong>Larger Dataset + RL Post-Training </strong>— broader filtered training and RL aligned to human preference improve take rate and reduce repeated failure modes.</li></ul><p><strong>Built to Hold a World Together</strong></p><ul role="list"><li><strong>Native Multishot </strong>— generates multiple connected shots while preserving character, environment, lighting, voice, style, and continuity across cuts.</li><li><strong>Custom Gemma 4 12B Text Encoder </strong>— improved retention of complex prompts with multiple subjects, actions, lighting, and camera direction.</li><li><strong>Dedicated Prompt Enhancer </strong>— expands short prompts into richer cinematic, temporal, and contextual instructions at near-zero extra compute.</li><li><strong>Auto Duration </strong>— predicts clip length from scene content before generation.</li></ul><p><strong>Built to Scale</strong></p><ul role="list"><li><strong>Substantially Better Distilled Model </strong>— improved distillation carries far more of the full model&#x27;s quality, prompt adherence, and motion into a smaller, faster model.</li></ul></div><a href="https://ltx.io/model/api" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">August 11, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">LTX-2.5</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p><strong>Native Multishot · Diffusion Fidelity Rendering · Pretrained Checkpoint</strong></p><p><strong>Built for Real Production</strong></p><ul role="list"><li><strong>Diffusion Fidelity Rendering </strong>—<strong> </strong>allocates compute by scene complexity and budget instead of locking every scene to one compression rate, rendering flawless detail where it matters and staying efficient everywhere else. </li><li><strong>Native EXR Workflow </strong>—<strong> </strong>reads and writes cinema-grade EXR in ACES and DaVinci Wide Gamut while preserving dynamic range, metadata, and color.</li><li><strong>Diffusion Video Decoder </strong>— diffusion-based reconstruction for sharper faces, legible text and signage, and fewer motion artifacts.</li><li><strong>Larger Dataset + RL Post-Training </strong>— broader filtered training and RL aligned to human preference improve take rate and reduce repeated failure modes.</li></ul><p><strong>Built to Hold a World Together</strong></p><ul role="list"><li><strong>Native Multishot </strong>— generates multiple connected shots while preserving character, environment, lighting, voice, style, and continuity across cuts.</li><li><strong>Custom Gemma 4 12B Text Encoder </strong>— improved retention of complex prompts with multiple subjects, actions, lighting, and camera direction.</li><li><strong>Dedicated Prompt Enhancer </strong>— expands short prompts into richer cinematic, temporal, and contextual instructions at near-zero extra compute.</li><li><strong>Auto Duration </strong>— predicts clip length from scene content before generation.</li></ul><p><strong>Built to Be Modified</strong></p><ul role="list"><li><strong>Pretrained Checkpoint for Deep Adaptation </strong>— raw, non-SFT checkpoint for aggressive fine-tuning across custom domains and objectives.</li><li><strong>Cleaner Permissive Licensing</strong> — reduced restrictive third-party dependencies for a clearer path to fine-tune, deploy, commercialize, and redistribute.</li></ul><p><strong>Built to Scale</strong></p><ul role="list"><li><strong>Substantially Better Distilled Model </strong>— improved distillation carries far more of the full model&#x27;s quality, prompt adherence, and motion into a smaller, faster model.</li></ul></div><a href="https://ltx.io/model/ltx-2-5" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">July 20, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">LTX Explore: All the Power of LTX. None of the Setup.</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>LTX Explore is a self-service platform that makes advanced video production accessible to anyone. No API integration. No technical setup. No engineering required. Just instant access to LTX&#x27;s full capabilities through a simple, direct interface.</p><p>‍</p><p><strong>30+ Production-Ready Capabilities</strong></p><p>Access to what LTX can do: generation, post-production, audio processing, creative controls,</p><p>styles, effects, camera motion and more. </p><p>‍</p><p><strong>One Prompt. One Click.</strong></p><p>Every capability is accessible to your entire team—creatives, designers, marketers, producers—not just engineers. Write a prompt, click generate, iterate instantly. No code. No infrastructure. No learning curve.</p><p>‍</p><p><strong>Community-Driven Expansion</strong></p><p>New LoRAs and IC-LoRAs are added every week, created by the LTX team and a global community of creators. Each new asset is a new capability. Your access expands automatically without any action required from you.</p><p>‍</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">July 13, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Video Outpainting API</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Production-grade video reframing through the LTX API.outpaint videos to new aspect ratios while preserving the original frame, motion, composition, and scene consistency. The model generates only the newly exposed regions beyond the original frame.</p><p><strong>What Ships:</strong></p><ul role="list"><li>Reframe API endpoint</li><li>Native 1080p output</li><li>Support for videos up to 60 seconds</li></ul><p><strong>Aspect ratio support:</strong></p><ul role="list"><li>1:1 (720×720, 1080×1080)</li><li>4:5 (720×900, 1080×1350)</li><li>5:4 (900×720, 1350×1080)9:16 (720×1280, 1080×1920)</li><li>16:9 (1280×720, 1920×1080)</li></ul><p><strong>Key Capabilities:</strong></p><ul role="list"><li>Expands beyond the original frame without modifying existing pixels</li><li>Generates only the newly exposed regions</li><li>Preserves composition, motion, text, logos, and visual consistency</li><li>Stable across large aspect ratio changes</li><li>Designed for production workflows and pipeline integration</li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">June 17, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">LTX Trainer — Unified Training Framework</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Major upgrade to LTX Trainer, the open-source training framework for LTX. Introduces unified training across video, audio, cross-modal, and reference-conditioned workflows, plus agentic configuration generation for LoRA and IC-LoRA training.</p><p>‍</p><p><strong>Training Modes</strong></p><p>Video</p><p>• T2V</p><p>• I2V</p><p>• Video extension (forward + backward)</p><p>• Inpainting</p><p>• Outpainting</p><p>‍</p><p>Audio</p><p>• T2A</p><p>• Audio extension (forward + backward)</p><p>• Audio inpainting</p><p>‍</p><p>Cross-modal</p><p>• A2V</p><p>• V2A</p><p>‍</p><p>Reference (IC-LoRAs)</p><p>• V2V</p><p>• A2A</p><p>• AV2AV</p><p>‍</p><p><strong>Composable Conditioning</strong></p><p>Combine references, masks, first frames, prefixes, suffixes, audio, and video signals within a single training workflow.</p><p>Supports advanced workflows including AV2AV IC-LoRA, audio inpainting, reference-conditioned training, and custom multimodal pipelines.</p><p>‍</p><p><strong>Agentic Training</strong></p><p>A new agentic skill helps you generate LoRA and IC-LoRA training configurations through Claude and other LLM-based agents using natural language instructions.</p><p>‍</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">May 11, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Video to Video </h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Three control modes. Infinite creative directions. Video to Video lets you lock in the structure that works — pose, depth, or edges — and transform the style completely. Upload a reference, choose your mode, and generate with precision.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">May 4, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">ChatGPT Image 2.0</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>ChatGPT Image 2.0 is now live in LTX Studio. More detail, more accuracy, more creative control, all without leaving your workflow. Create exactly what you imagine — down to the last detail.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">May 3, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Async API expanded to all video generation endpoints (Beta)</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>New async endpoints: [.url-highlight]/v2/text-to-video[.url-highlight], [.url-highlight]/v2/image-to-video[.url-highlight], [.url-highlight]/v2/audio-to-video[.url-highlight], [.url-highlight]/v2/retake[.url-highlight], [.url-highlight]/v2/extend[.url-highlight]. Submit a job, poll for status, download from result.video_url when complete.</p><p>See <a href="https://docs.ltx.video/async-jobs">Async Jobs</a> for more details.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 27, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Canvas</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Canvas introduces a collaborative infinite workspace in LTX Studio, where teams can generate, iterate, and align on concpets in real time or async, without switching tools. Combine image and video moodboards, visual ideation, and team collaboration in one place, and move seamlessly from concept to production.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 24, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Seedance 2.0</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Seedance 2.0 is now available in LTX Studio. One of the most capable video generation models available brings sharper motion, stronger prompt adherence, and more cinematic output, all inside your existing LTX Studio workflow. Generate with precision and take your productions further without switching platforms.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 23, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">HDR Video Conversion (Beta)</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>New [.url-highlight]/v2/video-to-video-hdr[.url-highlight] endpoint for converting SDR videos to HDR. Returns per-frame EXR images suitable for professional color grading and HDR rendering pipelines.</p><p>Introducing Async API support: submit a job, poll for status, download when complete. Currently only the HDR endpoint is supported; more endpoints will follow soon. See <a href="https://docs.ltx.video/async-jobs">Async Jobs.</a></p></div><a href="https://docs.ltx.video/api-documentation/api-reference/async-video-generation/submit-video-to-video-hdr" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 23, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">SDR to HDR</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>SDR to HDR turns any existing video into true High Dynamic Range - instantly. Richer colors, brighter highlights, and deeper shadows are added automatically, with no reshooting or manual grading required. Professional-quality output, ready for modern screens and production workflows, in seconds.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 22, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Video Upscale</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Upscale takes any video, generated or uploaded, to 4K or 8K resolution directly in LTX Studio. With Topaz-powered models and full control over resolution and frame rate, you go from quick draft to broadcast-ready master without switching tools or starting over.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 16, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Editing Space</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Editing Space brings all image editing tools into one unified environment inside LTX Studio. Brush any area and edit it directly by prompt, upscale with full slider controls across quality and speed, shift camera perspective across Rotation, Tilt, and Distance without prompting, and fine-tune light, color, and effects in real time - all in one continuous flow, without switching tabs or searching for what you need next.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 16, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Veo 3.1 Lite</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Veo 3.1 Lite is now available in LTX Studio - Google׳s most cost-effective generation model, built for teams that need to move fast and scale without the cost overhead.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 16, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Veo 3.1 Fast Price Update</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Veo 3.1 Fast just got more accessible. We&#x27;ve reduced the price, so teams can generate high-quality video at speed without the cost holding them back. More generation, same fast results.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 15, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">HDR Video Generation (IC-LoRA)</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>[.model-v-highlight]LTX-2.3[.model-v-highlight]</p><p>New IC-LoRA trained on LTX-2.3-22b enabling 16-bit High Dynamic Range generation — supports both T2V/I2V generation natively in HDR, and SDR-to-HDR video conversion.</p><p><a href="https://huggingface.co/Lightricks/LTX-2" target="_blank">‍</a>Key details:</p><ul role="list"><li>Full ACES color standard support; output is float16 EXR, scene-linear, ready for professional post-production workflows including re-exposure and complex color timing</li><li>ComfyUI integration out of the box, and available via API as a video2video endpoint </li><li>Backed by a research paper: <em>LumiVid: HDR Video Generation via Latent Alignment with Logarithmic Encoding</em></li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 15, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Auto Top-Up</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>You can now configure auto top-up to automatically purchase credits when your balance falls below a threshold. Set a threshold and top-up amount, and the system handles the rest — no more manual credit purchases to keep your API running.</p></div><a href="https://docs.ltx.video/auto-top-up" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 15, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Video Editor Upgrades</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>LTX Studio&#x27;s editor just got a major upgrade. Eight native controls - transitions, blending modes, speed, reverse, layer opacity, and more, bring production-ready editing into the same platform where you generate and build. No tab-switching. No third-party tools. Just one complete creative workflow.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">March 26, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">22B Model · Native Audio · Portrait Video · Desktop Editor</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>[.model-v-highlight]LTX-2.3[.model-v-highlight]</p><h3>Model</h3><ul role="list"><li>New 22-billion parameter architecture (upgraded from 19B)</li><li>Generates synchronized audio and video in a single forward pass</li><li>Up to 4K resolution at 50 FPS, up to 20 seconds per clip</li><li>Desktop Editor under Apache 2.0 license — fully open weights, commercial use allowed</li></ul><h3>Visual Quality</h3><ul role="list"><li>Redesigned high-fidelity VAE — sharper edges, hair, fabric grain, chrome highlights</li><li>Reduced texture drift across longer sequences</li><li>Improved image-to-video quality and motion coherence</li><li>Fixed Ken Burns over-application in image-to-video mode</li></ul><h3>Audio</h3><ul role="list"><li>Upgraded HiFi-GAN vocoder for cleaner, higher-quality output</li><li>Stereo audio at 24 kHz</li><li>Improved audio reliability and coherence with visual content</li></ul><h3>New Features</h3><ul role="list"><li>Native portrait (9:16) vertical video — no more cropping workarounds</li><li>24 and 48 FPS output options</li><li>Last-frame interpolation support</li><li>Spatial and temporal upscalers for enhanced detail and smoothness</li><li>Desktop video editor for local generation on consumer hardware</li></ul><h3>Prompt Understanding</h3><ul role="list"><li>4× larger text connector for significantly better prompt adherence</li><li>Improved multi-element scene handling</li><li>Reduced prompt drift in later frames</li></ul><h3>LoRA Adapters Released</h3><ul role="list"><li>LTX-2.3-22b-IC-LoRA-Motion-Track-Control</li><li>LTX-2.3-22b-IC-LoRA-Union-Control (depth, pose, canny)</li><li>LTX-2-19b-IC-LoRA-Detailer (also compatible with 2.3)</li></ul><h3>Model Checkpoints</h3><p>[.url-highlight]ltx-2.3-22b-dev.safetensors[.url-highlight] [.url-highlight]ltx-2.3-22b-distilled.safetensors[.url-highlight]</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">March 5, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">LTX-2.3</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Introducing LTX-2.3 — a major leap in quality and speed for AI video generation. LTX-2.3 is now the default model across the API, available in two variants:</p><ul role="list"><li><strong>LTX-2.3 Pro</strong> ([.url-highlight]ltx-2-3-pro[.url-highlight]) — best-in-class quality, supports all endpoints including audio-to-video, retake, and extend.</li><li><strong>LTX-2.3 Fast</strong> ([.url-highlight]ltx-2-3-fast[.url-highlight] — blazing fast generation, supports text-to-video and image-to-video.</li></ul><h3>What’s new</h3><ul role="list"><li><strong>Sharper fine details</strong> — new latent space with an updated VAE delivers noticeably crisper output.</li><li><strong>Cleaner audio</strong> — improved data filtering reduces background noise and artifacts.</li><li><strong>Stronger image-to-video</strong> — more natural motion, fewer static clips, and better visual consistency.</li><li><strong>Better prompt understanding</strong> — improved text connector architecture for closer adherence to complex prompts.</li><li><strong>Last-frame interpolation</strong> — provide a first and last frame to the image-to-video endpoint, and the model generates the video in between.</li><li><strong>Portrait video support</strong> — native 9:16 vertical video generation across all resolutions.</li><li><strong>24/48 FPS</strong> — new frame rate options alongside the existing 25/50 FPS.</li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">March 3, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Dubbing and Captions</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Dubbing and Captions introduce built-in localization tools to LTX Studio, enabling teams to adapt a single video across multiple languages and markets within the same workflow.Generate once and localize seamlessly with synchronized dubbing and accurate captions, no external tools or vendors required. Available for Enterprise users only.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">March 3, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Motion Control</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Motion Control introduces reference-based motion transfer directly inside the Gen Space. Upload a reference video and apply full-body movement and gestures to your character with high accuracy and consistency.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">March 1, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Nano Banana 2</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Nano Banana 2 (Gemini 3.1 Flash Image) combines pro-level intelligence with lightning-fast image generation. Quickly turn concepts into polished visuals, maintain consistency across multiple iterations, generate precise and legible text for any asset, and create diagrams, storyboards, or data visualizations seamlessly.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">February 22, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Kling 3.0 Pro</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Kling 3.0 Pro, Kuaishou’s most advanced AI video model to date, is now available in LTX Studio.It brings cinematic-quality text-to-video and image-to-video generation, with longer videos up to 15 seconds, smoother motion, and stronger visual consistency. Designed to support richer storytelling and more expressive creative output, Kling 3.0 Pro gives creators even more flexibility to turn ideas into high-impact video — directly within LTX Studio.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">February 18, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Extend Video Endpoint</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>New [.url-highlight]v1/extend[.url-highlight] endpoint for <a href="https://ltx.io/model/capabilities/extend">extending video duration</a> by generating additional frames at the beginning or end.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">February 11, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Brand Kit</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Brand Kit is now available for Enterprise customers, giving teams a centralized way to manage brand identities across LTX Studio. Creative Admins can define brand guidelines with logos, styles, fonts, products and more, as Elements and publish them for consistent use across projects, with project-level permissions to keep teams on-brand at scale.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">February 10, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Custom Styles as an Element</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Define your visual style once and use it across your entire project. Save Custom Styles as Elements to turn real visual references into reusable aesthetics that guide every generation—keeping results consistent and on-brand, without complex text prompts.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">January 29, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Logos &amp; Fonts as Elements</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Brand consistency starts with saved assets. Upload logos and fonts as Elements, then apply them instantly across all generated images in your project. Maintain exact brand specifications, eliminate manual uploads, and ensure visual consistency from initial concepts through final delivery.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">January 27, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Brush</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Meet Brush - a more intuitive way to edit images. By marking a specific area and guiding the change with a simple text prompt, you can make precise, focused edits exactly where they matter. Remove, add, or refine elements with greater control and speed, across all image models.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">January 22, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Z-Image</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Alibaba&#x27;s Tongyi Lab brings Z-Image, a speed-optimized text-to-image model, directly into LTX Studio&#x27;s Gen Space. Generate photorealistic visuals with precise prompt control, maintain consistent results across iterations, and deliver high-quality images faster. Available on all tiers.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">January 20, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Audio-to-Video</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Start with sound, end with video. Upload voice recordings, music, or sound effects and generate visuals that automatically sync to your audio's rhythm, tone, and pacing. Maintain consistent voice performance across scenes while LTX matches visuals to your audio timeline.</p></div><a href="/blog/how-to-generate-video-from-audio-in-ltx" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">January 19, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Upload Endpoint</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>New [.url-highlight]v1/upload[.url-highlight] endpoint for uploading assets via signed URLs.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">January 6, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Open-Source Release — Full Weights &amp; Codebase</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>[.model-v-highlight]LTX-2[.model-v-highlight]</p><h3>Release</h3><ul role="list"><li>Full open-weights release on Hugging Face and GitHub</li><li>First production-ready audio-video generation model with truly open weights</li><li>Complete transparency in model architecture and training methodology</li><li>Technical report published: <em>LTX-2: Efficient Joint Audio-Visual Foundation Model</em> (arXiv 2601.03233)</li></ul><h3>Model Variants</h3><ul role="list"><li><strong>Fast</strong> — optimized for speed, from $0.04/sec</li><li><strong>Pro</strong> — balance of speed and quality, from $0.08/sec</li><li><strong>Ultra</strong> — maximum cinematic quality, from $0.16/sec</li></ul><h3>Capabilities</h3><ul role="list"><li>Text-to-video, image-to-video, video-to-video, audio-to-video, and more</li><li>Multi-input conditioning: text, image, video, audio, depth maps, reference video</li><li>3D camera logic for sophisticated motion sequences</li><li>Keyframe interpolation pipeline</li><li>LoRA fine-tuning — motion, style, and identity training in under 1 hour</li></ul><h3>Resolutions &amp; Output</h3><ul role="list"><li>HD (720p) · FHD (1080p) · QHD (1440p) · UHD (2160p / 4K)</li><li>Up to 10 seconds at launch (extended in later updates)</li><li>Up to 50% lower compute cost vs. competing models</li><li>Runs on consumer-grade GPUs </li></ul><h3>Model Checkpoints</h3><p>[.url-highlight]ltx-2-19b-dev[.url-highlight] [.url-highlight]ltx-2-19b-dev-fp8[.url-highlight] [.url-highlight]ltx-2-19b-dev-fp4[.url-highlight] [.url-highlight]ltx-2-19b-distilled[.url-highlight] [.url-highlight]ltx-2-19b-distilled-lora-384[.url-highlight] [.url-highlight]ltx-2-spatial-upscaler-x2[.url-highlight] [.url-highlight]ltx-2-temporal-upscaler-x2[.url-highlight]</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">January 6, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Storyboard Builder</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>The new Storyboard Builder converts briefs or scripts into shot-level storyboards, automatically creating reusable Elements for characters and objects. Model selection and aspect ratio are set at initiation to ensure consistency across all frames, from pitch through production.<a href="/blog/ltx-storyboard-generator-update">‍</a></p></div><a href="/blog/ltx-storyboard-generator-update" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">January 1, 2026</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Camera Motion Effects</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Camera motion support for image-to-video and text-to-video endpoints, giving direct control over camera movement in generated videos. Options: [.url-highlight]dolly_in[.url-highlight], [.url-highlight]dolly_out[.url-highlight], [.url-highlight]dolly_left[.url-highlight], [.url-highlight]dolly_right[.url-highlight], [.url-highlight]jib_up[.url-highlight], [.url-highlight]jib_down[.url-highlight], [.url-highlight]static[.url-highlight], and [.url-highlight]focus_shift[.url-highlight].</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">December 23, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Developer Console Public Launch</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>The developer console is now open to the public with self-service signup, automatic organization creation, and prepaid billing with credit top-up.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">December 22, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Color Picker</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Perfect color matching for brand-consistent visuals across every generation. Color Picker lets you select any exact shade while prompting, ensuring your final images match your chosen palette without guesswork or iteration. Maintain precise brand colors across all outputs—available for Nano Banana Pro, Nano Banana 2, and FLUX.2.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">December 17, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">FLUX.2 Max</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>FLUX.2 Max brings advanced precision to image generation and editing for professional workflows. Generate publish-ready product imagery with stronger prompt adherence, upscale low-resolution photos into high-detail visuals, create motion-picture-quality keyframes, and produce accurate color variations or new 3D scene views. Fast performance and unmatched consistency across complex, multi-reference edits.<br></p></div><a href="/blog/flux-2-in-ltx" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">December 6, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced"> Audio-to-Video API</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>New audio-to-video endpoint for generating videos driven by audio input, with dedicated prompt enhancement.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">November 26, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Retake</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Directorial control doesn't end once a scene is rendered. Retake lets you select any segment within a video and regenerate just that moment while keeping everything else consistent.</p><p>Rephrase dialogue without rerecording, redirect emotion or pacing, and reimagine scene endings while preserving the performance and surrounding footage—all without breaking continuity or starting from scratch.</p></div><a href="/blog/retake-ai-directing-tool-ltx-studio" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">November 25, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Retake (Video Editing) Endpoint</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">API</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>New retake endpoint for editing specific sections of existing videos using text prompts.</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">November 25, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">FLUX.2</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Black Forest Labs—the team behind Stable Diffusion and FLUX.1—has launched FLUX.2, a completely reimagined text-to-image model trained for visual intelligence, not just pixel generation. FLUX.2 delivers production-ready images with photorealistic detail, accurate lighting, and real-world spatial logic, all integrated seamlessly into LTX's Gen Space.<br></p></div><a href="/blog/flux-2-in-ltx" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">November 20, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Nano Banana Pro</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Google's latest image model, Nano Banana Pro, brings advanced editing, improved reasoning, and superior text rendering directly into LTX's Gen Space. Enable multimodal editing with natural language and image references, generate sharper typography for clean, legible text, and produce higher-quality visuals with improved resolution and better consistency across iterations.</p></div><a href="/blog/nano-banana-pro-advanced-image-generation-now-in-ltx-studio" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">October 28, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Elements</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>A new way to create, save, and tag the core parts of your scene — from characters and props to environments and objects. Elements make it easy to organize, tag, and reuse assets across your project, keeping every shot consistent and connected. Ideal for branded content, recurring characters, and maintaining continuity across AI video production.</p><p>Available now under 'Elements' in each Project in LTX, for Standard, Pro, and Enterprise users.</p></div><a href="/blog/getting-started-with-elements" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">October 23, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">LTX-2 Announced — First Unified Audio-Video Foundation Model</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>[.model-v-highlight]LTX-2[.model-v-highlight]</p><h3>Highlights</h3><ul role="list"><li>First DiT-based audio-video foundation model with synchronized generation</li><li>Audio and video generated in one coherent process — motion, dialogue, ambience, and music</li><li>Native 4K fidelity at up to 50 FPS</li><li>Up to 10 seconds of synchronized generation per clip</li><li>Multi-keyframe conditioning for advanced creative control</li><li>Up to 50% lower compute cost versus competing models</li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">October 19, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Veo 3.1</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Studio</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>Google's latest video model, brings dual keyframe control, sharper visuals, and more grounded realism to your AI video workflow. Get better image quality, more cinematic precision, and smoother motion, all at the same pricing.</p></div><a href="/blog/veo-3-1-release-ltx" class="inline-text-link inline-draw-underline w-inline-block"><div class="spacer-1-5rem"></div><div class="text-size-regular release-notes-link">Read more here →</div></a></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">July 16, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">60-Second Generation · IC-LoRA Detailer · Distilled 2B Model</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>[.model-v-highlight]v0.9.8[.model-v-highlight]</p><h3>New Features</h3><ul role="list"><li>Extended video generation — up to 60 seconds (up from ~32 seconds)</li><li>New 2B distilled model for lightweight deployment</li><li>FP8 quantized weight options for memory-efficient inference</li><li>Optimized for real-time generation on H100 GPU</li></ul><h3>LoRA Released</h3><ul role="list"><li><code>LTX-Video-ICLoRA-detailer-13b-0.9.8</code> — enhances fine visual details, edges, and textures without altering composition</li><li>Full fine-tuning and LoRA training support for both 2B and 13B variants</li><li>Control LoRA support: depth, pose, canny</li></ul><h3>Quality Improvements</h3><ul role="list"><li>Improved prompt understanding and adherence</li><li>Enhanced detail generation across all model variants</li><li>Better overall motion quality</li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">May 14, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Distilled 13B — HD Video in 10 Seconds</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>[.model-v-highlight]v0.9.7[.model-v-highlight]</p><h3>Performance</h3><ul role="list"><li>HD video generation in ~10 seconds on H100 GPU</li><li>Low-res preview available after just 3 seconds</li><li>No classifier-free guidance required — faster inference</li><li>Only 1GB VRAM required for LoRA variant</li></ul><h3>Model Checkpoints</h3><p>[.url-highlight]ltxv-13b-0.9.7-distilled[.url-highlight] [.url-highlight]ltxv-13b-0.9.7-distilled-fp8[.url-highlight]</p></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 15, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Resolution Expansion · 15× Faster Distilled Variant</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>[.model-v-highlight]v0.9.6[.model-v-highlight]</p><h3>Improvements</h3><ul role="list"><li>Expanded resolution support — default 1216×704 at 30 FPS</li><li>15× faster distilled model variant: <code>ltxv-2b-0.9.6-distilled</code></li><li>Stochastic inference support for diverse output generation</li><li>Improved motion quality and fine detail generation</li><li>Better overall video coherence</li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">April 15, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">13B Model — Multi-Scale Rendering Pipeline</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>[.model-v-highlight]v0.9.7[.model-v-highlight]</p><h3><strong>New </strong>Features</h3><ul role="list"><li>New 13B model with breakthrough prompt adherence and physical understanding</li><li>Multi-scale rendering pipeline for enhanced detail at all resolutions</li><li>Temporal upscalers for improved motion quality</li><li>Spatial upscalers for enhanced resolution detail</li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">March 5, 2025</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Commercial License · Keyframes · Video Extension</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>[.model-v-highlight]v0.9.5[.model-v-highlight]</p><h3>Licensing</h3><ul role="list"><li>Commercial use now permitted under OpenRail-M license</li></ul><h3>New Features</h3><ul role="list"><li>Keyframe conditioning — precise control over video content at specific timestamps</li><li>Video extension — extend existing video clips</li><li>Higher resolution capabilities added</li><li>Improved VAE architecture for better temporal consistency</li></ul><h3>Ecosystem</h3><ul role="list"><li>LTX-Studio web application launched alongside this release</li><li>Online demo available for users without local GPU access</li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">December 20, 2024</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">STG / PAG Support · macOS · Research Paper</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>[.model-v-highlight]v0.9.1[.model-v-highlight]</p><h3>New Features</h3><ul role="list"><li>Spatiotemporal Guidance (STG) implementation for improved quality control</li><li>Perturbed Attention Guidance (PAG) support</li><li>Improved timestep-conditioned VAE decoder for better temporal consistency</li><li>CPU offloading for unused model components — lower peak memory usage</li></ul><h3>Platform Support</h3><ul role="list"><li>macOS MPS (Metal Performance Shaders) support added</li></ul><h3>Research</h3><ul role="list"><li>Research paper published alongside this release</li></ul></div></div></div></div><div role="listitem" class="release-notes_collection-item-wrapper w-dyn-item"><div class="release-notes_collection-item"><div class="release-notes_date-wrapper"><div class="text-size-tiny">November 21, 2024</div></div><div class="release-notes_info-wrapper"><div class="release-notes_title-wrapper"><div class="max-width-75-on-desktop"><h2 class="heading-style-h5 text-weight-bold text-color-black text-balanced">Initial Release</h2></div><div class="rlease-notes_tags-wrapper"><div class="release-notes_tag hide-but-dont-delete"><div r-indexed="type">Open source</div></div></div></div><div class="spacer-1rem _0-5-on-mobile"></div><div class="release-notes_rich-text w-richtext"><p>[.model-v-highlight]v0.9.0[.model-v-highlight]</p><h3>Capabilities</h3><ul role="list"><li>Text-to-video generation</li><li>Image-to-video generation</li><li>5-second video clips at 768×512 resolution</li><li>5-second videos generated in ~4 seconds on H100 GPU</li><li>Focus on motion consistency and generation speed</li></ul><h3>Integrations</h3><ul role="list"><li>ComfyUI integration</li><li>Hugging Face model repository</li><li>fal.ai hosted inference</li><li>Native Python inference</li></ul><h3>License</h3><ul role="list"><li>Released under OpenRail-M license</li></ul></div></div></div></div></div></div><div r-filter-empty="1" class="release-notes_empty-state-wrapper"><div class="blog-empty-state-inner-wrap"><div class="empty-state-icon-2 cc-release-notes w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 188 188" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
