<!-- Start of: navbar-light-solid-top -->
<!-- Light-mode navbar: opaque #e7e8eb (matches body bg) at the very top so the dark
     announcement bar above doesn't bleed through the glassy navbar. The bg is set in
     CSS so it's present on first paint — no flicker of the glassy state on load. Once
     the user scrolls past 4rem, .is-scrolled is added, the override drops, and the
     designer's glassy bg + blur fades back in. Dark mode is untouched. -->
<!-- Paste in Site Settings → Custom Code → Inside <head> tag -->
<style>
  body.body-ltx-off-white .navbar-ltx.is-new,
  body.cc-light .navbar-ltx.is-new {
    transition: background-color 0.3s ease;
  }

  body.body-ltx-off-white .navbar-ltx.is-new:not(.is-scrolled),
  body.cc-light .navbar-ltx.is-new:not(.is-scrolled) {
    background-color: #e7e8eb !important;
  }
</style>

<script>
  (function () {
    var thresholdRem = 4;

    function init() {
      var body = document.body;
      if (!body || !(body.classList.contains('body-ltx-off-white') || body.classList.contains('cc-light'))) return;

      var rootFontPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      var thresholdPx = thresholdRem * rootFontPx;

      function update() {
        var nav = document.querySelector('.navbar-ltx.is-new');
        if (!nav) return;
        nav.classList.toggle('is-scrolled', window.scrollY >= thresholdPx);
      }

      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
<!-- End of: navbar-light-solid-top -->

<!-- Start of: Splide arrow focus ring -->
<!-- Splide arrows are Webflow divs made focusable by the footer a11y shim. -->
<style>
  .splide__arrows .splide__arrow:focus-visible {
    outline: 2px solid var(--_theme---text) !important;
    outline-offset: 2px !important;
    box-shadow: 0 0 0 2px var(--_theme---text);
  }
</style>
<!-- End of: Splide arrow focus ring -->

<!-- Start of: inverted text selection (new Theme pages + opted-in pages) -->
<style>
  :is(.body-ltx-off-white, [data-selection="invert"]) ::selection {
    background-color: color-mix(in srgb, var(--_theme---text, Highlight) 99%, transparent);
    color: var(--_theme---background, HighlightText);
  }
  :is(.body-ltx-off-white, [data-selection="invert"]) :is(.ltx-but-base, .ltx-but-flex.is-with-icon-full, .rsvp-cta, .prefix-picker button, .section-name-new) {
    -webkit-user-select: none;
    user-select: none;
  }
</style>
<!-- End of: inverted text selection --><!-- START: Hide Theme Trigger Div (PLACE IN <head>) -->
<style>
  .theme-trigger {
    height: 0 !important;          /* removes the 1px gap */
    background: transparent !important;
    opacity: 0 !important;
    pointer-events: none !important;

  }
</style>
<!-- END: Hide Theme Trigger Div --></head><body data-selection="invert" class="body-ltx2"><div class="page-wrapper"><div class="global-styles w-embed"><!-- ✅ START: Global Styles -->
<style>

/* Add footer spacing in Light mode */
/*body.body-ltx-off-white .footer-section.cc-ltx,
body.cc-light .footer-section.cc-ltx {
  margin-top: 4.5rem; /* tweakable spacing 
}



/* ─────────────────────────────────────────
   COLOR INHERITANCE
───────────────────────────────────────── */

/* Forces all children to inherit parent text color */
.inherit-color * {
  color: inherit;
}


/* ─────────────────────────────────────────
   FOCUS STATE (ACCESSIBILITY)
───────────────────────────────────────── */

/* Keyboard navigation focus ring for focusable elements */
*[tabindex]:focus-visible,
input[type="file"]:focus-visible {
  outline: 0.125rem solid #4d65ff;
  outline-offset: 0.125rem;
}


/* ─────────────────────────────────────────
   RICH TEXT SPACING FIXES
───────────────────────────────────────── */

/* Remove top margin from first element in any rich text block */
.w-richtext > :not(div):first-child,
.w-richtext > div:first-child > :first-child {
  margin-top: 0 !important;
}

/* Remove bottom margin from last element in any rich text block */
.w-richtext > :last-child,
.w-richtext ol li:last-child,
.w-richtext ul li:last-child {
  margin-bottom: 0 !important;
}


/* ─────────────────────────────────────────
   POINTER EVENTS
───────────────────────────────────────── */

.pointer-events-off {
  pointer-events: none;
}

.pointer-events-on {
  pointer-events: auto;
}


/* ─────────────────────────────────────────
   LAYOUT UTILITIES
───────────────────────────────────────── */

/* Forces a div to maintain a 1:1 square ratio */
.div-square::after {
  content: "";
  display: block;
  padding-bottom: 100%;
}

/* Keeps containers centered regardless of parent styles */
.container-medium,
.container-small,
.container-large {
  margin-right: auto !important;
  margin-left: auto !important;
}

/* Inline flex shorthand */
.display-inlineflex {
  display: inline-flex;
}


/* ─────────────────────────────────────────
   VISIBILITY / HIDE UTILITIES
───────────────────────────────────────── */

.hide {
  display: none !important;
}

@media screen and (max-width: 991px) {
  .hide,
  .hide-tablet {
    display: none !important;
  }
}

@media screen and (max-width: 767px) {
  .hide-mobile-landscape {
    display: none !important;
  }
}

@media screen and (max-width: 479px) {
  .hide-mobile {
    display: none !important;
  }
}


/* ─────────────────────────────────────────
   TEXT TRUNCATION
───────────────────────────────────────── */

/* Legacy Webflow truncation classes — kept for reference, check usage before deleting */
/*
.text-style-3lines {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.text-style-2lines {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
*/

/* Truncate to N lines with ellipsis */
.text-truncate-4 {
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-truncate-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-truncate-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* truncate-3 reduces to 2 lines on mobile */
@media (max-width: 767px) {
  .text-truncate-3 {
    -webkit-line-clamp: 2;
  }
}

/* Single-line ellipsis at 100% width */
.truncate-width {
  width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}


/* ─────────────────────────────────────────
   SPACING RESET UTILITIES
───────────────────────────────────────── */

.margin-0    { margin: 0rem !important; }
.padding-0   { padding: 0rem !important; }

.spacing-clean {
  padding: 0rem !important;
  margin: 0rem !important;
}

/* Zero out all sides except the named one */
.margin-top        { margin-right: 0rem !important; margin-bottom: 0rem !important; margin-left: 0rem !important; }
.margin-right      { margin-top: 0rem !important;   margin-bottom: 0rem !important; margin-left: 0rem !important; }
.margin-bottom     { margin-top: 0rem !important;   margin-right: 0rem !important;  margin-left: 0rem !important; }
.margin-left       { margin-top: 0rem !important;   margin-right: 0rem !important;  margin-bottom: 0rem !important; }
.margin-horizontal { margin-top: 0rem !important;   margin-bottom: 0rem !important; }
.margin-vertical   { margin-right: 0rem !important; margin-left: 0rem !important; }

.padding-top        { padding-right: 0rem !important; padding-bottom: 0rem !important; padding-left: 0rem !important; }
.padding-right      { padding-top: 0rem !important;   padding-bottom: 0rem !important; padding-left: 0rem !important; }
.padding-bottom     { padding-top: 0rem !important;   padding-right: 0rem !important;  padding-left: 0rem !important; }
.padding-left       { padding-top: 0rem !important;   padding-right: 0rem !important;  padding-bottom: 0rem !important; }
.padding-horizontal { padding-top: 0rem !important;   padding-bottom: 0rem !important; }
.padding-vertical   { padding-right: 0rem !important; padding-left: 0rem !important; }


/* ─────────────────────────────────────────
   SCROLLBAR
───────────────────────────────────────── */

/* Hides scrollbar across browsers while keeping scroll functionality */
.no-scrollbar {
  -ms-overflow-style: none;
  overflow: -moz-scrollbars-none;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}


/* ─────────────────────────────────────────
   FORM ELEMENTS
───────────────────────────────────────── */

/* Removes native browser styling from select dropdowns */
.w-select {
  -webkit-appearance: none !important;
  -moz-appearance: none !important;
}


/* ─────────────────────────────────────────
   FONT SMOOTHING
───────────────────────────────────────── */

body {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}


/* ─────────────────────────────────────────
   ASPECT RATIO UTILITIES
───────────────────────────────────────── */

.ratio-1-1        { aspect-ratio: 1 / 1; }
.ratio-5-4        { aspect-ratio: 5 / 4; }
.ratio-4-5        { aspect-ratio: 4 / 5; }
.ratio-16-9       { aspect-ratio: 16 / 9; }
.ratio-9-16       { aspect-ratio: 1 / 1.78; }
.ratio-device-9-16 { aspect-ratio: 1 / 1.78; }


/* ─────────────────────────────────────────
   INLINE LINK — ANIMATED UNDERLINE
   Underline visible by default, retracts on hover, redraws on mouse-out.
   Color strictly inherits from parent text.
───────────────────────────────────────── */

.inline-draw-underline {
  position: relative;
  color: inherit;
  text-decoration: none;
}

.inline-draw-underline::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2px;
  height: 1px;
  background: currentColor;
  transform: scaleX(1);
  transform-origin: left;
  transition: transform 0.3s ease;
  pointer-events: none;
}

.inline-draw-underline:hover::after,
.inline-draw-underline:focus::after {
  transform: scaleX(0);
  transform-origin: right;
}

</style>
<!-- ✅ END: Global Styles --></div><div data-wf--new-navbar--variant="base" class="navbar-ltx is-new"><div class="blur-overlay w-embed w-script"><!-- Library-safe selectors: every library class is matched as :is(.name, .ltx--name), because
     Shared Library adds an ltx-- prefix on consumer sites. Embed code is never rewritten by Webflow. -->
<!-- ✅ START: Mega menu global blur overlay -->
<style>
  /* Simple page blur layer:
     - Blur overlay z-index = 50
     - Navbar/menu stay above it
     - Does not touch dropdown inner layout */

  @media (min-width: 992px) {
    .mega-menu-page-blur {
      position: fixed;
      inset: 0;
      opacity: 0;
      pointer-events: none;
      z-index: 90;
      background: rgba(0, 0, 0, 0.32);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: opacity 220ms cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity;
    }

    .mega-menu-page-blur.is-active {
      opacity: 1;
    }

    /* Raise only the outer navbar component above the blur layer */
    :is(.navbar-new-component, .ltx--navbar-new-component) {
      position: relative;
      z-index: 100;
    }

    .mega-menu-bottom-border {
      z-index: 101;
    }
  }

  @media (max-width: 991px) {
    .mega-menu-page-blur {
      display: none;
    }
  }
</style>

<script>
  (function () {
    const MENU_SELECTOR = ":is(.navbar5_menu-left, .ltx--navbar5_menu-left)";
    const DESKTOP_QUERY = window.matchMedia("(min-width: 992px)");

    let blurLayer = document.querySelector(".mega-menu-page-blur");

    function createBlurLayer() {
      if (blurLayer) return blurLayer;

      blurLayer = document.createElement("div");
      blurLayer.className = "mega-menu-page-blur";

      if (document.body) {
        document.body.appendChild(blurLayer);
      } else {
        document.addEventListener("DOMContentLoaded", function () {
          document.body.appendChild(blurLayer);
        });
      }

      return blurLayer;
    }

    createBlurLayer();

    document.addEventListener("DOMContentLoaded", function () {
      const menu = document.querySelector(MENU_SELECTOR);

      if (!menu || !blurLayer) return;

      function showBlur() {
        if (!DESKTOP_QUERY.matches) return;
        blurLayer.classList.add("is-active");
      }

      function hideBlur() {
        blurLayer.classList.remove("is-active");
      }

      menu.addEventListener("mouseenter", showBlur);
      menu.addEventListener("mouseleave", hideBlur);

      menu.addEventListener("focusin", showBlur);

      menu.addEventListener("focusout", function () {
        setTimeout(function () {
          if (!menu.contains(document.activeElement)) {
            hideBlur();
          }
        }, 50);
      });

      window.addEventListener("resize", hideBlur);
    });
  })();
</script>
<!-- ✅ END: Mega menu global blur overlay --></div><div class="smooth-menu w-embed w-script"><!-- Library-safe selectors: every library class is matched as :is(.name, .ltx--name), because
     Shared Library adds an ltx-- prefix on consumer sites. Embed code is never rewritten by Webflow. -->
<!-- ✅ START: Native mega menu - underline, hover, smooth height, full-bleed bg, aligned content, chevron -->
<style>
  @media (min-width: 992px) {
    /* ______________________________________________________________
       PART 1 — UNDERLINE HOVER FOR DROPDOWN / BASE ITEMS ONLY
    ______________________________________________________________ */

    :is(.menu-item-base-new, .ltx--menu-item-base-new) {
      position: relative;
    }

    :is(.menu-item-base-new, .ltx--menu-item-base-new)::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -2px;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s ease;
      pointer-events: none;
    }

    :is(.new-navbar-toggle, .ltx--new-navbar-toggle):hover :is(.menu-item-base-new, .ltx--menu-item-base-new)::after,
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle):focus-within :is(.menu-item-base-new, .ltx--menu-item-base-new)::after,
    :is(.menu-item-new, .ltx--menu-item-new):hover :is(.menu-item-base-new, .ltx--menu-item-base-new)::after,
    :is(.menu-item-new, .ltx--menu-item-new):focus-within :is(.menu-item-base-new, .ltx--menu-item-base-new)::after {
      transform: scaleX(1);
    }

    /* ______________________________________________________________
       PART 2 — NAVBAR SURFACE ON MEGA MENU HOVER
    ______________________________________________________________ */

    :is(.navbar-ltx, .ltx--navbar-ltx):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left):hover),
    :is(.navbar-ltx, .ltx--navbar-ltx):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left):focus-within),
    :is(.navbar-ltx, .ltx--navbar-ltx):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left).is-mega-open),
    :is(.navbar-new-component, .ltx--navbar-new-component):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left):hover),
    :is(.navbar-new-component, .ltx--navbar-new-component):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left):focus-within),
    :is(.navbar-new-component, .ltx--navbar-new-component):has(:is(.navbar5_menu-left, .ltx--navbar5_menu-left).is-mega-open) {
      background-color: var(--_theme---background, var(--ltx_theme---background)) !important;
      background-image: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }

    /* ______________________________________________________________
       PART 3 — CLEAN OLD BORDER / SHADOW STATES
    ______________________________________________________________ */

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) .navbar5_dropdown-list,
    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) {
      border-bottom: 0 !important;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) .navbar5_dropdown-list {
      box-shadow: none !important;
    }

    .mega-menu-bottom-border {
      display: none !important;
    }

    /* ______________________________________________________________
       PART 4 — DROPDOWN PANEL ALIGNMENT + FULL-BLEED BACKGROUND
       Content starts from the first nav item.
       Background and bottom border bleed to both screen edges.
    ______________________________________________________________ */

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) {
      display: block;
      left: var(--mega-menu-align-left, 0px) !important;
      right: auto !important;
      width: var(--mega-menu-panel-width, auto) !important;
      max-width: none !important;
      box-sizing: border-box !important;
      height: 0;
      overflow: visible;
      clip-path: inset(0 -100vmax 0 -100vmax);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      background-color: var(--_theme---background, var(--ltx_theme---background, #000)) !important;
      box-shadow: 0 0 0 100vmax var(--_theme---background, var(--ltx_theme---background, #000)) !important;
      transition:
        height 520ms cubic-bezier(0.16, 1, 0.3, 1),
        opacity 160ms cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0ms linear 180ms;
      will-change: height, opacity;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown).is-dropdown-active :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition:
        height 520ms cubic-bezier(0.16, 1, 0.3, 1),
        opacity 160ms cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0ms linear 0ms;
    }

    :is(.navbar5_menu-left, .ltx--navbar5_menu-left).is-mega-switching :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) {
      transition:
        height 520ms cubic-bezier(0.16, 1, 0.3, 1),
        opacity 120ms cubic-bezier(0.16, 1, 0.3, 1),
        visibility 0ms linear 0ms;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4).is-height-instant {
      transition: none !important;
    }

    /* ______________________________________________________________
       PART 5 — FULL-WIDTH BOTTOM EDGE
    ______________________________________________________________ */

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4)::after {
      content: "";
      position: absolute;
      left: -100vmax;
      right: -100vmax;
      bottom: 0;
      height: 1px;
      background: rgba(255, 255, 255, 0.16);
      opacity: 0;
      pointer-events: none;
      transition: opacity 120ms linear;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown).is-dropdown-active :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4)::after {
      opacity: 1;
    }

    /* ______________________________________________________________
       PART 6 — HOVER BRIDGE
       Disabled as CSS layer to avoid hidden blocking areas.
       JS still handles safe hover tracking.
    ______________________________________________________________ */

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) .navbar5_dropdown-list::before,
    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4)::before {
      display: none !important;
    }

    /* ______________________________________________________________
   PART 7 — EXPANDED NAV TOGGLE HOVER AREA
   Keep hover bridge below nav items, but never let it cover logo.
______________________________________________________________ */

:is(.menu-logo-wrap, .ltx--menu-logo-wrap),
:is(.logo-size-wrap, .ltx--logo-size-wrap) {
  position: relative;
  z-index: 20;
  pointer-events: auto;
}

:is(.navbar5_menu-left, .ltx--navbar5_menu-left) {
  position: relative;
  z-index: 10;
}

:is(.new-navbar-toggle, .ltx--new-navbar-toggle) {
  position: relative;
}

:is(.new-navbar-toggle, .ltx--new-navbar-toggle)::after {
  content: "";
  position: absolute;
  top: -10px;
  left: -24px;
  right: -24px;
  bottom: -52px;
  background: transparent;
  pointer-events: auto;
  z-index: 0;
}

/* Important: do not let first item hover area reach over the logo */
:is(.new-navbar-dropdown, .ltx--new-navbar-dropdown):first-child :is(.new-navbar-toggle, .ltx--new-navbar-toggle)::after {
  left: -24px;
}

:is(.new-navbar-toggle, .ltx--new-navbar-toggle) > * {
  position: relative;
  z-index: 1;
}

    /* ______________________________________________________________
       PART 7.1 — DESKTOP HORIZONTAL OVERFLOW GUARD
    ______________________________________________________________ */

    html,
    body {
      overflow-x: clip;
    }

    :is(.navbar-ltx, .ltx--navbar-ltx),
    :is(.navbar-new-component, .ltx--navbar-new-component),
    .navbar5_menu,
    :is(.navbar5_menu-left, .ltx--navbar5_menu-left) {
      max-width: 100vw;
    }

    .navbar5_menu,
    :is(.navbar5_menu-left, .ltx--navbar5_menu-left) {
      overflow: visible !important;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown),
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) {
      max-width: 100%;
    }

    /* ______________________________________________________________
       PART 8 — INACTIVE MAIN NAV DIMMING
    ______________________________________________________________ */

    :is(.navbar5_menu-left, .ltx--navbar5_menu-left) > :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.menu-item-main, .ltx--menu-item-main) {
      opacity: 1;
      transition: opacity 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    :is(.navbar5_menu-left, .ltx--navbar5_menu-left).is-mega-open > :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.menu-item-main, .ltx--menu-item-main) {
      opacity: 0.45;
    }

    :is(.navbar5_menu-left, .ltx--navbar5_menu-left).is-mega-open > :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown).is-dropdown-active :is(.menu-item-main, .ltx--menu-item-main) {
      opacity: 1;
    }

    /* ______________________________________________________________
       PART 9 — DESKTOP CHEVRON ROTATION
    ______________________________________________________________ */

    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) :is(.chevron-new, .ltx--chevron-new),
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) :is(.chevron-new, .ltx--chevron-new) svg,
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) svg,
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) .w-icon-dropdown-toggle {
      transform-origin: center;
      transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }

    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) :is(.chevron-new, .ltx--chevron-new) {
      transform: rotate(0deg);
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown).is-dropdown-active :is(.new-navbar-toggle, .ltx--new-navbar-toggle) :is(.chevron-new, .ltx--chevron-new) {
      transform: rotate(180deg);
    }
  }

  @media (max-width: 991px) {
    /* ______________________________________________________________
       MOBILE / TABLET NATURAL STACK FIX
    ______________________________________________________________ */

    .navbar5_menu {
      overflow-y: auto !important;
      overflow-x: hidden !important;
      height: 100dvh !important;
      max-height: 100dvh !important;
      flex-direction: column !important;
      align-items: stretch !important;
    }

    :is(.navbar5_menu-left, .ltx--navbar5_menu-left) {
      position: relative !important;
      display: flex !important;
      flex-direction: column !important;
      width: 100% !important;
      height: auto !important;
      overflow: visible !important;
      flex: 0 0 auto !important;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown),
    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown).w-dropdown {
      position: relative !important;
      width: 100% !important;
      flex: 0 0 auto !important;
    }

    /* ______________________________________________________________
       MOBILE / TABLET CLEANUP
    ______________________________________________________________ */

    .mega-menu-bottom-border {
      display: none !important;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4)::after {
      display: none !important;
    }

    /* ______________________________________________________________
       MOBILE / TABLET CLOSE-STATE BACKGROUND CLEANUP
    ______________________________________________________________ */

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown),
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle),
    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) .navbar5_dropdown-list,
    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4),
    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4).w--open {
      background-image: none !important;
      box-shadow: none !important;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) {
      background-color: transparent !important;
    }

    /* ______________________________________________________________
       MOBILE / TABLET NATURAL DROPDOWN EASING
    ______________________________________________________________ */

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) {
      display: grid !important;
      grid-template-rows: 0fr;
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      bottom: auto !important;
      width: 100% !important;
      height: auto !important;
      overflow: hidden !important;
      opacity: 0;
      transform: translateY(-0.2rem);
      visibility: hidden;
      pointer-events: none;
      will-change: grid-template-rows, opacity, transform;
      transition:
        grid-template-rows 440ms cubic-bezier(0.19, 1, 0.22, 1),
        opacity 180ms ease-out,
        transform 320ms cubic-bezier(0.19, 1, 0.22, 1),
        visibility 0ms linear 440ms;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4).w--open {
      grid-template-rows: 1fr;
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
      pointer-events: auto;
      transition:
        grid-template-rows 520ms cubic-bezier(0.19, 1, 0.22, 1),
        opacity 160ms ease-out,
        transform 360ms cubic-bezier(0.19, 1, 0.22, 1),
        visibility 0ms linear 0ms;
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown) :is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4) > * {
      min-height: 0;
      overflow: visible;
    }

    /* ______________________________________________________________
       MOBILE / TABLET CHEVRON ROTATION
    ______________________________________________________________ */

    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) :is(.chevron-new, .ltx--chevron-new),
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) :is(.chevron-new, .ltx--chevron-new) svg,
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) svg,
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) .w-icon-dropdown-toggle {
      transform-origin: center;
      transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }

    :is(.new-navbar-toggle, .ltx--new-navbar-toggle) :is(.chevron-new, .ltx--chevron-new) {
      transform: rotate(0deg);
    }

    :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown).w--open :is(.new-navbar-toggle, .ltx--new-navbar-toggle) :is(.chevron-new, .ltx--chevron-new),
    :is(.new-navbar-toggle, .ltx--new-navbar-toggle).w--open :is(.chevron-new, .ltx--chevron-new) {
      transform: rotate(180deg);
    }
  }

  /* Library consumer fix: Shared Library compiles the ltx-but-base > is-small > is-black chain
     as single-class .ltx--is-black rules, so the hard-coded black one wins on dark pages.
     Restores the .io behaviour (theme-variable colours). Only matches prefixed classes,
     so it does nothing on the library source site. */
  .ltx--ltx-but-base.ltx--is-small.ltx--is-black {
    border-color: var(--ltx_theme---full-button--full-but-border);
    background-color: var(--ltx_theme---full-button--full-but-bg);
    color: var(--ltx_theme---background);
  }
</style>

<script>
  (function () {
    /* ______________________________________________________________
       PART 1 — CONFIG
    ______________________________________________________________ */

    const MENU_SELECTOR = ":is(.navbar5_menu-left, .ltx--navbar5_menu-left)";
    const DROPDOWN_SELECTOR = ":is(.navbar5_menu-left, .ltx--navbar5_menu-left) > :is(.new-navbar-dropdown, .ltx--new-navbar-dropdown)";
    const TOGGLE_SELECTOR = ":is(.new-navbar-toggle, .ltx--new-navbar-toggle)";
    const LIST_SELECTOR = ":is(.navbar5_dropdown-list4, .ltx--navbar5_dropdown-list4)";
    const DESKTOP_QUERY = window.matchMedia("(min-width: 992px)");

    document.addEventListener("DOMContentLoaded", function () {
      const menu = document.querySelector(MENU_SELECTOR);
      const dropdowns = Array.from(document.querySelectorAll(DROPDOWN_SELECTOR));

      if (!menu || !dropdowns.length) return;

      document.querySelectorAll(".mega-menu-visual-bg, .mega-menu-panel-bg").forEach(function (el) {
        el.remove();
      });

      let activeDropdown = null;
      let isMenuOpen = false;
      let closeTimer = null;
      let switchTimer = null;
      let resizeTimer = null;
      let currentMenuHeight = 0;
      let isCloseTracking = false;

      const CLOSE_DELAY_FAST = 80;
      const CLOSE_DELAY_BRIDGE = 260;
      const SWITCH_CLASS_CLEAR_DELAY = 180;
      const RESIZE_RESET_DELAY = 90;

      /* ______________________________________________________________
         PART 2 — UTILITIES
      ______________________________________________________________ */

      function isDesktop() {
        return DESKTOP_QUERY.matches;
      }

      function getList(dropdown) {
        return dropdown ? dropdown.querySelector(LIST_SELECTOR) : null;
      }

      function getToggle(dropdown) {
        return dropdown ? dropdown.querySelector(TOGGLE_SELECTOR) : null;
      }

      function getActiveList() {
        return getList(activeDropdown);
      }

      function clearCloseTimer() {
        isCloseTracking = false;

        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = null;
        }
      }

      function clearSwitchTimer() {
        if (switchTimer) {
          window.clearTimeout(switchTimer);
          switchTimer = null;
        }
      }

      function clearResizeTimer() {
        if (resizeTimer) {
          window.clearTimeout(resizeTimer);
          resizeTimer = null;
        }
      }

      function isPointerInsideRect(event, rect, padding = 0) {
        if (!event || !rect) return false;

        return (
          event.clientX >= rect.left - padding &&
          event.clientX <= rect.right + padding &&
          event.clientY >= rect.top - padding &&
          event.clientY <= rect.bottom + padding
        );
      }

      function isPointerInMenuOrDropdown(event) {
        const menuRect = menu.getBoundingClientRect();
        const activeList = getActiveList();
        const listRect = activeList ? activeList.getBoundingClientRect() : null;

        const inMenu = isPointerInsideRect(event, menuRect, 4);
        const inDropdown = listRect ? isPointerInsideRect(event, listRect, 4) : false;

        return inMenu || inDropdown;
      }

      function isPointerInBridge(event) {
        const menuRect = menu.getBoundingClientRect();
        const activeList = getActiveList();

        if (!activeList) return false;

        const listRect = activeList.getBoundingClientRect();

        const bridgeRect = {
          left: Math.min(menuRect.left, listRect.left) - 48,
          right: Math.max(menuRect.right, listRect.right) + 48,
          top: menuRect.bottom - 12,
          bottom: listRect.top + 72
        };

        return isPointerInsideRect(event, bridgeRect, 0);
      }

      function getMenuStartLeft() {
        const firstDropdown = dropdowns[0];
        const rect = firstDropdown ? firstDropdown.getBoundingClientRect() : menu.getBoundingClientRect();

        return Math.max(0, Math.round(rect.left));
      }

      function syncDropdownPanelAlignment(list) {
        if (!list || !isDesktop()) return;

        const offsetParent = list.offsetParent || document.documentElement;
        const parentRect =
          offsetParent === document.documentElement || offsetParent === document.body
            ? { left: 0 }
            : offsetParent.getBoundingClientRect();

        const startLeft = getMenuStartLeft();
        const viewportWidth = document.documentElement.clientWidth;
        const panelWidth = Math.max(0, viewportWidth - startLeft);

        list.style.setProperty("--mega-menu-align-left", Math.round(startLeft - parentRect.left) + "px");
        list.style.setProperty("--mega-menu-panel-width", panelWidth + "px");
      }

      function syncAllDropdownPanelAlignments() {
        dropdowns.forEach(function (dropdown) {
          syncDropdownPanelAlignment(getList(dropdown));
        });
      }

      function removeDesktopWebflowOpenState(dropdown) {
        if (!dropdown || !isDesktop()) return;

        const toggle = getToggle(dropdown);
        const list = getList(dropdown);

        dropdown.classList.remove("w--open");

        if (toggle) {
          toggle.classList.remove("w--open");
          toggle.setAttribute("aria-expanded", "false");
        }

        if (list) {
          list.classList.remove("w--open");
        }
      }

      function getNaturalHeight(list) {
        if (!list) return 0;

        const previousHeight = list.style.height;
        const previousOverflow = list.style.overflow;

        list.classList.add("is-height-instant");
        list.style.height = "auto";
        list.style.overflow = "hidden";

        const height = Math.round(list.scrollHeight);

        list.style.height = previousHeight;
        list.style.overflow = previousOverflow;

        list.offsetHeight;
        list.classList.remove("is-height-instant");

        return height;
      }

      function getVisibleHeight(dropdown) {
        const list = getList(dropdown);
        if (!list) return 0;

        return Math.round(list.getBoundingClientRect().height);
      }

      function setHeightInstant(list, height) {
        if (!list) return;

        list.classList.add("is-height-instant");
        list.style.height = height + "px";
        list.offsetHeight;
        list.classList.remove("is-height-instant");
      }

      /* ______________________________________________________________
         PART 3 — RESET INACTIVE DROPDOWNS
      ______________________________________________________________ */

      function resetInactiveDropdowns(exceptDropdown) {
        dropdowns.forEach(function (dropdown) {
          if (dropdown === exceptDropdown) return;

          const list = getList(dropdown);

          dropdown.classList.remove("is-dropdown-active");
          removeDesktopWebflowOpenState(dropdown);

          if (list) {
            list.style.height = "0px";
          }
        });
      }

      /* ______________________________________________________________
         PART 4 — ACTIVATE DROPDOWN WITH SMOOTH HEIGHT MORPH
      ______________________________________________________________ */

      function activateDropdown(dropdown) {
        if (!isDesktop() || !dropdown) return;

        const list = getList(dropdown);
        const toggle = getToggle(dropdown);

        if (!list) return;

        syncDropdownPanelAlignment(list);
        clearCloseTimer();

        const previousDropdown = activeDropdown;
        const wasMenuOpen = isMenuOpen;
        const isSameDropdown = previousDropdown === dropdown;

        const previousVisibleHeight = wasMenuOpen
          ? getVisibleHeight(previousDropdown) || currentMenuHeight
          : 0;

        const targetHeight = getNaturalHeight(list);

        activeDropdown = dropdown;
        isMenuOpen = true;
        currentMenuHeight = targetHeight;

        menu.classList.add("is-mega-open");

        if (wasMenuOpen && !isSameDropdown) {
          menu.classList.add("is-mega-switching");
        } else {
          menu.classList.remove("is-mega-switching");
        }

        resetInactiveDropdowns(dropdown);

        dropdown.classList.add("is-dropdown-active");
        removeDesktopWebflowOpenState(dropdown);

        if (toggle) {
          toggle.setAttribute("aria-expanded", "true");
        }

        if (isSameDropdown) {
          list.style.height = targetHeight + "px";
          return;
        }

        setHeightInstant(list, previousVisibleHeight);

        window.requestAnimationFrame(function () {
          list.style.height = targetHeight + "px";
        });

        clearSwitchTimer();
        switchTimer = window.setTimeout(function () {
          menu.classList.remove("is-mega-switching");
        }, SWITCH_CLASS_CLEAR_DELAY);
      }

      /* ______________________________________________________________
         PART 5 — CLOSE BEHAVIOR
      ______________________________________________________________ */

      function closeMenu() {
        clearCloseTimer();
        clearSwitchTimer();

        dropdowns.forEach(function (dropdown) {
          const list = getList(dropdown);
          const toggle = getToggle(dropdown);

          dropdown.classList.remove("is-dropdown-active");

          if (isDesktop()) {
            dropdown.classList.remove("w--open");
          }

          if (toggle && isDesktop()) {
            toggle.classList.remove("w--open");
            toggle.setAttribute("aria-expanded", "false");
          }

          if (list) {
            if (isDesktop()) {
              list.classList.remove("w--open");
              list.style.height = "0px";
            } else {
              list.style.height = "";
            }
          }
        });

        menu.classList.remove("is-mega-open", "is-mega-switching");

        activeDropdown = null;
        isMenuOpen = false;
        currentMenuHeight = 0;
        isCloseTracking = false;
      }

      function scheduleClose(event) {
        clearCloseTimer();
        isCloseTracking = true;

        if (!isPointerInMenuOrDropdown(event) && !isPointerInBridge(event)) {
          closeMenu();
          return;
        }

        const delay = isPointerInBridge(event) ? CLOSE_DELAY_BRIDGE : CLOSE_DELAY_FAST;

        closeTimer = window.setTimeout(function () {
          if (!menu.matches(":hover") && !menu.contains(document.activeElement)) {
            closeMenu();
          }
        }, delay);
      }

      function resetAfterResize() {
        clearResizeTimer();

        resizeTimer = window.setTimeout(function () {
          syncAllDropdownPanelAlignments();
          closeMenu();
        }, RESIZE_RESET_DELAY);
      }

      /* ______________________________________________________________
         PART 6 — EVENT BINDING
      ______________________________________________________________ */

      dropdowns.forEach(function (dropdown) {
        const toggle = getToggle(dropdown);
        const list = getList(dropdown);

        if (!toggle || !list) return;

        toggle.addEventListener("mouseenter", function () {
          activateDropdown(dropdown);
        });

        dropdown.addEventListener("mouseenter", function () {
          activateDropdown(dropdown);
        });

        list.addEventListener("mouseenter", function () {
          activateDropdown(dropdown);
        });

        toggle.addEventListener("focusin", function () {
          activateDropdown(dropdown);
        });
      });

      menu.addEventListener("mouseenter", clearCloseTimer);
      menu.addEventListener("mouseleave", scheduleClose);

      document.addEventListener(
        "mousemove",
        function (event) {
          if (!activeDropdown || !isDesktop() || !isCloseTracking) return;

          if (!isPointerInMenuOrDropdown(event) && !isPointerInBridge(event)) {
            closeMenu();
          }
        },
        { passive: true }
      );

      menu.addEventListener("focusout", function () {
        window.setTimeout(function () {
          if (!menu.contains(document.activeElement)) {
            closeMenu();
          }
        }, 50);
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && activeDropdown) {
          closeMenu();
        }
      });

      window.addEventListener("resize", resetAfterResize);
      window.addEventListener("orientationchange", resetAfterResize);
      window.addEventListener("blur", closeMenu);
      window.addEventListener("pagehide", closeMenu);

      document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
          closeMenu();
        }
      });

      if (DESKTOP_QUERY.addEventListener) {
        DESKTOP_QUERY.addEventListener("change", resetAfterResize);
      } else if (DESKTOP_QUERY.addListener) {
        DESKTOP_QUERY.addListener(resetAfterResize);
      }

      window.addEventListener(
        "scroll",
        function () {
          if (!activeDropdown || !isDesktop()) return;

          const list = getList(activeDropdown);
          if (!list) return;

          syncDropdownPanelAlignment(list);

          const targetHeight = getNaturalHeight(list);

          setHeightInstant(list, targetHeight);
          currentMenuHeight = targetHeight;
        },
        { passive: true }
      );

      syncAllDropdownPanelAlignments();
      closeMenu();
    });
  })();
</script>
