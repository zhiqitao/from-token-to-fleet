l="prefetch" href="/model/capabilities/world-model"/></li><li class="menu-list-item-new"><a href="/model/capabilities/lora-training" class="menu-item-new w-inline-block"><div class="menu-item-base-new">LoRA Training</div></a><link rel="prefetch" href="/model/capabilities/lora-training"/></li><li class="menu-list-item-new"><a href="/model/capabilities/ai-video-to-hdr" class="menu-item-new w-inline-block"><div class="menu-item-base-new">HDR Video</div></a><link rel="prefetch" href="/model/capabilities/ai-video-to-hdr"/></li><li class="menu-list-item-new"><a href="/model/capabilities/alpha-channel-video-generation" class="menu-item-new w-inline-block"><div class="menu-item-base-new">Alpha Channel Generation</div></a><link rel="prefetch" href="/model/capabilities/alpha-channel-video-generation"/></li><li class="menu-list-item-new"><a href="/model/capabilities-overview" class="menu-item-new w-inline-block"><div class="menu-item-base-new">See All</div></a><link rel="prefetch" href="/model/capabilities-overview"/></li></ul></div></div><div class="navbar5_dropdown-column"><div class="dd-menu-section-name">By Industry</div><div class="spacer-1rem _0-5-on-mobile"></div><div class="navbar5_dropdown-link-list-2"><ul role="list" class="menu-list-wrap"><li class="menu-list-item-new"><a href="/solution/robotics-physical-ai" class="menu-item-new w-inline-block"><div class="menu-item-base-new">Robotics &amp; Physical AI</div></a><link rel="prefetch" href="/solution/robotics-physical-ai"/></li><li class="menu-list-item-new"><a href="/solution/realtime-ai" class="menu-item-new w-inline-block"><div class="menu-item-base-new">Real-time AI</div></a><link rel="prefetch" href="/solution/realtime-ai"/></li><li class="menu-list-item-new"><a href="/solution/media-entertainment" class="menu-item-new w-inline-block"><div class="menu-item-base-new">Media &amp; Entertainment</div></a><link rel="prefetch" href="/solution/media-entertainment"/></li><li class="menu-list-item-new"><a href="/solution/