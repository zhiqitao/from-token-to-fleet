<!-- Start of white tab selector animation -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".release-notes_filter-wrapper").forEach(wrapper => {
    const indicator = wrapper.querySelector(".pricing-toggle-animation");
    const fields = wrapper.querySelectorAll(".pricing-radio-button-field");

    if (!indicator || !fields.length) return;

    function moveIndicator(field) {
      if (!field) return;

      const wrapperRect = wrapper.getBoundingClientRect();
      const fieldRect = field.getBoundingClientRect();

      indicator.style.width = fieldRect.width + "px";
      indicator.style.transform = `translateX(${fieldRect.left - wrapperRect.left}px)`;
    }

    fields.forEach(field => {
      field.addEventListener("click", () => moveIndicator(field));
    });

    const checked = wrapper.querySelector("input[type='radio']:checked");
    moveIndicator(checked?.closest(".pricing-radio-button-field") || fields[0]);

    window.addEventListener("resize", () => {
      const checked = wrapper.querySelector("input[type='radio']:checked");
      moveIndicator(checked?.closest(".pricing-radio-button-field") || fields[0]);
    });
  });
});
</script>
<!-- End of white tab selector animation -->




<!-- ✅ START: Theme on Scroll + Navbar Sync -->
<script>
(function () {
  /* Syncs the navbar (and its themable buttons) to the section being scrolled into.
     Sections are deliberately NOT targeted: each ltx-section declares its own theme
     via .cc-light, and writing inline vars onto them overrides the class and breaks
     the section until the trigger fires. */

  var THEME_PREFIX  = '--_theme';
  var TRIGGER_POINT = 0.1; /* 10% down the viewport */

  var CHILD_TARGETS =
    '.ltx-but-base:not(.ltx-but-special):not(.is-special):not([data-theme-exclude="true"]),' +
    '.ltx-but-flex:not(.ltx-but-special):not(.is-special):not([data-theme-exclude="true"]),' +
    '.ltx-but-white-small:not(.ltx-but-special):not(.is-special):not([data-theme-exclude="true"])';

  function init() {
    var triggers = Array.prototype.slice.call(document.querySelectorAll('.theme-trigger'));

    var navbar =
      document.querySelector('.navbar-ltx') ||
      document.querySelector('.navbar-new-component') ||
      document.querySelector('.navbar12_component') ||
      document.querySelector('.navbar-ltx2') ||
      document.querySelector('.navbar') ||
      document.querySelector('nav');

    var refBase  = document.querySelector('.theme-ref-base');
    var refLight = document.querySelector('.theme-ref-light');

    if (!triggers.length || !navbar || !refBase || !refLight) return;

    function readThemeVars(el) {
      var s = getComputedStyle(el), out = {}, i, p;
      for (i = 0; i < s.length; i++) {
        p = s[i];
        if (p.indexOf(THEME_PREFIX) === 0) out[p] = s.getPropertyValue(p).trim();
      }
      return out;
    }

    var vars = { base: readThemeVars(refBase), light: readThemeVars(refLight) };

    var allNames = Object.keys(vars.base).concat(Object.keys(vars.light))
      .filter(function (n, i, a) { return a.indexOf(n) === i; });

    function targets() {
      if (navbar.getAttribute('data-theme-exclude') === 'true') return [];
      return [navbar].concat(
        Array.prototype.slice.call(navbar.querySelectorAll(CHILD_TARGETS))
      );
    }

    function apply(mode) {
      var set = vars[mode];
      targets().forEach(function (el) {
        allNames.forEach(function (n) { el.style.removeProperty(n); });
        Object.keys(set).forEach(function (n) { el.style.setProperty(n, set[n]); });
      });
    }

    /* Absolute state, not crossing detection, so a mid-page reload or an anchor jump
       resolves correctly instead of inheriting the scroll-0 state.
       Last trigger above the line wins; animate-theme-to declares the target theme
       ("light" | "base"), empty or missing defaults to "light". */
    function resolveMode() {
      var lineY = window.innerHeight * TRIGGER_POINT;
      var mode  = 'base';

      triggers.forEach(function (el) {
        if (el.getBoundingClientRect().top > lineY) return;
        var wanted = (el.getAttribute('animate-theme-to') || 'light').trim().toLowerCase();
        mode = (wanted === 'base') ? 'base' : 'light';
      });

      return mode;
    }

    var current = null;

    function update() {
      var mode = resolveMode();
      if (mode === current) return;
      current = mode;
      apply(mode);
    }

    var ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () { ticking = false; update(); });
    }

    window.addEventListener('scroll',  onScroll, { passive: true });
    window.addEventListener('resize',  onScroll, { passive: true });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
<!-- ✅ END: Theme on Scroll + Navbar Sync --></body></html>