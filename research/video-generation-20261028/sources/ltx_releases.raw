<style>
  /* Draws animated underline for footer links.
     Secondary footer links use their own text color for the underline. */

  .ltx-footer-link {
    position: relative;
    text-decoration: none !important;
  }

  .ltx-footer-link::after {
    content: '';
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    width: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
    pointer-events: none;
  }

  .ltx-footer-link:hover::after,
  .ltx-footer-link:focus::after {
    transform: scaleX(1);
  }

  /* Secondary footer links: underline matches grey text color */
