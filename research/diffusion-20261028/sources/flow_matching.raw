<p id="A4.F8.fig2.1.1" class="ltx_p"><math id="A4.F8.m1" class="ltx_Math" alttext="t=0.0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0.0</mn></mrow><annotation encoding="application/x-tex">t=0.0</annotation></semantics></math></p>
</span></div></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="A4.F8.fig3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2210.02747v2/2d_vf_flow_match_dif_1.svg" id="A4.F8.g3" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:548/548;" width="548" height="548"></object>
<figcaption class="ltx_caption ltx_centering">
<div id="A4.F8.fig3.1" class="ltx_inline-block ltx_transformed_outer" style="width:17.7pt;height:4.9pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-2.2pt,0.6pt) scale(0.8,0.8) ;">
<p id="A4.F8.fig3.1.1" class="ltx_p"><math id="A4.F8.m2" class="ltx_Math" alttext="t=\nicefrac{{1}}{{3}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mpadded voffset="0.3em"><mn mathsize="0.700em">1</mn></mpadded><mpadded style="width:-0.15em;" lspace="-0.1em" width="-0.15em"><mo stretchy="true" symmetric="true">/</mo></mpadded><mn mathsize="0.700em">3</mn></mrow></mrow><annotation encoding="application/x-tex">t=\nicefrac{{1}}{{3}}</annotation></semantics></math></p>
</span></div></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="A4.F8.fig4" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2210.02747v2/2d_vf_flow_match_dif_2.svg" id="A4.F8.g4" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:548/548;" width="548" height="548"></object>
<figcaption class="ltx_caption ltx_centering">
<div id="A4.F8.fig4.1" class="ltx_inline-block ltx_transformed_outer" style="width:17.7pt;height:4.9pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-2.2pt,0.6pt) scale(0.8,0.8) ;">
<p id="A4.F8.fig4.1.1" class="ltx_p"><math id="A4.F8.m3" class="ltx_Math" alttext="t=\nicefrac{{2}}{{3}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mpadded voffset="0.3em"><mn mathsize="0.700em">2</mn></mpadded><mpadded style="width:-0.15em;" lspace="-0.1em" width="-0.15em"><mo stretchy="true" symmetric="true">/</mo></mpadded><mn mathsize="0.700em">3</mn></mrow></mrow><annotation encoding="application/x-tex">t=\nicefrac{{2}}{{3}}</annotation></semantics></math></p>
</span></div></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="A4.F8.fig5" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2210.02747v2/2d_vf_flow_match_dif_3.svg" id="A4.F8.g5" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:548/548;" width="548" height="548"></object>
<figcaption class="ltx_caption ltx_centering">
<div id="A4.F8.fig5.1" class="ltx_inline-block ltx_transformed_outer" style="width:25.1pt;height:5.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-3.1pt,0.6pt) scale(0.8,0.8) ;">
<p id="A4.F8.fig5.1.1" class="ltx_p"><math id="A4.F8.m4" class="ltx_Math" alttext="t=1.0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">t=1.0</annotation></semantics></math></p>
</span></div></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering">Diffusion path – conditional vector field</figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 8: </span>VP Diffusion path’s conditional vector field. Compare to Figure <a href="#S4.F2" title="Figure 2 ‣ Example I: Diffusion conditional VFs. ‣ 4.1 Special instances of Gaussian conditional probability paths ‣ 4 Conditional Probability Paths and Vector Fields ‣ Flow Matching for Generative Modeling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. </figcaption>
</figure>
<figure id="A4.F9" class="ltx_figure">
<table id="A4.F9.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A4.F9.2.1" class="ltx_tr">
<td id="A4.F9.2.1.1" class="ltx_td ltx_align_center"><img src="2210.02747v2/figures/2d_checker/2d_checkerboard_scoreflow_dif.png" id="A4.F9.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:373/35;" width="373" height="35" alt="Refer to caption"></td></tr>
<tr id="A4.F9.2.2" class="ltx_tr">
<td id="A4.F9.2.2.1" class="ltx_td ltx_align_center">ScoreFlow</td></tr>
<tr id="A4.F9.2.3" class="ltx_tr">
<td id="A4.F9.2.3.1" class="ltx_td ltx_align_center"><img src="2210.02747v2/figures/2d_checker/2d_checkerboard_noise_dif.png" id="A4.F9.g2" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:373/35;" width="373" height="35" alt="Refer to caption"></td></tr>
<tr id="A4.F9.2.4" class="ltx_tr">
<td id="A4.F9.2.4.1" class="ltx_td ltx_align_center">DDPM</td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 9: </span>Trajectories of CNFs trained with ScoreFlow <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib45" title="" class="ltx_ref">Song et al., 2021</a>)</cite> and DDPM <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib18" title="" class="ltx_ref">Ho et al., 2020</a>)</cite> losses on 2D checkerboard data, using the same learning rate and other hyperparameters as Figure <a href="#S5.F4" title="Figure 4 ‣ 5 Related Work ‣ Flow Matching for Generative Modeling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. </figcaption>
</figure>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Implementation details</h2>

<div id="A5.p1" class="ltx_para ltx_noindent">
<p id="A5.p1.1" class="ltx_p">For the 2D example we used an MLP with 5-layers of 512 neurons each, while for images we used the UNet architecture from <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib11" title="" class="ltx_ref">Dhariwal &amp; Nichol (2021)</a></cite>.
For images, we center crop images and resize to the appropriate dimension, whereas for the 32<math id="A5.p1.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>32 and 64<math id="A5.p1.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>64 resolutions we use the same pre-processing as <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib8" title="" class="ltx_ref">Chrabaszcz et al., 2017</a>)</cite>.
The three methods (FM-OT, FM-Diffusion, and SM-Diffusion) are always trained on the same architecture, same hyper-parameters, and for the same number of epochs.</p>
</div>
<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Diffusion baselines</h3>

<section id="A5.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Losses.</h4>

<div id="A5.SS1.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A5.SS1.SSS0.Px1.p1.1" class="ltx_p">We consider three options as diffusion baselines that correspond to the most popular diffusion loss parametrizations <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib43" title="" class="ltx_ref">Song &amp; Ermon, 2019</a>; <a href="#bib.bib45" title="" class="ltx_ref">Song et al., 2021</a>; <a href="#bib.bib18" title="" class="ltx_ref">Ho et al., 2020</a>; <a href="#bib.bib21" title="" class="ltx_ref">Kingma et al., 2021</a>)</cite>. We will assume general Gaussian path form of equation <a href="#S4.E10" title="In 4 Conditional Probability Paths and Vector Fields ‣ Flow Matching for Generative Modeling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, <span id="A5.SS1.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_italic">i.e.</span>,</p>
<table id="A5.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex45.m1" class="ltx_Math" alttext="p_{t}(x|x_{1})={\mathcal{N}}(x|\mu_{t}(x_{1}),\sigma_{t}^{2}(x_{1})I)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><msub><mi>μ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p_{t}(x|x_{1})={\mathcal{N}}(x|\mu_{t}(x_{1}),\sigma_{t}^{2}(x_{1})I).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A5.SS1.SSS0.Px1.p2.1" class="ltx_p">Score Matching loss is</p>
<table id="A5.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E42.m1" class="ltx_Math" alttext="\displaystyle{\mathcal{L}}_{\scriptscriptstyle\text{SM}}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext mathsize="0.710em">SM</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathcal{L}}_{\scriptscriptstyle\text{SM}}(\theta)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E42.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{t,q(x_{1}),p_{t}(x|x_{1})}\lambda(t)\left\|s_{t}(x)-\nabla\log p_{t}(x|x_{1})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><msub><mi>s</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>t</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{t,q(x_{1}),p_{t}(x|x_{1})}\lambda(t)\left\|s_{t}(x)-\nabla\log p_{t}(x|x_{1})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
<tbody id="A5.E43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E43.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{t,q(x_{1}),p_{t}(x|x_{1})}\lambda(t)\left\|s_{t}(x)-\frac{x-\mu_{t}(x_{1})}{\sigma_{t}^{2}(x_{1})}\right\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><msub><mi>s</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>−</mo><mrow><msub><mi>μ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{t,q(x_{1}),p_{t}(x|x_{1})}\lambda(t)\left\|s_{t}(x)-\frac{x-\mu_{t}(x_{1})}{\sigma_{t}^{2}(x_{1})}\right\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(43)</span></td></tr></tbody>
</table>
<p id="A5.SS1.SSS0.Px1.p2.2" class="ltx_p">Taking <math id="A5.SS1.SSS0.Px1.p2.m1" class="ltx_Math" alttext="\lambda(t)=\sigma_{t}^{2}(x_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>σ</mi><mi>t</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda(t)=\sigma_{t}^{2}(x_{1})</annotation></semantics></math> corresponds to the original Score Matching (SM) loss from <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib43" title="" class="ltx_ref">Song &amp; Ermon (2019)</a></cite>, while considering <math id="A5.SS1.SSS0.Px1.p2.m2" class="ltx_Math" alttext="\lambda(t)=\beta(1-t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda(t)=\beta(1-t)</annotation></semantics></math> (<math id="A5.SS1.SSS0.Px1.p2.m3" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> is defined below) corresponds to the Score Flow (SF) loss motivated by an NLL upper bound <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib45" title="" class="ltx_ref">Song et al., 2021</a>)</cite>; <math id="A5.SS1.SSS0.Px1.p2.m4" class="ltx_Math" alttext="s_{t}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>t</mi></msub><annotation encoding="application/x-tex">s_{t}</annotation></semantics></math> is the learnable score function. DDPM (Noise Matching) loss from <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib18" title="" class="ltx_ref">Ho et al. (2020)</a></cite> (equation 14) is</p>
<table id="A5.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E44.m1" class="ltx_Math" alttext="\displaystyle{\mathcal{L}}_{\scriptscriptstyle\text{NM}}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext mathsize="0.710em">NM</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathcal{L}}_{\scriptscriptstyle\text{NM}}(\theta)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E44.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{t,q(x_{1}),p_{t}(x|x_{1})}\left\|\epsilon_{t}(x)-\frac{x-\mu_{t}(x_{1})}{\sigma_{t}(x_{1})}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><msub><mi>ϵ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>x</mi><mo>−</mo><mrow><msub><mi>μ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{t,q(x_{1}),p_{t}(x|x_{1})}\left\|\epsilon_{t}(x)-\frac{x-\mu_{t}(x_{1})}{\sigma_{t}(x_{1})}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(44)</span></td></tr></tbody>
<tbody id="A5.E45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E45.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{t,q(x_{1}),p_{0}(x_{0})}\Big\|{\epsilon_{t}(\sigma_{t}(x_{1})x_{0}+\mu_{t}(x_{1}))-x_{0}}\Big\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>t</mi><mo>,</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><msub><mi>ϵ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><msub><mi>μ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>x</mi><mn>0</mn></msub></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{t,q(x_{1}),p_{0}(x_{0})}\Big\|{\epsilon_{t}(\sigma_{t}(x_{1})x_{0}+\mu_{t}(x_{1}))-x_{0}}\Big\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
<p id="A5.SS1.SSS0.Px1.p2.3" class="ltx_p">where <math id="A5.SS1.SSS0.Px1.p2.m5" class="ltx_Math" alttext="p_{0}(x)={\mathcal{N}}(x|0,I)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mn>0</mn><mo>,</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p_{0}(x)={\mathcal{N}}(x|0,I)</annotation></semantics></math> is the standard Gaussian, and <math id="A5.SS1.SSS0.Px1.p2.m6" class="ltx_Math" alttext="\epsilon_{t}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\epsilon_{t}</annotation></semantics></math> is the learnable noise function.</p>
</div>
</section>
<section id="A5.SS1.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Diffusion path.</h4>

<div id="A5.SS1.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A5.SS1.SSS0.Px2.p1.1" class="ltx_p">For the diffusion path we use the standard VP diffusion (equation <a href="#S4.E19" title="In Example I: Diffusion conditional VFs. ‣ 4.1 Special instances of Gaussian conditional probability paths ‣ 4 Conditional Probability Paths and Vector Fields ‣ Flow Matching for Generative Modeling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>), namely,</p>
<table id="A5.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex46.m1" class="ltx_Math" alttext="\mu_{t}(x_{1})=\alpha_{1-t}x_{1},\quad\sigma_{t}(x_{1})=\sqrt{1-\alpha_{1-t}^{2}},\quad\text{where }\alpha_{t}=e^{-\frac{1}{2}T(t)},\quad T(t)=\int_{0}^{t}\beta(s)ds," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>μ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>α</mi><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>1</mn></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mi>α</mi><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mn>2</mn></msubsup></mrow></msqrt></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mtext>where </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo>=</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>t</mi></msubsup><mrow><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mu_{t}(x_{1})=\alpha_{1-t}x_{1},\quad\sigma_{t}(x_{1})=\sqrt{1-\alpha_{1-t}^{2}},\quad\text{where }\alpha_{t}=e^{-\frac{1}{2}T(t)},\quad T(t)=\int_{0}^{t}\beta(s)ds,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.SSS0.Px2.p1.2" class="ltx_p">with, as suggested in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib44" title="" class="ltx_ref">Song et al. (2020b)</a></cite>, <math id="A5.SS1.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\beta(s)=\beta_{\min}+s(\beta_{\max}-\beta_{\min})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>β</mi><mi>min</mi></msub><mo>+</mo><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mi>max</mi></msub><mo>−</mo><msub><mi>β</mi><mi>min</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta(s)=\beta_{\min}+s(\beta_{\max}-\beta_{\min})</annotation></semantics></math> and consequently</p>
<table id="A5.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex47.m1" class="ltx_Math" alttext="T(s)=\int_{0}^{s}\beta(r)dr=s\beta_{\min}+\frac{1}{2}s^{2}(\beta_{\max}-\beta_{\min})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mi>s</mi></msubsup><mrow><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>β</mi><mi>min</mi></msub></mrow><mo>+</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mi>s</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>β</mi><mi>max</mi></msub><mo>−</mo><msub><mi>β</mi><mi>min</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">T(s)=\int_{0}^{s}\beta(r)dr=s\beta_{\min}+\frac{1}{2}s^{2}(\beta_{\max}-\beta_{\min}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.SSS0.Px2.p1.3" class="ltx_p">where <math id="A5.SS1.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\beta_{\min}=0.1" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>min</mi></msub><mo>=</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">\beta_{\min}=0.1</annotation></semantics></math>, <math id="A5.SS1.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\beta_{\max}=20" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>max</mi></msub><mo>=</mo><mn>20</mn></mrow><annotation encoding="application/x-tex">\beta_{\max}=20</annotation></semantics></math> and time is sampled in <math id="A5.SS1.SSS0.Px2.p1.m4" class="ltx_Math" alttext="[0,1-{\epsilon}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1-{\epsilon}]</annotation></semantics></math>, <math id="A5.SS1.SSS0.Px2.p1.m5" class="ltx_Math" alttext="{\epsilon}=10^{-5}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\epsilon}=10^{-5}</annotation></semantics></math> for training and likelihood and <math id="A5.SS1.SSS0.Px2.p1.m6" class="ltx_Math" alttext="{\epsilon}=10^{-5}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">{\epsilon}=10^{-5}</annotation></semantics></math> for sampling.</p>
</div>
</section>
<section id="A5.SS1.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Sampling.</h4>

<div id="A5.SS1.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A5.SS1.SSS0.Px3.p1.1" class="ltx_p">Score matching samples are produced by solving the ODE (equation <a href="#S2.E1" title="In 2 Preliminaries: Continuous Normalizing Flows ‣ Flow Matching for Generative Modeling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) with the vector field</p>
<table id="A5.E46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E46.m1" class="ltx_Math" alttext="u_{t}(x)=-\frac{T^{\prime}(1-t)}{2}\left[s_{t}(x)-x\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mfrac><mrow><msup><mi>T</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>s</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>x</mi></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">u_{t}(x)=-\frac{T^{\prime}(1-t)}{2}\left[s_{t}(x)-x\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
</table>
<p id="A5.SS1.SSS0.Px3.p1.2" class="ltx_p">DDPM samples are computed with equation <a href="#A5.E46" title="In Sampling. ‣ E.1 Diffusion baselines ‣ Appendix E Implementation details ‣ Flow Matching for Generative Modeling" class="ltx_ref"><span class="ltx_text ltx_ref_tag">46</span></a> after setting <math id="A5.SS1.SSS0.Px3.p1.m1" class="ltx_Math" alttext="s_{t}(x)=\epsilon_{t}(x)/\sigma_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>ϵ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>σ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">s_{t}(x)=\epsilon_{t}(x)/\sigma_{t}</annotation></semantics></math>, where <math id="A5.SS1.SSS0.Px3.p1.m2" class="ltx_Math" alttext="\sigma_{t}=\sqrt{1-\alpha_{1-t}^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo>=</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mi>α</mi><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mn>2</mn></msubsup></mrow></msqrt></mrow><annotation encoding="application/x-tex">\sigma_{t}=\sqrt{1-\alpha_{1-t}^{2}}</annotation></semantics></math>.</p>
</div>
</section>
</section>
