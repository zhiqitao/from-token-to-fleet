<figure id="S4.F2.fig10" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2210.02747v2/2d_vf_flow_match_ot_3.svg" id="S4.F2.g9" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:548/548;" width="548" height="548"></object>
