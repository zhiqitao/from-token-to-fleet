<p id="S4.F2.fig8.1.1" class="ltx_p"><math id="S4.F2.m6" class="ltx_Math" alttext="t=\nicefrac{{1}}{{3}}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mpadded voffset="0.3em"><mn mathsize="0.700em">1</mn></mpadded><mpadded style="width:-0.15em;" lspace="-0.1em" width="-0.15em"><mo stretchy="true" symmetric="true">/</mo></mpadded><mn mathsize="0.700em">3</mn></mrow></mrow><annotation encoding="application/x-tex">t=\nicefrac{{1}}{{3}}</annotation></semantics></math></p>
</span></div></figcaption>
