<p id="S4.F2.fig7.1.1" class="ltx_p"><math id="S4.F2.m5" class="ltx_Math" alttext="t=0.0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0.0</mn></mrow><annotation encoding="application/x-tex">t=0.0</annotation></semantics></math></p>
