<span id="S3.T2.9.1.1.1.1.1.1.17.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.9.1.1.1.1.1.1.17.3.1" class="ltx_text ltx_font_bold">57.6</span> (4)</span>
