<div id="alg5.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
               <span id="alg5.l5.3" class="ltx_text ltx_font_bold">if</span> <math id="alg5.l5.m1" class="ltx_Math" alttext="r_{t}^{i}\neq\textrm{M}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mi>t</mi><mi>i</mi></msubsup><mo>≠</mo><mtext>M</mtext></mrow><annotation encoding="application/x-tex">r_{t}^{i}\neq\textrm{M}</annotation></semantics></math> <span id="alg5.l5.4" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg5.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
                <math id="alg5.l6.m1" class="ltx_Math" alttext="r_{0}^{i}=r_{t}^{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mn>0</mn><mi>i</mi></msubsup><mo>=</mo><msubsup><mi>r</mi><mi>t</mi><mi>i</mi></msubsup></mrow><annotation encoding="application/x-tex">r_{0}^{i}=r_{t}^{i}</annotation></semantics></math>, <math id="alg5.l6.m2" class="ltx_Math" alttext="c^{i}=1" display="inline" intent=":literal"><semantics><mrow><msup><mi>c</mi><mi>i</mi></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c^{i}=1</annotation></semantics></math>

</div>
<div id="alg5.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
               <span id="alg5.l7.3" class="ltx_text ltx_font_bold">else</span>


</div>
<div id="alg5.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
                <math id="alg5.l8.m1" class="ltx_Math" alttext="r_{0}^{i}=\arg\max_{r_{0}^{i}}p_{\theta}(r_{0}^{i}|p_{0},r_{t})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mn>0</mn><mi>i</mi></msubsup><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><msubsup><mi>r</mi><mn>0</mn><mi>i</mi></msubsup></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>r</mi><mn>0</mn><mi>i</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>p</mi><mn>0</mn></msub><mo>,</mo><msub><mi>r</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{0}^{i}=\arg\max_{r_{0}^{i}}p_{\theta}(r_{0}^{i}|p_{0},r_{t})</annotation></semantics></math>

</div>
<div id="alg5.l9" class="ltx_listingline">
