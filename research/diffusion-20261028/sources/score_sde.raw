<span id="A7.T4.2.1.1.1.1.1.1.4.3.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:19.1pt;height:5.1pt;vertical-align:-0.6pt;"><span class="ltx_transformed_inner" style="transform:translate(-4.1pt,1.1pt) scale(0.7,0.7) ;">
