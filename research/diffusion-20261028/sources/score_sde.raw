</div>
<div id="alg2.l7" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">7:</span>
                
                
                <math id="alg2.l7.m1" class="ltx_Math" alttext="\mathbf{z}\sim\mathcal{N}(\mathbf{0},\mathbf{I})" display="inline" intent=":literal"><semantics><mrow><mi>𝐳</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{z}\sim\mathcal{N}(\mathbf{0},\mathbf{I})</annotation></semantics></math>

</div>
<div id="alg2.l8" class="ltx_listingline">
