<tbody id="A4.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex9.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex9.m2" class="ltx_math_unparsed" alttext="\displaystyle p_{t}(\mathbf{x})\nabla\cdot[\mathbf{G}(\mathbf{x},t)\mathbf{G}(\mathbf{x},t)^{\mkern-1.5mu\mathsf{T}}]+p_{t}(\mathbf{x})\mathbf{G}(\mathbf{x},t)\mathbf{G}(\mathbf{x},t)^{\mkern-1.5mu\mathsf{T}}\nabla_{\mathbf{x}}\log p_{t}(\mathbf{x})," display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mo>∇</mo><mo lspace="0em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">[</mo><mi>𝐆</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>𝐆</mi><msup><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>𝖳</mi></msup><mo stretchy="false">]</mo></mrow><mo>+</mo><msub><mi>p</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mi>𝐆</mi><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mi>𝐆</mi><msup><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>𝖳</mi></msup><msub><mo rspace="0.167em">∇</mo><mi>𝐱</mi></msub><mi>log</mi><msub><mi>p</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle p_{t}(\mathbf{x})\nabla\cdot[\mathbf{G}(\mathbf{x},t)\mathbf{G}(\mathbf{x},t)^{\mkern-1.5mu\mathsf{T}}]+p_{t}(\mathbf{x})\mathbf{G}(\mathbf{x},t)\mathbf{G}(\mathbf{x},t)^{\mkern-1.5mu\mathsf{T}}\nabla_{\mathbf{x}}\log p_{t}(\mathbf{x}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p1.5" class="ltx_p">based on which we can continue the rewriting of <a href="#A4.E36" title="In D.1 Derivation ‣ Appendix D Probability flow ODE ‣ Score-Based Generative Modeling through Stochastic Differential Equations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">36</span></a> to obtain</p>
<table id="A4.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex10.m1" class="ltx_Math" alttext="\displaystyle\frac{\partial p_{t}(\mathbf{x})}{\partial t}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><mi>t</mi></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial p_{t}(\mathbf{x})}{\partial t}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex10.m2" class="ltx_math_unparsed" alttext="\displaystyle=-\sum_{i=1}^{d}\frac{\partial}{\partial x_{i}}[f_{i}(\mathbf{x},t)p_{t}(\mathbf{x})]+\frac{1}{2}\sum_{i=1}^{d}\frac{\partial}{\partial x_{i}}\Big[\sum_{j=1}^{d}\frac{\partial}{\partial x_{j}}\Big[\sum_{k=1}^{d}G_{ik}(\mathbf{x},t)G_{jk}(\mathbf{x},t)p_{t}(\mathbf{x})\Big]\Big]" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>x</mi><mi>i</mi></msub></mrow></mfrac></mstyle><mrow><mo stretchy="false">[</mo><msub><mi>f</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>x</mi><mi>i</mi></msub></mrow></mfrac></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>x</mi><mi>j</mi></msub></mrow></mfrac></mstyle><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover></mstyle><msub><mi>G</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msub><mi>G</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msub><mi>p</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\sum_{i=1}^{d}\frac{\partial}{\partial x_{i}}[f_{i}(\mathbf{x},t)p_{t}(\mathbf{x})]+\frac{1}{2}\sum_{i=1}^{d}\frac{\partial}{\partial x_{i}}\Big[\sum_{j=1}^{d}\frac{\partial}{\partial x_{j}}\Big[\sum_{k=1}^{d}G_{ik}(\mathbf{x},t)G_{jk}(\mathbf{x},t)p_{t}(\mathbf{x})\Big]\Big]</annotation></semantics></math></td>
