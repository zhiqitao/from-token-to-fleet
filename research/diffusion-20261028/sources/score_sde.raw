<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A9.Ex41.m1" class="ltx_Math" alttext="\displaystyle\approx p_{t}(\mathbf{z}(t)\mid\hat{\Omega}(\mathbf{x}(t)))," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≈</mo><mrow><msub><mi>p</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐳</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mover accent="true"><mi mathvariant="normal">Ω</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐱</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\approx p_{t}(\mathbf{z}(t)\mid\hat{\Omega}(\mathbf{x}(t))),</annotation></semantics></math></td>
