(<span id="Ax1.T6.5.1.5.7.2.1.1.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF8000;">3.6<math id="Ax1.T6.m18" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span>)</span></span></span></span>
