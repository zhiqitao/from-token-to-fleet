<span id="Ax1.T6.5.1.5.8.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="Ax1.T6.5.1.5.8.2.1.1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#0000FF;">186.2<span id="Ax1.T6.5.1.5.8.2.1.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">
(<span id="Ax1.T6.5.1.5.8.2.1.1.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF8000;">3.6<math id="Ax1.T6.m19" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span>)</span></span></span></span>
</span></span><span id="Ax1.T6.5.1.5.8.3" class="ltx_text"></span></td>
