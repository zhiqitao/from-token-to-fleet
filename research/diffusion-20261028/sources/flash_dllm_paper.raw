<td id="S3.T1.9.1.3.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="S3.T1.9.1.3.1.1" class="ltx_text"><span id="S3.T1.9.1.3.1.1.1" class="ltx_text"></span> <span id="S3.T1.9.1.3.1.1.2" class="ltx_text">
<span id="S3.T1.9.1.3.1.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T1.9.1.3.1.1.2.1.1" class="ltx_tr">
<span id="S3.T1.9.1.3.1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">GSM8K</span></span>
<span id="S3.T1.9.1.3.1.1.2.1.2" class="ltx_tr">
<span id="S3.T1.9.1.3.1.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">(5-shot)</span></span>
</span></span><span id="S3.T1.9.1.3.1.1.3" class="ltx_text"></span></span></td>
<td id="S3.T1.9.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">256</td>
<td id="S3.T1.9.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.9.1.3.3.1" class="ltx_text"></span> <span id="S3.T1.9.1.3.3.2" class="ltx_text">
<span id="S3.T1.9.1.3.3.2.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T1.9.1.3.3.2.1.1" class="ltx_tr">
