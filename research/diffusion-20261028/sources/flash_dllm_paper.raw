                <span id="algx2.l4.3" class="ltx_text" style="font-size:70%;">    Load </span><math id="algx2.l4.m1" class="ltx_Math" alttext="\mathbf{x}\leftarrow\mathbf{X}_{i,j}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">𝐱</mi><mo mathsize="0.700em" stretchy="false">←</mo><msub><mi mathsize="0.700em">𝐗</mi><mrow><mi mathsize="0.700em">i</mi><mo mathsize="0.700em">,</mo><mi mathsize="0.700em">j</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathbf{x}\leftarrow\mathbf{X}_{i,j}</annotation></semantics></math><span id="algx2.l4.4" class="ltx_text" style="font-size:70%;">
</span><span id="algx2.l4.5" class="ltx_text" style="font-size:70%;float:right;"><span id="algx2.l4.5.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#1C69A4;">// HBM <math id="algx2.l4.m2" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#1C69A4;" mathcolor="#1C69A4" stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math> SRAM</span>
