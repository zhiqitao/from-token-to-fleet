<span id="Ax1.T6.5.1.5.9.2.1" class="ltx_tabular ltx_align_middle">
<span id="Ax1.T6.5.1.5.9.2.1.1" class="ltx_tr">
<span id="Ax1.T6.5.1.5.9.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="Ax1.T6.5.1.5.9.2.1.1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#0000FF;">195.5<span id="Ax1.T6.5.1.5.9.2.1.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">
(<span id="Ax1.T6.5.1.5.9.2.1.1.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF8000;">3.6<math id="Ax1.T6.m20" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span>)</span></span></span></span>
</span></span><span id="Ax1.T6.5.1.5.9.3" class="ltx_text"></span></td>
<td id="Ax1.T6.5.1.5.10" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="Ax1.T6.5.1.5.10.1" class="ltx_text"></span> <span id="Ax1.T6.5.1.5.10.2" class="ltx_text">
<span id="Ax1.T6.5.1.5.10.2.1" class="ltx_tabular ltx_align_middle">
<span id="Ax1.T6.5.1.5.10.2.1.1" class="ltx_tr">
<span id="Ax1.T6.5.1.5.10.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="Ax1.T6.5.1.5.10.2.1.1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#0000FF;">199.8<span id="Ax1.T6.5.1.5.10.2.1.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">
(<span id="Ax1.T6.5.1.5.10.2.1.1.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF8000;">3.6<math id="Ax1.T6.m21" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span>)</span></span></span></span>
</span></span><span id="Ax1.T6.5.1.5.10.3" class="ltx_text"></span></td></tr>
