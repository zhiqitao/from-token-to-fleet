<span id="Ax1.T5.st2.7.1.7.3.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.2pt 2.5pt;"><span id="Ax1.T5.st2.7.1.7.3.3.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">5.7</span></span></span>
</span></span><span id="Ax1.T5.st2.7.1.7.3.4" class="ltx_text"></span></td>
<td id="Ax1.T5.st2.7.1.7.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.2pt 2.5pt;"><span id="Ax1.T5.st2.7.1.7.4.1" class="ltx_text"></span><span id="Ax1.T5.st2.7.1.7.4.2" class="ltx_text" style="font-size:70%;"> </span><span id="Ax1.T5.st2.7.1.7.4.3" class="ltx_text" style="font-size:70%;">
<span id="Ax1.T5.st2.7.1.7.4.3.1" class="ltx_tabular ltx_align_middle">
<span id="Ax1.T5.st2.7.1.7.4.3.1.1" class="ltx_tr">
<span id="Ax1.T5.st2.7.1.7.4.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.2pt 2.5pt;"><span id="Ax1.T5.st2.7.1.7.4.3.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">5.7</span></span></span>
</span></span><span id="Ax1.T5.st2.7.1.7.4.4" class="ltx_text"></span></td>
<td id="Ax1.T5.st2.7.1.7.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.2pt 2.5pt;"><span id="Ax1.T5.st2.7.1.7.5.1" class="ltx_text"></span><span id="Ax1.T5.st2.7.1.7.5.2" class="ltx_text" style="font-size:70%;"> </span><span id="Ax1.T5.st2.7.1.7.5.3" class="ltx_text" style="font-size:70%;">
<span id="Ax1.T5.st2.7.1.7.5.3.1" class="ltx_tabular ltx_align_middle">
