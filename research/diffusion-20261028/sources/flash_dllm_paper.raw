<span id="Ax1.T4.5.1.9.4.2.1.2" class="ltx_tr">
<span id="Ax1.T4.5.1.9.4.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.75pt 7.0pt;"><math id="Ax1.T4.m122" class="ltx_Math" alttext="138.28" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">138.28</mn><annotation encoding="application/x-tex">138.28</annotation></semantics></math><span id="Ax1.T4.5.1.9.4.2.1.2.1.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"> <math id="Ax1.T4.m123" class="ltx_Math" alttext="\pm\,0.37" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathsize="0.800em">±</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" mathsize="0.800em"> 0.37</mn></mrow><annotation encoding="application/x-tex">\pm\,0.37</annotation></semantics></math></span></span></span>
</span></span><span id="Ax1.T4.5.1.9.4.3" class="ltx_text"></span></td>
<td id="Ax1.T4.5.1.9.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.75pt 7.0pt;"><span id="Ax1.T4.5.1.9.5.1" class="ltx_text"></span> <span id="Ax1.T4.5.1.9.5.2" class="ltx_text">
<span id="Ax1.T4.5.1.9.5.2.1" class="ltx_tabular ltx_align_middle">
<span id="Ax1.T4.5.1.9.5.2.1.1" class="ltx_tr">
<span id="Ax1.T4.5.1.9.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-bottom: -1.0pt;padding:0.75pt 7.0pt;"><math id="Ax1.T4.m124" class="ltx_Math" alttext="83.41" display="inline" intent=":literal"><semantics><mn>83.41</mn><annotation encoding="application/x-tex">83.41</annotation></semantics></math> <math id="Ax1.T4.m125" class="ltx_Math" alttext="\pm\,0.50" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">±</mo><mn mathsize="0.800em"> 0.50</mn></mrow><annotation encoding="application/x-tex">\pm\,0.50</annotation></semantics></math></span></span>
<span id="Ax1.T4.5.1.9.5.2.1.2" class="ltx_tr">
