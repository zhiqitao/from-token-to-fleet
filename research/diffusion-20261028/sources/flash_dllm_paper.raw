<td id="S3.T2.5.1.3.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.5.1.3.5.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">38.4</span> (<span id="S3.T2.5.1.3.5.2" class="ltx_text" style="--ltx-fg-color:#FF8000;">14.8<math id="S3.T2.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span>)</td>
