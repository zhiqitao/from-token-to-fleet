h id="algx1.l1.m8" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math><span id="algx1.l1.11" class="ltx_text" style="font-size:70%;">, batch size </span><math id="algx1.l1.m9" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math><span id="algx1.l1.12" class="ltx_text" style="font-size:70%;">, heads </span><math id="algx1.l1.m10" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math><span id="algx1.l1.13" class="ltx_text" style="font-size:70%;">
