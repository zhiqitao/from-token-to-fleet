<tr id="Ax1.T3.5.1.3" class="ltx_tr">
<td id="Ax1.T3.5.1.3.1" class="ltx_td ltx_align_center">512</td>
<td id="Ax1.T3.5.1.3.2" class="ltx_td ltx_align_center">64</td>
<td id="Ax1.T3.5.1.3.3" class="ltx_td ltx_align_center">64</td>
<td id="Ax1.T3.5.1.3.4" class="ltx_td ltx_align_center">0.8</td>
<td id="Ax1.T3.5.1.3.5" class="ltx_td ltx_align_center">32</td></tr>
<tr id="Ax1.T3.5.1.4" class="ltx_tr">
<td id="Ax1.T3.5.1.4.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="Ax1.T3.5.1.4.1.1" class="ltx_text">MATH (4-shot)</span></td>
<td id="Ax1.T3.5.1.4.2" class="ltx_td ltx_align_center ltx_border_t">256</td>
<td id="Ax1.T3.5.1.4.3" class="ltx_td ltx_align_center ltx_border_t">64</td>
<td id="Ax1.T3.5.1.4.4" class="ltx_td ltx_align_center ltx_border_t">64</td>
<td id="Ax1.T3.5.1.4.5" class="ltx_td ltx_align_center ltx_border_t">0.85</td>
<td id="Ax1.T3.5.1.4.6" class="ltx_td ltx_align_center ltx_border_t">32</td></tr>
<tr id="Ax1.T3.5.1.5" class="ltx_tr">
<td id="Ax1.T3.5.1.5.1" class="ltx_td ltx_align_center">512</td>
<td id="Ax1.T3.5.1.5.2" class="ltx_td ltx_align_center">64</td>
<td id="Ax1.T3.5.1.5.3" class="ltx_td ltx_align_center">64</td>
<td id="Ax1.T3.5.1.5.4" class="ltx_td ltx_align_center">0.85</td>
<td id="Ax1.T3.5.1.5.5" class="ltx_td ltx_align_center">32</td></tr>
<tr id="Ax1.T3.5.1.6" class="ltx_tr">
<td id="Ax1.T3.5.1.6.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="Ax1.T3.5.1.6.1.1" class="ltx_text">Humaneval (0-shot)</span></td>
<td id="Ax1.T3.5.1.6.2" class="ltx_td ltx_align_center ltx_border_t">256</td>
