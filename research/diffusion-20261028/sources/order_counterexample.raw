<div id="p5" class="ltx_para ltx_noindent">
<p id="p5.1" class="ltx_p"><span id="p5.1.1" class="ltx_text ltx_font_bold">The Flexibility Trap: Rethinking the Value of Arbitrary Order in Diffusion Language Models</span></p>
</div>
<div id="p6" class="ltx_para ltx_noindent">
<p id="p6.1" class="ltx_p"><span id="p6.1.1" class="ltx_text ltx_font_bold">Zanlin Ni<math id="p6.m1" class="ltx_Math" alttext="{}^{\,1\,}" display="inline" intent=":literal"><semantics><msup><mrow></mrow><mn> 1</mn></msup><annotation encoding="application/x-tex">{}^{\,1\,}</annotation></semantics></math></span><span id="p6.1.2" class="ltx_text ltx_font_bold">,
<span id="p6.1.2.1" class="ltx_text">Shenzhi Wang<sup id="p6.1.2.1.1" class="ltx_sup"><span id="p6.1.2.1.1.1" class="ltx_text ltx_font_italic"> 1</span></sup></span>,
<span id="p6.1.2.2" class="ltx_text">Yang Yue<sup id="p6.1.2.2.1" class="ltx_sup"><span id="p6.1.2.2.1.1" class="ltx_text ltx_font_italic"> 1</span></sup></span>,
<span id="p6.1.2.3" class="ltx_text">Tianyu Yu<sup id="p6.1.2.3.1" class="ltx_sup"><span id="p6.1.2.3.1.1" class="ltx_text ltx_font_italic"> 2</span></sup></span>,
<span id="p6.1.2.4" class="ltx_text">Weilin Zhao<sup id="p6.1.2.4.1" class="ltx_sup"><span id="p6.1.2.4.1.1" class="ltx_text ltx_font_italic"> 2</span></sup></span>,
<span id="p6.1.2.5" class="ltx_text">Yeguo Hua<sup id="p6.1.2.5.1" class="ltx_sup"><span id="p6.1.2.5.1.1" class="ltx_text ltx_font_italic"> 3</span></sup></span>,
<span id="p6.1.2.6" class="ltx_text">Tianyi Chen<sup id="p6.1.2.6.1" class="ltx_sup"><span id="p6.1.2.6.1.1" class="ltx_text ltx_font_italic"> 3</span></sup></span>,
<span id="p6.1.2.7" class="ltx_text">Jun Song<sup id="p6.1.2.7.1" class="ltx_sup"><span id="p6.1.2.7.1.1" class="ltx_text ltx_font_italic"> 4</span></sup></span>,
<span id="p6.1.2.8" class="ltx_text">Cheng Yu<sup id="p6.1.2.8.1" class="ltx_sup"><span id="p6.1.2.8.1.1" class="ltx_text ltx_font_italic"> 4</span></sup></span>,
<span id="p6.1.2.9" class="ltx_text">Bo Zheng<sup id="p6.1.2.9.1" class="ltx_sup"><span id="p6.1.2.9.1.1" class="ltx_text ltx_font_italic"> 4</span></sup></span>,
