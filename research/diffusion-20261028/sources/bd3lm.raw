<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.2 </span>Sample Quality and Variable-Length Sequence Generation</h3>

<figure id="S6.T6" class="ltx_table ltx_align_floatright" style="width:38%;">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table">Table 6: </span>Generation length statistics from sampling 500 documents from models trained on OWT.</figcaption>
<table id="S6.T6.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S6.T6.2.1" class="ltx_tr">
<th id="S6.T6.2.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"></th>
<td id="S6.T6.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;">Median</td>
<td id="S6.T6.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;">Max</td></tr>
<tr id="S6.T6.2.2" class="ltx_tr">
<th id="S6.T6.2.2.1" class="ltx_td ltx_th ltx_th_row" style="padding-left:2.0pt;padding-right:2.0pt;"></th>
<td id="S6.T6.2.2.2" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"># tokens</td>
<td id="S6.T6.2.2.3" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"># tokens</td></tr>
<tr id="S6.T6.2.3" class="ltx_tr">
<th id="S6.T6.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;">OWT train set</th>
<td id="S6.T6.2.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;">717</td>
<td id="S6.T6.2.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;">131K</td></tr>
<tr id="S6.T6.2.4" class="ltx_tr">
<th id="S6.T6.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.0pt;padding-right:2.0pt;">AR</th>
<td id="S6.T6.2.4.2" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">4008</td>
<td id="S6.T6.2.4.3" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">131K</td></tr>
<tr id="S6.T6.2.5" class="ltx_tr">
<th id="S6.T6.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;">SEDD</th>
<td id="S6.T6.2.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;">1021</td>
<td id="S6.T6.2.5.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;">1024</td></tr>
<tr id="S6.T6.2.6" class="ltx_tr">
<th id="S6.T6.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;">BD3-LM <math id="S6.T6.m1" class="ltx_Math" alttext="L^{\prime}=16" display="inline" intent=":literal"><semantics><mrow><msup><mi>L</mi><mo>′</mo></msup><mo>=</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">L^{\prime}=16</annotation></semantics></math></th>
<td id="S6.T6.2.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;">798</td>
