<td id="S5.F13.2.1.2.2" class="ltx_td ltx_align_center"><span id="S5.F13.2.1.2.2.1" class="ltx_text" style="font-size:90%;">(B) Wild Animals <math id="S5.F13.m2" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> Cat</span></td>
<td id="S5.F13.2.1.2.3" class="ltx_td ltx_align_center"><span id="S5.F13.2.1.2.3.1" class="ltx_text" style="font-size:90%;">(C) MetFace <math id="S5.F13.m3" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> CelebA Face</span></td>
<td id="S5.F13.2.1.2.4" class="ltx_td ltx_align_center"><span id="S5.F13.2.1.2.4.1" class="ltx_text" style="font-size:90%;">(D) CelebA Face <math id="S5.F13.m4" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> MetFace</span></td></tr>
