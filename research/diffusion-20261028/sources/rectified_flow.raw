<td id="S5.F15.2.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding:-3pt 1.0pt;"><img src="2209.03003v1/arxiv_figures/trajectory/image_6.png" id="S5.F15.g4" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:229/39;" width="229" height="39" alt="Refer to caption"></td></tr>
