</span></span>
<span id="A6.T11.2.4.3.1.1.2.17.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top" style="padding-top:0.75pt;padding-bottom:0.75pt;">
<span id="A6.T11.2.4.3.1.1.2.17.2.1" class="ltx_inline-block ltx_align_top" style="width:325.0pt;">
<span id="A6.T11.2.4.3.1.1.2.17.2.1.1" class="ltx_p ltx_align_left">turn left</span>
</span></span></span>
<span id="A6.T11.2.4.3.1.1.2.18" class="ltx_tr">
<span id="A6.T11.2.4.3.1.1.2.18.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.75pt;padding-bottom:0.75pt;">
