<td id="A4.T8.2.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.75pt 3.0pt;"><span id="A4.T8.2.1.5.1" class="ltx_text ltx_font_bold">Pass</span></td>
