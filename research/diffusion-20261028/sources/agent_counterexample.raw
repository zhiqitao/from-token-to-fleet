<span id="A6.T12.2.15.4.1.4.2.1.1" class="ltx_p ltx_align_left">[fillFuelTank(fuelAmount=36.8), lockDoors(unlock=False, door=["driver", "passenger", "rear_left", "rear_right"]), activateParkingBrake(mode="engage")]</span>
</span></td></tr>
