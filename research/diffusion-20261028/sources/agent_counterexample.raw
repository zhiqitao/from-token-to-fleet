<span id="A3.T5.2.5.2.1.1" class="ltx_p ltx_align_left"><span id="A3.T5.2.5.2.1.1.1" class="ltx_text ltx_font_typewriter">[play_spotify_song(query="Shape of You")]</span></span>
</span></td></tr>
