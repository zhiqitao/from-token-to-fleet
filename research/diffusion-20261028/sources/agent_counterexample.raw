</span></td>
<td id="A6.T12.2.17.3.1.4.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top" style="padding:-0.25pt 4.0pt;">
<span id="A6.T12.2.17.3.1.4.2.1" class="ltx_inline-block ltx_align_top" style="width:329.0pt;">
<span id="A6.T12.2.17.3.1.4.2.1.1" class="ltx_p ltx_align_left">[lockDoors(unlock=True, door=["driver", "passenger", "rear_left", "rear_right"]), setHeadlights(mode="on")]</span>
</span></td></tr>
</table></td></tr>
