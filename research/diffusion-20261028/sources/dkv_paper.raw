<td id="A3.T5.5.1.2.6" class="ltx_td ltx_align_center"><span id="A3.T5.5.1.2.6.1" class="ltx_text" style="font-size:90%;">(confidence)</span></td>
<td id="A3.T5.5.1.2.7" class="ltx_td ltx_align_center"><span id="A3.T5.5.1.2.7.1" class="ltx_text" style="font-size:90%;">(confidence)</span></td></tr>
<tr id="A3.T5.5.1.3" class="ltx_tr">
