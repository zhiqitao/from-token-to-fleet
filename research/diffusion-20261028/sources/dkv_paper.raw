<td id="A3.T5.5.1.3.3" class="ltx_td ltx_align_center ltx_border_r">Steps <math id="A3.T5.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></td>
