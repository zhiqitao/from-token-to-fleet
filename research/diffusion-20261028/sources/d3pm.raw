<td id="A2.T4.5.3.3" class="ltx_td ltx_align_left ltx_border_bb"><math id="A2.T4.m16" class="ltx_Math" alttext="5.99\pm 0.14" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">5.99</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">0.14</mn></mrow><annotation encoding="application/x-tex">5.99\pm 0.14</annotation></semantics></math></td>
