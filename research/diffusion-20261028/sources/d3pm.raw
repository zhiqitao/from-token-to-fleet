<th id="A2.T4.5.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><math id="A2.T4.m9" class="ltx_Math" alttext="\beta_{t}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">β</mi><mi mathsize="0.900em">t</mi></msub><annotation encoding="application/x-tex">\beta_{t}</annotation></semantics></math><span id="A2.T4.5.1.2.1" class="ltx_text" style="font-size:90%;"> schedule</span></th>
<th id="A2.T4.5.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A2.T4.5.1.3.1" class="ltx_text" style="font-size:90%;">IS (<math id="A2.T4.m10" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></th>
