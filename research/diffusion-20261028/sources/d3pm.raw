            <span id="lstnumberx39.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">  </span><span id="lstnumberx39.3" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#9400D1;">""</span><span id="lstnumberx39.4" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#9400D1;">"Computes<span id="lstnumberx39.4.1" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx39.4.2" class="ltx_text ltx_lst_space"> </span>log(exp(a)<span id="lstnumberx39.4.3" class="ltx_text ltx_lst_space"> </span>-<span id="lstnumberx39.4.4" class="ltx_text ltx_lst_space"> </span>exp(b))<span id="lstnumberx39.4.5" class="ltx_text ltx_lst_space"> </span>(b&lt;a)<span id="lstnumberx39.4.6" class="ltx_text ltx_lst_space"> </span>in<span id="lstnumberx39.4.7" class="ltx_text ltx_lst_space"> </span>a<span id="lstnumberx39.4.8" class="ltx_text ltx_lst_space"> </span>numerically<span id="lstnumberx39.4.9" class="ltx_text ltx_lst_space"> </span>stable<span id="lstnumberx39.4.10" class="ltx_text ltx_lst_space"> </span>way."</span><span id="lstnumberx39.5" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#9400D1;">""</span>
</div>
<div id="lstnumberx40" class="ltx_listingline">
