<td id="S6.T3.5.15.4" class="ltx_td ltx_align_left"><math id="S6.T3.m38" class="ltx_Math" alttext="\leq 4.40\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.700em">≤</mo><mrow><mn mathsize="0.700em">4.40</mn><mo mathsize="0.700em">±</mo><mn mathsize="0.700em">0.02</mn></mrow></mrow><annotation encoding="application/x-tex">\leq 4.40\pm 0.02</annotation></semantics></math></td></tr>
