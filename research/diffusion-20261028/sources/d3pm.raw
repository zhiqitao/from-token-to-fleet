            <span id="lstnumberx38.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#FF00FF;">def</span><span id="lstnumberx38.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx38.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">log_minus_exp</span><span id="lstnumberx38.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(</span><span id="lstnumberx38.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">a</span><span id="lstnumberx38.7" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx38.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx38.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">b</span><span id="lstnumberx38.10" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx38.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx38.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">epsilon</span><span id="lstnumberx38.13" class="ltx_text ltx_font_typewriter" style="font-size:80%;">=1.</span><span id="lstnumberx38.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">e</span><span id="lstnumberx38.15" class="ltx_text ltx_font_typewriter" style="font-size:80%;">-6):</span>
</div>
<div id="lstnumberx39" class="ltx_listingline">
