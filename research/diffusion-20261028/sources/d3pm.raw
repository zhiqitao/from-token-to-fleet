<th id="A2.T4.5.1.5" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A2.T4.5.1.5.1" class="ltx_text" style="font-size:90%;">NLL (<math id="A2.T4.m12" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></th></tr>
