<div id="S5.T8.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:94.5pt;vertical-align:-44.4pt;"><span class="ltx_transformed_inner" style="transform:translate(37.5pt,-10.3pt) scale(1.2775600223667,1.2775600223667) ;">
<table id="S5.T8.5.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T8.5.1.1" class="ltx_tr">
<td id="S5.T8.5.1.1.1" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.45pt 3.0pt;" rowspan="2"><span id="S5.T8.5.1.1.1.1" class="ltx_text" style="font-size:90%;"><span id="S5.T8.5.1.1.1.1.1" class="ltx_text"></span> <span id="S5.T8.5.1.1.1.1.2" class="ltx_text">
