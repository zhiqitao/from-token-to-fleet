<td id="S5.T5.5.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.25pt 4.0pt;" colspan="5">Concurrency</td>
<td id="S5.T5.5.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.25pt 4.0pt;" rowspan="2"><span id="S5.T5.5.1.1.3.1" class="ltx_text"><span id="S5.T5.5.1.1.3.1.1" class="ltx_text ltx_font_italic">Avg.</span> <math id="S5.T5.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math></span></td></tr>
<tr id="S5.T5.5.1.2" class="ltx_tr">
