<td id="S5.T5.5.1.5.1" class="ltx_td ltx_align_left" style="padding:-0.25pt 4.0pt;">EAGLE-3 (10)</td>
<td id="S5.T5.5.1.5.2" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.0pt;">1.6<math id="S5.T5.m6" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S5.T5.5.1.5.3" class="ltx_td ltx_align_center" style="padding:-0.25pt 4.0pt;">1.5<math id="S5.T5.m7" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
