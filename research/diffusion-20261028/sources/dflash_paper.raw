<td id="S5.T9.5.4.2" class="ltx_td ltx_align_left" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T9.5.4.2.1" class="ltx_text" style="font-size:90%;">KV</span></td>
