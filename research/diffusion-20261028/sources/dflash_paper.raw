<tr id="S5.T5.5.1.4" class="ltx_tr">
<td id="S5.T5.5.1.4.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:-0.25pt 4.0pt;">Baseline (TPS)</td>
<td id="S5.T5.5.1.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;">249</td>
<td id="S5.T5.5.1.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;">923</td>
<td id="S5.T5.5.1.4.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;">1739</td>
