<tr id="A1.T11.5.1.8" class="ltx_tr">
<td id="A1.T11.5.1.8.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A1.T11.5.1.8.1.1" class="ltx_text" style="font-size:90%;">Qwen3.5-27B</span></td>
<td id="A1.T11.5.1.8.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A1.T11.5.1.8.2.1" class="ltx_text" style="font-size:90%;">DFlash</span></td>
