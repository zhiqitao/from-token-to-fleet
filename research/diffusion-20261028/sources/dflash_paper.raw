<td id="S5.T7.5.4.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.45pt 3.0pt;"><span id="S5.T7.5.4.6.1" class="ltx_text" style="font-size:90%;">2.38<math id="S5.T7.m9" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></td>
