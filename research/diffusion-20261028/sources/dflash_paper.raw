<td id="S4.T1.5.1.15.15" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T1.5.1.15.15.1" class="ltx_text" style="font-size:90%;">3.05</span></td>
<td id="S4.T1.5.1.15.16" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T1.5.1.15.16.1" class="ltx_text" style="font-size:90%;">1.88<math id="S4.T1.m106" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></td>
<td id="S4.T1.5.1.15.17" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T1.5.1.15.17.1" class="ltx_text" style="font-size:90%;">3.26</span></td></tr>
<tr id="S4.T1.5.1.16" class="ltx_tr">
