\"right\":{\"collection\":\"qfaltO0An\",\"name\":\"id\",\"type\":\"Identifier\"},\"type\":\"BinaryOperation\"},\"left\":\"711fca51-3614-4b0d-ae89-657b86b85730\",\"right\":\"4885d69c-65a5-4a14-ae6d-d0d449ca73ba\",\"type\":\"LeftJoin\"},\"offset\":{\"type\":\"LiteralValue\",\"value\":4},\"orderBy\":[{\"collection\":\"iGsMFQyKK\",\"direction\":\"desc\",\"name\":\"YvvpdZVvZ\",\"type\":\"Identifier\"}],\"select\":[{\"collection\":\"iGsMFQyKK\",\"name\":\"o6uVDsVYw\",\"type\":\"Identifier\"},{\"collection\":\"iGsMFQyKK\",\"name\":\"yBjy1YG43\",\"type\":\"Identifier\"},{\"collection\":\"iGsMFQyKK\",\"name\":\"wtOD_9RE3\",\"type\":\"Identifier\"},{\"collection\":\"iGsMFQyKK\",\"name\":\"YvvpdZVvZ\",\"type\":\"Identifier\"},{\"alias\":\"qfaltO0An.UMGc2228W\",\"collection\":\"qfaltO0An\",\"name\":\"UMGc2228W\",\"type\":\"Identifier\"},{\"collection\":\"iGsMFQyKK\",\"name\":\"VqAogPvS_\",\"type\":\"Identifier\"},{\"collection\":\"iGsMFQyKK\",\"name\":\"id\",\"type\":\"Identifier\"}],\"limit\":{\"type\":\"LiteralValue\",\"value\":10}}default",[360,367,374,381,388,395,402,409,416,423],{"o6uVDsVYw":196,"yBjy1YG43":361,"wtOD_9RE3":363,"YvvpdZVvZ":365,"qfaltO0An.UMGc2228W":34,"VqAogPvS_":43,"id":198},{"type":32,"value":362},"Mercury 2 for Search: Fast enough to run a hundred times per query",{"type":32,"value":364},"Mercury 2 is the fastest speed-optimized LLM in every step of the search pipeline. Fifty to a hundred LLM calls per query, inside the latency budget you already have.",{"type":37,"value":366},"2026-08-11T00:00:00.000Z",{"o6uVDsVYw":202,"yBjy1YG43":368,"wtOD_9RE3":370,"YvvpdZVvZ":372,"qfaltO0An.UMGc2228W":34,"VqAogPvS_":43,"id":204},{"type":32,"value":369},"More builders. More throughput. Better Mercury 2.",{"type":32,"value":371},"The response to Mercury 2 has been bigger than we expected. Today, alongside our partners at Baseten, we're making Mercury even easier to build with: 100M free tokens for every new API key, 10x higher rate limits, and a faster, more capable model. ",{"type":37,"value":373},"2026-07-29T00:00:00.000Z",{"o6uVDsVYw":208,"yBjy1YG43":375,"wtOD_9RE3":377,"YvvpdZVvZ":379,"qfaltO0An.UMGc2228W":34,"VqAogPvS_":43,"id":210},{"type":32,"value":376},"Mercury 2: the first reasoning model fast enough to pick up the phone",{"type":32,"value":378},"Mercury 2 brings real-time reasoning to voice agents. TTFT \u003C300 ms on standard NVIDIA GPUs, so your agents can actually hold a conversation.",{"type":37,"value":380},"2026-07-14T00:00:00.000Z",{"o6uVDsVYw":214,"yBjy1YG43":382,"wtOD_9RE3":384,"YvvpdZVvZ":386,"qfaltO0An.UMGc2228W":34,"VqAogPvS_":43,"id":216},{"type":32,"value":383},"Mercury 2 on Azure Foundry",{"type":32,"value":385},"Mercury 2 is now available on Azure AI Foundry, combining Inception’s diffusion architecture with Azure’s enterprise-ready infrastructure for fast, production-grade AI.",{"type":37,"value":387},"2026-06-24T00:00:00.000Z",{"o6uVDsVYw":220,"yBjy1YG43":389,"wtOD_9RE3":391,"YvvpdZVvZ":393,"qfaltO0An.UMGc2228W":34,"VqAogPvS_":43,"id":222},{"type":32,"value":390},"Mercury 2 and the Rise of Real-time Subagents",{"type":32,"value":392},"Inception's diffusion LLMs power fast, parallel agent workflows in production at Augment Code",{"type":37,"value":394},"2026-05-12T00:00:00.000Z",{"o6uVDsVYw":226,"yBjy1YG43":396,"wtOD_9RE3":398,"YvvpdZVvZ":400,"qfaltO0An.UMGc2228W":34,"VqAogPvS_":43,"id":228},{"type":32,"value":397},"Introducing Mercury Edit 2",{"type":32,"value":399},"A next-edit diffusion LLM built for the fastest parts of your coding workflow",{"type":37,"value":401},"2026-03-30T00:00:00.000Z",{"o6uVDsVYw":232,"yBjy1YG43":403,"wtOD_9RE3":405,"YvvpdZVvZ":407,"qfaltO0An.UMGc2228W":34,"VqAogPvS_":43,"id":234},{"type":32,"value":404},"Mercury 2 on PinchBench: Fast Diffusion Models and the Personal Agent Era",{"type":32,"value":406},"We evaluated Mercury 2 on PinchBench, the open-source benchmark built on top of OpenClaw — the fastest-growing open-source project in GitHub history, with 250K+ stars in under 60 days.",{"type":37,"value":408},"2026-03-24T00:00:00.000Z",{"o6uVDsVYw":238,"yBjy1YG43":410,"wtOD_9RE3":412,"YvvpdZVvZ":414,"qfaltO0An.UMGc2228W":34,"VqAogPvS_":43,"id":240},{"type":32,"value":411},"Introducing Mercury 2",{"type":32,"value":413},"Today, we're introducing Mercury 2 — the world's fastest reasoning language model, built to make production AI feel instant.",{"type":37,"value":415},"2026-02-24T00:00:00.000Z",{"o6uVDsVYw":97,"yBjy1YG43":417,"wtOD_9RE3":419,"YvvpdZVvZ":421,"qfaltO0An.UMGc2228W":87,"VqAogPvS_":43,"id":99},{"type":32,"value":418},"SearchBlox + Inception: Real-Time GenAI Search at Enterprise Scale",{"type":32,"value":420},"Inception’s Mercury dLLM now powers SearchBlox SearchAI, unlocking ultra-low-latency, cost-efficient GenAI at scale. This partnership provides SearchBlox customers sub-second GenAI responses even on enterprise workloads.",{"type":37,"value":422},"2026-01-12T00:00:00.000Z",{"o6uVDsVYw":124,"yBjy1YG43":424,"wtOD_9RE3":426,"YvvpdZVvZ":428,"qfaltO0An.UMGc2228W":116,"VqAogPvS_":43,"id":126},{"type":32,"value":425},"Mercury Diffusion LLM Now Available on Azure AI Foundry",{"type":32,"value":427},"Today, we're thrilled to announce that Mercury is available on Azure AI Foundry, bringing the first commercial-scale diffusion large language model (dLLM) to enterprise developers. This release combines Inception's breakthrough diffusion architecture with Azure's enterprise-ready infrastructure, giving developers access to a model that delivers both exceptional speed and quality.",{"type":37,"value":429},"2025-11-18T00:00:00.000Z",["Map",431,33,432,433,434,435],"getSlugByRecordId|GEcHDDC91|default|QG8dg5K4P","getSlugByRecordId|V0dwvNGdT|default|tU7XW2ED0","terms-of-use","getSlugByRecordId|V0dwvNGdT|default|BtgKEuQQ1","privacy-policy"]</script><div id="svg-templates" style="position: absolute; overflow: hidden; bottom: 0; left: 0; width: 0; height: 0; z-index: 0; contain: strict" aria-hidden="true">
