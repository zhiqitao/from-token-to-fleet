<td id="S4.T1.7.1.5.1" class="ltx_td ltx_align_left" style="padding-top:1pt;padding-bottom:1pt;">SmolLM 2</td>
<td id="S4.T1.7.1.5.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">1.7B</td>
<td id="S4.T1.7.1.5.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">34.1</td>
<td id="S4.T1.7.1.5.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">28.7</td>
