<td id="A3.T12.7.3.3" class="ltx_td ltx_align_center"><span id="A3.T12.7.3.3.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">59.4</span> (<span id="A3.T12.7.3.3.2" class="ltx_text" style="--ltx-fg-color:#FF8000;">8.9<math id="A3.T12.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF8000;" mathcolor="#FF8000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span>)</td></tr>
