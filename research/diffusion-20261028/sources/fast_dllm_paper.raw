<td id="A3.T11.7.3.4" class="ltx_td ltx_align_center" style="padding:1.5pt 14.0pt;"><span id="A3.T11.7.3.4.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">78.5</span> (<span id="A3.T11.7.3.4.2" class="ltx_text" style="--ltx-fg-color:#FF8000;">11.7x</span>)</td></tr>
