<span class="line"><span style="color:#1F2328;--shiki-dark:#9CDCFE">  reasoning_effort:</span><span style="color:#0A3069;--shiki-dark:#CE9178"> &#x27;medium&#x27;</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">,</span></span>
