<th id="A5.T10.6.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column"><math id="A5.T10.m2" class="ltx_math_unparsed" alttext="T=10k(\downarrow)" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>10</mn><mi>k</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em" stretchy="false">↓</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T=10k(\downarrow)</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A5.T10.6.2" class="ltx_tr">
