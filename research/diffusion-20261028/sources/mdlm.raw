<td id="A5.T10.6.3.2" class="ltx_td ltx_align_center"><math id="A5.T10.m5" class="ltx_Math" alttext="70.3" display="inline" intent=":literal"><semantics><mn>70.3</mn><annotation encoding="application/x-tex">70.3</annotation></semantics></math></td>
