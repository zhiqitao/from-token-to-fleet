<td id="S5.T7.5.9.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T7.m77" class="ltx_Math" alttext="\it 0.935" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_italic" mathsize="0.700em" mathvariant="italic">0.935</mn><annotation encoding="application/x-tex">\it 0.935</annotation></semantics></math><span id="S5.T7.5.9.4.1" class="ltx_text" style="font-size:70%;"> <span id="S5.T7.5.9.4.1.1" class="ltx_text" style="font-size:71%;">{<math id="S5.T7.m78" class="ltx_Math" alttext="\pm 0l007" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mn>007</mn></mrow></mrow><annotation encoding="application/x-tex">\pm 0l007</annotation></semantics></math>}</span></span></td>
<td id="S5.T7.5.9.5" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T7.m79" class="ltx_Math" alttext="\it 0.935" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_italic" mathsize="0.700em" mathvariant="italic">0.935</mn><annotation encoding="application/x-tex">\it 0.935</annotation></semantics></math><span id="S5.T7.5.9.5.1" class="ltx_text" style="font-size:70%;"> <span id="S5.T7.5.9.5.1.1" class="ltx_text" style="font-size:71%;">{<math id="S5.T7.m80" class="ltx_Math" alttext="\pm 0.014" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.014</mn></mrow><annotation encoding="application/x-tex">\pm 0.014</annotation></semantics></math>}</span></span></td>
