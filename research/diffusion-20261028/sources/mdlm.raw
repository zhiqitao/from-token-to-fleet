<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E66.m1" class="ltx_Math" alttext="\displaystyle=\sum_{{\mathbf{y}}^{\prime}\neq{\mathbf{y}}}\frac{q_{t}({\mathbf{y}}^{\prime}|{\mathbf{x}})}{q_{t}({\mathbf{y}}|{\mathbf{x}})}R_{t}({\mathbf{y}},{\mathbf{y}}^{\prime})\left(\log\frac{q_{t}({\mathbf{y}}^{\prime}|{\mathbf{x}})}{q_{t}({\mathbf{y}}|{\mathbf{x}})}-\log{\mathbf{s}}_{\theta}({\mathbf{y}})_{{\mathbf{y}}^{\prime}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐲</mi><mo>′</mo></msup><mo>≠</mo><mi>𝐲</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐲</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo>,</mo><msup><mi>𝐲</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐲</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>𝐬</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow><msup><mi>𝐲</mi><mo>′</mo></msup></msub></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{{\mathbf{y}}^{\prime}\neq{\mathbf{y}}}\frac{q_{t}({\mathbf{y}}^{\prime}|{\mathbf{x}})}{q_{t}({\mathbf{y}}|{\mathbf{x}})}R_{t}({\mathbf{y}},{\mathbf{y}}^{\prime})\left(\log\frac{q_{t}({\mathbf{y}}^{\prime}|{\mathbf{x}})}{q_{t}({\mathbf{y}}|{\mathbf{x}})}-\log{\mathbf{s}}_{\theta}({\mathbf{y}})_{{\mathbf{y}}^{\prime}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
