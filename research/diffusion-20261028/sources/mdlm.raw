<td id="S5.T2.6.3.2" class="ltx_td ltx_align_left ltx_border_t"><math id="S5.T2.m8" class="ltx_Math" alttext="\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\leq</annotation></semantics></math>24.10</td></tr>
<tr id="S5.T2.6.4" class="ltx_tr">
<th id="S5.T2.6.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">MDLM (Ours)</th>
