<tbody id="A3.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><span id="A3.Ex80.3.1" class="ltx_text ltx_markedasmath"><math id="A3.Ex80.m1.m1" class="ltx_Math" alttext="\because\lim_{T\to\infty}T\mathcal{O}\left(\frac{1}{T^{2}}\right)=0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.800em" rspace="0.1389em">∵</mo><mrow><mrow><msub><mo lspace="0.1389em" mathsize="0.800em" rspace="0.167em">lim</mo><mrow><mi mathsize="0.800em">T</mi><mo mathsize="0.800em" stretchy="false">→</mo><mi mathsize="0.800em" mathvariant="normal">∞</mi></mrow></msub><mrow><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒪</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mfrac><mn mathsize="0.800em">1</mn><msup><mi mathsize="0.800em">T</mi><mn mathsize="0.800em">2</mn></msup></mfrac><mo>)</mo></mrow></mrow></mrow><mo mathsize="0.800em">=</mo><mn mathsize="0.800em">0</mn></mrow></mrow><annotation encoding="application/x-tex">\because\lim_{T\to\infty}T\mathcal{O}\left(\frac{1}{T^{2}}\right)=0</annotation></semantics></math><span id="A3.Ex80.3.1.1" class="ltx_text" style="font-size:80%;">, we get:</span></span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex81.m1" class="ltx_Math" alttext="\displaystyle=\sum_{{\mathbf{y}}^{\prime}\neq{\mathbf{y}}}\frac{q_{s}({\mathbf{y}}^{\prime}|{\mathbf{x}})}{q_{t}({\mathbf{y}}|{\mathbf{x}})}R_{t}({\mathbf{y}},{\mathbf{y}}^{\prime})\log\frac{\frac{q_{s}({\mathbf{y}}^{\prime}|{\mathbf{x}})}{q_{t}({\mathbf{y}}|{\mathbf{x}})}\cancel{R_{t}({\mathbf{y}},{\mathbf{y}}^{\prime})}}{{\mathbf{s}}_{\theta}({\mathbf{y}})_{{\mathbf{y}}^{\prime}}\cancel{R_{t}({\mathbf{y}},{\mathbf{y}}^{\prime})}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>𝐲</mi><mo>′</mo></msup><mo>≠</mo><mi>𝐲</mi></mrow></munder></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>q</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐲</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo>,</mo><msup><mi>𝐲</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mfrac><mrow><msub><mi>q</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐲</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><menclose notation="updiagonalstrike"><mrow><msub><mi>R</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo>,</mo><msup><mi>𝐲</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></menclose></mrow><mrow><msub><mi>𝐬</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow><msup><mi>𝐲</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><menclose notation="updiagonalstrike"><mrow><msub><mi>R</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐲</mi><mo>,</mo><msup><mi>𝐲</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></menclose></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{{\mathbf{y}}^{\prime}\neq{\mathbf{y}}}\frac{q_{s}({\mathbf{y}}^{\prime}|{\mathbf{x}})}{q_{t}({\mathbf{y}}|{\mathbf{x}})}R_{t}({\mathbf{y}},{\mathbf{y}}^{\prime})\log\frac{\frac{q_{s}({\mathbf{y}}^{\prime}|{\mathbf{x}})}{q_{t}({\mathbf{y}}|{\mathbf{x}})}\cancel{R_{t}({\mathbf{y}},{\mathbf{y}}^{\prime})}}{{\mathbf{s}}_{\theta}({\mathbf{y}})_{{\mathbf{y}}^{\prime}}\cancel{R_{t}({\mathbf{y}},{\mathbf{y}}^{\prime})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
