<td id="A5.T10.6.4.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T10.m7" class="ltx_Math" alttext="\mathbf{40.1}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">40.1</mn><annotation encoding="application/x-tex">\mathbf{40.1}</annotation></semantics></math></td>
