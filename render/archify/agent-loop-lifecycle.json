{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "The agent loop: a four-state state machine",
    "quality_profile": "showcase",
    "viewBox": [1000, 700]
  },
  "lanes": [
    { "id": "main", "label": "Agent loop" },
    { "id": "terminal", "label": "Terminal" }
  ],
  "states": [
    { "id": "plan", "type": "start", "label": "Plan", "sublabel": "read context, emit plan", "lane": "main", "col": 0, "step": "01", "tag": "model" },
    { "id": "execute", "type": "active", "label": "Execute", "sublabel": "tool call routed", "lane": "main", "col": 1, "step": "02", "tag": "action" },
    { "id": "observe", "type": "active", "label": "Observe", "sublabel": "append result", "lane": "main", "col": 2, "step": "03", "tag": "state" },
    { "id": "decide", "type": "decision", "label": "Decide", "sublabel": "resolved or loop?", "lane": "main", "col": 3, "step": "04", "tag": "check" },
    { "id": "answer", "type": "success", "label": "Final answer", "sublabel": "emit response", "lane": "main", "col": 4, "step": "05", "tag": "done" },
    { "id": "stop", "type": "failure", "label": "Stopped", "sublabel": "turn limit / reject", "lane": "terminal", "col": 1, "tag": "terminal" }
  ],
  "transitions": [
    { "id": "plan-execute", "from": "plan", "to": "execute", "variant": "emphasis" },
    { "id": "execute-observe", "from": "execute", "to": "observe", "variant": "default" },
    { "id": "observe-decide", "from": "observe", "to": "decide", "variant": "default" },
    { "id": "decide-plan", "from": "decide", "to": "plan", "label": "loop", "variant": "default", "route": "top-channel" },
    { "id": "decide-answer", "from": "decide", "to": "answer", "variant": "emphasis" },
    { "id": "decide-stop", "from": "decide", "to": "stop", "variant": "security" }
  ],
  "cards": [
    { "dot": "emerald", "title": "Deterministic structure, data-dependent length", "items": ["A simple query may finish in one cycle", "Each cycle adds a fixed LLM turn + tool latency"] },
    { "dot": "rose", "title": "Capacity impact", "items": ["Each turn amplifies tokens (~1.12x at 3 turns)", "Token amplification compounds with loop depth"] }
  ]
}
