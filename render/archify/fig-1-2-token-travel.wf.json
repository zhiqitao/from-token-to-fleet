{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How a token travels",
    "output": "render/archify/fig-1-2-token-travel.html",
    "quality_profile": "showcase",
    "legend": {"mode": "hidden"}
  },
  "lanes": [
    {"id": "top", "label": "derive"},
    {"id": "bottom", "label": "mix"}
  ],
  "nodes": [
    {"id": "text", "lane": "top", "col": 0, "type": "external", "label": "Text", "sublabel": "user prompt", "tag": "characters"},
    {"id": "tok", "lane": "top", "col": 1, "type": "backend", "label": "Tokenizer", "sublabel": "BPE splits", "tag": "corpus-driven"},
    {"id": "ids", "lane": "top", "col": 2, "type": "messagebus", "label": "Token IDs", "sublabel": "integers", "tag": "ordered"},
    {"id": "emb", "lane": "top", "col": 3, "type": "database", "label": "Embedding", "sublabel": "ID to d-dim vector", "tag": "one vec/token"},
    {"id": "attn", "lane": "bottom", "col": 3, "type": "frontend", "label": "Attention", "sublabel": "Q K mix V", "tag": "vs past"},
    {"id": "kv", "lane": "bottom", "col": 2, "type": "database", "label": "KV Cache", "sublabel": "past K,V stored", "tag": "per layer x head"}
  ],
  "edges": [
    {"from": "text", "to": "tok", "label": "split"},
    {"from": "tok", "to": "ids", "label": "emit"},
    {"from": "ids", "to": "emb", "label": "lookup"},
    {"from": "emb", "to": "attn", "label": "attend"},
    {"from": "attn", "to": "kv", "label": "append K,V"}
  ],
  "cards": [
    {"dot": "emerald", "title": "The unit everything is priced against", "items": [
      "A token is whatever the tokenizer cut the string into — not a word, not a character",
      "Token counts are not proportional to character or word counts in any fixed way",
      "Cost and capacity are counted in tokens, never in words"
    ]},
    {"dot": "rose", "title": "What the KV cache remembers", "items": [
      "Every past token contributes one K and one V per layer, per head",
      "The cache avoids re-deriving the prefix on each decode step",
      "Cache memory scales with sequence length (arithmetic in Ch. 7)"
    ]}
  ]
}
