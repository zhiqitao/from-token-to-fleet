    },
    {
      "label": "Remember"
    }
  ],
  "nodes": [
    {
      "id": "text",
      "type": "external",
      "label": "Text",
      "sublabel": "user prompt",
      "stage": 0,
      "row": 1,
      "tag": "characters"
    },
    {
      "id": "tok",
      "type": "backend",
      "label": "Tokenizer",
      "sublabel": "BPE splits",
      "stage": 1,
      "row": 0,
      "tag": "corpus-driven"
    },
    {
      "id": "ids",
      "type": "messagebus",
      "label": "Token IDs",
      "sublabel": "integers from vocab",
      "stage": 1,
      "row": 2,
      "tag": "ordered"
    },
    {
      "id": "emb",
      "type": "database",
      "label": "Embedding",
      "sublabel": "ID → d-dim vector",
      "stage": 2,
      "row": 1,
      "tag": "one vec/token"
    },
    {
      "id": "attn",
      "type": "frontend",
      "label": "Attention",
      "sublabel": "Q·K mix V",
      "stage": 3,
      "row": 1,
      "tag": "vs past"
    },
    {
      "id": "kv",
      "type": "database",
      "label": "KV Cache",
      "sublabel": "past K,V stored",
      "stage": 4,
      "row": 1,
      "tag": "per layer × head"
    }
  ],
  "flows": [
    {
      "id": "f1",
      "from": "text",
      "to": "tok",
      "label": "split",
      "classification": "raw string"
    },
    {
      "id": "f2",
      "from": "tok",
      "to": "ids",
      "label": "emit",
      "classification": "integer IDs",
      "labelAt": [
        315,
        314
      ]
    },
    {
      "id": "f3",
      "from": "ids",
      "to": "emb",
      "label": "lookup",
      "classification": "dense vector"
    },
    {
      "id": "f4",
      "from": "emb",
      "to": "attn",
      "label": "attend",
      "classification": "queries past K,V"
    },
    {
      "id": "f5",
      "from": "attn",
      "to": "kv",
      "label": "append K,V",
      "classification": "remember prefix"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "The unit everything is priced against",
      "items": [
        "A token is whatever the tokenizer cut the string into — not a word, not a character",
        "Token counts are not proportional to character or word counts in any fixed way",
        "Cost and capacity are counted in tokens, never in words"
      ]
    },
    {
      "dot": "rose",
      "title": "What the KV cache remembers",
      "items": [
        "Every past token contributes one K and one V per layer, per head",
        "The cache avoids re-deriving the prefix on each decode step",
        "Cache memory scales with sequence length (arithmetic in Ch. 7)"
      ]
    }
  ]
}