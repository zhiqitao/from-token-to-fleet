% ---- From Token to Fleet — professional book style (xelatex) ----
% Adapted from pmichaillat/latex-book (minimalist academic book template)
% with xelatex/fontspec Unicode support.

% xelatex + Unicode text fonts
\usepackage{fontspec}

% ---- Mathematics (\text, \mathrm, aligned display math) ----
\usepackage{amsmath}
\usepackage{amssymb}
\usepackage{microtype}

% Text serif font (choose a professional book face present on the system)
\IfFontExistsTF{Linux Libertine O}{%
  \setmainfont{Linux Libertine O}[Numbers=OldStyle]%
}{%
  \IfFontExistsTF{EB Garamond}{%
    \setmainfont{EB Garamond}%
  }{\setmainfont{Noto Serif}}%
}

% ---- Unicode symbol mapping ----
% The table check/cross marks (✓ U+2713, ✗ U+2717) are not guaranteed to resolve
% to a glyph in the main text font under xelatex; map them explicitly so the
% constraints table renders real glyphs. (\checkmark from amssymb; \ding{55} is
% the pifont ballot-X.)
\usepackage{newunicodechar}
\usepackage{pifont}
\newunicodechar{✓}{\checkmark}
\newunicodechar{✗}{\ding{55}}

% Monospaced font for code/inline-code
\IfFontExistsTF{Source Code Pro}{%
  \setmonofont{Source Code Pro}[Scale=0.85]%
}{%
  \IfFontExistsTF{Liberation Mono}{%
    \setmonofont{Liberation Mono}[Scale=0.9]%
  }{\setmonofont{Latin Modern Mono}[Scale=0.9]}%
}

% Sans font for headings accent
\IfFontExistsTF{Liberation Sans}{%
  \setsansfont{Liberation Sans}%
}{}

% ---- Adjust page layout ----
\usepackage[top=1in, left=1.2in, right=1.2in, bottom=1.2in, footskip=0.7in]{geometry}
% (balanced margins; the former 1.5in left gutter for reviewer line numbers is gone)

% ---- Tables (pandoc needs longtable + array family) ----
\usepackage{array}
\usepackage{tabularx}
\usepackage{longtable}

% ---- pandoc generated-command compatibility macros ----
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
% \real: make pandoc's column-width arithmetic a valid length
\providecommand{\real}[1]{#1}
% Code highlighting environments produced by pandoc -t latex
\newenvironment{Shaded}{\begin{quote}\small}{\end{quote}}
\newenvironment{Highlighting}{}{}
\newcommand{\HL}[1]{#1}
\newcommand{\NormalTok}[1]{#1}\newcommand{\CommentTok}[1]{\textit{#1}}
\newcommand{\KeywordTok}[1]{\textbf{#1}}
\newcommand{\DataTypeTok}[1]{#1}\newcommand{\DecValTok}[1]{#1}
\newcommand{\BaseNTok}[1]{#1}\newcommand{\FloatTok}[1]{#1}
\newcommand{\ConstantTok}[1]{#1}\newcommand{\CharTok}[1]{#1}
\newcommand{\SpecialCharTok}[1]{#1}\newcommand{\StringTok}[1]{#1}
\newcommand{\VerbatimChar}[1]{#1}
\newcommand{\SpecialStringTok}[1]{#1}\newcommand{\ImportTok}[1]{#1}
\newcommand{\FunctionTok}[1]{#1}\newcommand{\VariableTok}[1]{#1}
\newcommand{\ControlFlowTok}[1]{\textbf{#1}}
\newcommand{\OperatorTok}[1]{#1}\newcommand{\BuiltInTok}[1]{#1}\newcommand{\AttributeTok}[1]{#1}
\newcommand{\ExtensionTok}[1]{#1}\newcommand{\PreprocessorTok}[1]{#1}
\newcommand{\InformationTok}[1]{#1}\newcommand{\DocumentationTok}[1]{#1}\newcommand{\WarningTok}[1]{#1}
\newcommand{\AlertTok}[1]{#1}\newcommand{\ErrorTok}[1]{#1}\newcommand{\RegionMarkerTok}[1]{#1}\newcommand{\OtherTok}[1]{#1}

\usepackage{adjustbox}
% pandoc figures constrained to text block via \pandocbounded wrapper
% (adjustbox) plus a post-processed width= in md_to_latex.fix_figure_width.
\newcommand{\pandocbounded}[1]{%
  \begin{adjustbox}{max width=\textwidth, keepaspectratio}#1\end{adjustbox}}
\def\maxwidth#1{\ifdim#1>\textwidth\textwidth\else#1\fi}

% ---- Adjust spacing ----
\usepackage[onehalfspacing]{setspace}
\AtBeginDocument{\frenchspacing}

% ---- Select color scheme ----
\usepackage[x11names]{xcolor}
% Semantic colors mirroring the figures' color code (Qwen visual review):
% Compute = orange, Memory = blue, Economics = green. Defined here so headings,
% captions, and front-matter can reference the book-wide scheme.
\definecolor{compute}{RGB}{230,126,34}   % #E67E22 orange
\definecolor{memory}{RGB}{39,64,139}     % #27408B blue
\definecolor{economics}{RGB}{30,107,66}  % #1E6B42 green
\definecolor{bookred}{RGB}{192,57,43}    % #C0392B (binding-constraint callout)

% ---- Format header and footer (NO date) ----
\usepackage{fancyhdr}
\pagestyle{fancy}
\renewcommand{\headrulewidth}{0.4pt}
\fancyhf{}
% Odd (right) pages: chapter title left, page number right
\fancyhead[LE]{\small\itshape\nouppercase{\leftmark}}
\fancyhead[RO]{\small\itshape\nouppercase{\leftmark}}
\fancyhead[RE,LO]{\small\thepage}
\fancyfoot{}

% Remove headers/footers from blank pages
\usepackage{emptypage}

% ---- Format title page (custom, no \maketitle tabular conflict) ----
\newcommand*{\subtitle}[1]{%
  \leavevmode\vfill%
  {\centering\itshape\large #1\par}%
  \vspace{2cm}%
}

% ---- Format table of contents ----
\usepackage{tocloft}
\renewcommand{\contentsname}{Contents}
\setcounter{tocdepth}{1}
\renewcommand{\cftpartfont}{\bfseries}
\renewcommand{\cftchapfont}{\normalfont\scshape}
\renewcommand{\cftsecfont}{\normalfont}
\renewcommand{\cftchappagefont}{\normalfont}
\renewcommand{\cftsecpagefont}{\normalfont}
\setlength{\cftbeforepartskip}{1em}
\setlength{\cftbeforechapskip}{0.5em}
\setlength{\cftchapnumwidth}{3em}
\setlength{\cftsecnumwidth}{4em}

% ---- Format headings ----
\usepackage{titlesec}
\titleformat{\part}[display]{\Huge\bfseries\centering}{\textsc{part}~\thepart.}{1.5cm}{}[]
\titleformat{\chapter}[display]{\huge\bfseries}{\textsc{chapter}~\thechapter.}{1.5cm}{}[\vskip1.5cm]
\titleformat*{\section}{\large\bfseries}
\titleformat*{\subsection}{\bfseries}
\titleformat*{\subsubsection}{\itshape}
% Add period after heading numbers
\titlelabel{\thetitle.\hspace{1em}}

% ---- Figures and tables ----
\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{rotating}
\usepackage{multirow}
\renewcommand{\floatpagefraction}{0}
\makeatletter\g@addto@macro\@floatboxreset\centering\makeatother
\renewcommand{\arraystretch}{1.2}
\renewcommand{\tablename}{\textsc{table}}
\renewcommand{\figurename}{\textsc{figure}}
\usepackage{caption}
\DeclareCaptionLabelSeparator{periodem}{.\hspace{1em}}
\captionsetup{labelsep=periodem}
\captionsetup[table]{position=top}

% ---- Notes ----
\NewDocumentCommand{\note}{o m}{%
\parbox{\linewidth}{\footnotesize\vspace*{10pt}%
\IfValueT{#1}{\textit{#1}.\hspace{1em}}%
#2}}

% ---- Lists ----
\usepackage{enumitem}
\setlist[itemize, 1]{leftmargin=\parindent, topsep=0.5em, itemsep=0.4em, parsep=0pt}
\setlist[enumerate, 1]{leftmargin=\parindent, topsep=0.5em, itemsep=0.4em, parsep=0pt}

% ---- Hyperlinks (visible, clickable) ----
\PassOptionsToPackage{hyphens}{url}
\definecolor{booklink}{RGB}{20,60,125}   % muted professional blue
\usepackage[colorlinks=true, linkcolor=booklink, urlcolor=booklink, citecolor=booklink,
  hypertexnames=false, pdfpagemode=UseNone, pdfdisplaydoctitle=true]{hyperref}
\urlstyle{same}
