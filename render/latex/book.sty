% Text serif font (choose a professional book face present on the system)
% Ligatures=NoCommon turns off the "qu"/"fi"/"fl" ligatures so the PDF text
% layer maps every letter to its own glyph.  A Linux Libertine "qu" ligature
% glyph drops the "u" from the text layer ("Requests" -> extracted "Reqests"),
% which corrupts book search and accessibility.  The visual run stays identical;
% only the extractable text becomes letter-accurate.
\IfFontExistsTF{Linux Libertine O}{%
  \setmainfont{Linux Libertine O}[Numbers=OldStyle, Ligatures=NoCommon]%
}{%
  \IfFontExistsTF{EB Garamond}{%
    \setmainfont{EB Garamond}%
  }{\setmainfont{Noto Serif}}%
}

% ---- Unicode symbol mapping ----
% The table check/cross marks (✓ U+2713, ✗ U+2717) are not guaranteed to resolve
% to a glyph in the main text font under xelatex; map them explicitly so the
% constraints table renders real glyphs. (\checkmark from amssymb; \ding{55} is
% the pifont ballot-X.)
\usepackage{newunicodechar}
\usepackage{pifont}
\newunicodechar{✓}{\checkmark}
\newunicodechar{✗}{\ding{55}}
% Ceiling/floor brackets (U+2308-230B) are absent from Linux Libertine O. Map
% them to the math delimiters so the Ch17 fleet-size formulas render real glyphs
% instead of missing-glyph boxes.
\newunicodechar{⌈}{\ensuremath{\lceil}}
\newunicodechar{⌉}{\ensuremath{\rceil}}
\newunicodechar{⌊}{\ensuremath{\lfloor}}
\newunicodechar{⌋}{\ensuremath{\rfloor}}

% Monospaced font for code/inline-code
