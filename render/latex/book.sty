% \ntsection: a numbered, formatted \section that writes NO table-of-contents
% entry. Used for the per-chapter template headings (Concept / Mental Model /
% Worked Example / ... ) so they keep their number and styling but do not
% flood the TOC with hundreds of near-identical lines. The chapter's
% end-of-chapter Mini-Case stays a normal \section, so it remains navigable.
\makeatletter
\newcommand{\ntsection}[1]{%
  \begingroup
  \let\addcontentsline\@gobbletoc  % suppress the .toc write for this section
  \section{#1}%
  \endgroup
}
\def\@gobbletoc#1#2#3{}%
\makeatother
\renewcommand{\cftpartfont}{\bfseries}
\renewcommand{\cftchapfont}{\normalfont\scshape}
\renewcommand{\cftsecfont}{\normalfont}
\renewcommand{\cftchappagefont}{\normalfont}
